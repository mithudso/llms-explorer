---
import Base from "../layouts/Base.astro";
import AccountNav from "../components/AccountNav.astro";

// The sign-in page is an island. The ceremony belongs to the API — passkey
// registration and assertion, and the two OAuth redirects — and the session it
// returns is an HttpOnly cookie this page can neither read nor forge. So there
// is nothing to render at build time except the buttons that start it, and the
// signed-out markup below is the whole page a crawler ever sees.
const title = "Sign in";
const description = "Sign in with a passkey, GitHub or Google; the API sets an HttpOnly session cookie that the account, keys and usage pages send back on every call.";
---
<Base title={title} description={description} route="/login/">
  <AccountNav route="/login/" />
  <p>
    An account is only needed for the metered surfaces — your own docsets, the
    hosted MCP endpoint, and the private forks of the concept tree. Everything
    this site publishes, including the whole <a href="/llms.txt">llms family</a>,
    stays readable signed out and unmetered.
  </p>

  <div class="island" id="login-state" data-island="login" hidden></div>

  <div data-signed-out id="login-choices">
    <h2>Three ways in</h2>
    <p>
      A <strong>passkey</strong> is the one that leaves nothing to steal: the
      private half never leaves your device, and there is no password for this
      site to lose. The two federated options exist because most people already
      have one, and they land on the same account when the provider hands over
      the same verified address.
    </p>
    <p class="choices">
      <button type="button" id="passkey-in">Sign in with a passkey</button>
      <button type="button" id="passkey-new">Register a passkey</button>
      <button type="button" id="oauth-github">Continue with GitHub</button>
      <button type="button" id="oauth-google">Continue with Google</button>
    </p>
    <p class="hint" id="login-error" role="status"></p>
  </div>

  <noscript>
    <p>Signing in needs JavaScript: the passkey ceremony runs in the browser and
    the federated buttons are redirects this page builds at click time.</p>
  </noscript>

  <script>
    const nav = document.querySelector(".account-nav");
    const api = nav ? nav.getAttribute("data-api") : "";
    const state = document.getElementById("login-state");
    const choices = document.getElementById("login-choices");
    const error = document.getElementById("login-error");

    const call = (path, init) =>
      fetch(api + path, { credentials: "include", headers: { accept: "application/json" }, ...init });

    const fail = (message) => { if (error) error.textContent = message; };

    async function whoami() {
      try {
        const r = await call("/api/me");
        if (!r.ok) return;                     // 401 is the signed-out case, not an error
        const me = await r.json();
        state.textContent = `Signed in as ${me.email || me.handle || "your account"}.`;
        state.hidden = false;
        choices.hidden = true;
      } catch {
        fail("The API did not answer. Try again in a moment.");
      }
    }

    const go = (path) => { window.location.href = api + path; };
    document.getElementById("oauth-github")?.addEventListener("click", () => go("/api/auth/oauth/github"));
    document.getElementById("oauth-google")?.addEventListener("click", () => go("/api/auth/oauth/google"));

    // WebAuthn is not JSON. The API speaks base64url over the wire, the browser
    // speaks ArrayBuffer, and the two conversions below are the whole reason this
    // page cannot just relay what it is handed. `PublicKeyCredential`'s own
    // parse/toJSON helpers do it correctly where they exist (Chrome 132+, Safari
    // 18+); the fallbacks are for everything older.
    const b64urlToBytes = (value) => {
      const padded = value.replace(/-/g, "+").replace(/_/g, "/");
      const raw = atob(padded + "=".repeat((4 - (padded.length % 4)) % 4));
      return Uint8Array.from(raw, (c) => c.charCodeAt(0));
    };
    const bytesToB64url = (buffer) =>
      btoa(String.fromCharCode(...new Uint8Array(buffer)))
        .replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");

    const decodeDescriptors = (list) =>
      (list || []).map((d) => ({ ...d, id: b64urlToBytes(d.id) }));

    const toCreationOptions = (options) =>
      typeof PublicKeyCredential.parseCreationOptionsFromJSON === "function"
        ? PublicKeyCredential.parseCreationOptionsFromJSON(options)
        : { publicKey: { ...options,
              challenge: b64urlToBytes(options.challenge),
              user: { ...options.user, id: b64urlToBytes(options.user.id) },
              excludeCredentials: decodeDescriptors(options.excludeCredentials) } };

    const toRequestOptions = (options) =>
      typeof PublicKeyCredential.parseRequestOptionsFromJSON === "function"
        ? PublicKeyCredential.parseRequestOptionsFromJSON(options)
        : { publicKey: { ...options,
              challenge: b64urlToBytes(options.challenge),
              allowCredentials: decodeDescriptors(options.allowCredentials) } };

    // `JSON.stringify(credential)` yields `{}` — a PublicKeyCredential has no
    // enumerable own properties. Serialise it by hand where `toJSON` is missing.
    const credentialToJSON = (credential) => {
      if (typeof credential.toJSON === "function") return credential.toJSON();
      const r = credential.response;
      const response = {
        clientDataJSON: bytesToB64url(r.clientDataJSON),
        ...(r.attestationObject
          ? { attestationObject: bytesToB64url(r.attestationObject) }
          : { authenticatorData: bytesToB64url(r.authenticatorData),
              signature: bytesToB64url(r.signature),
              userHandle: r.userHandle ? bytesToB64url(r.userHandle) : null }),
      };
      return {
        id: credential.id,
        rawId: bytesToB64url(credential.rawId),
        type: credential.type,
        clientExtensionResults: credential.getClientExtensionResults?.() ?? {},
        ...(credential.authenticatorAttachment
          ? { authenticatorAttachment: credential.authenticatorAttachment } : {}),
        response,
      };
    };

    async function passkey(kind) {
      if (!window.PublicKeyCredential) return fail("This browser has no passkey support; use GitHub or Google.");
      try {
        // The ceremony STARTS on `/options`; posting to the bare route lands on
        // the finish handler, which answers "start the ceremony first".
        const start = await call(`/api/auth/passkey/${kind}/options`, {
          method: "POST",
          headers: { accept: "application/json", "content-type": "application/json" },
          body: "{}",
        });
        if (!start.ok) {
          const detail = await start.json().catch(() => null);
          return fail(`The API refused to start the ceremony (${start.status}${detail?.detail ? `: ${detail.detail}` : ""}).`);
        }
        const options = await start.json();
        fail("Complete the prompt from your device.");
        const credential = kind === "register"
          ? await navigator.credentials.create(toCreationOptions(options))
          : await navigator.credentials.get(toRequestOptions(options));
        if (!credential) return fail("No passkey was returned by the browser.");
        const done = await call(`/api/auth/passkey/${kind}`, {
          method: "POST",
          headers: { accept: "application/json", "content-type": "application/json" },
          body: JSON.stringify({ credential: credentialToJSON(credential) }),
        });
        if (!done.ok) {
          const detail = await done.json().catch(() => null);
          return fail(`That passkey was not accepted (${done.status}${detail?.detail ? `: ${detail.detail}` : ""}).`);
        }
        window.location.href = "/account/";
      } catch (err) {
        // Never swallow this: a silent catch here is what hid a wrong endpoint,
        // an unmarshalled challenge and an RP-id mismatch behind one dismissable
        // sentence. `NotAllowedError` really is the user dismissing the prompt;
        // `SecurityError` is almost always rp.id vs the page origin.
        const name = err?.name || "Error";
        fail(name === "NotAllowedError"
          ? "The passkey prompt was dismissed or timed out."
          : `Passkey failed: ${name}${err?.message ? ` — ${err.message}` : ""}`);
      }
    }
    document.getElementById("passkey-in")?.addEventListener("click", () => passkey("authenticate"));
    document.getElementById("passkey-new")?.addEventListener("click", () => passkey("register"));

    whoami();
  </script>
</Base>

<style>
  .choices { display: flex; gap: .6rem; flex-wrap: wrap; }
  .hint { font-size: .9em; opacity: .8; }
</style>
