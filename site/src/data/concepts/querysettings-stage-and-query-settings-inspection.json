            "ev:8746d58a8a66b6f69e36eaa88e3423cc26949289f6107ebc5f0350ffb55ddd1d"
          ],
          "also": [
            "https://github.com/mongodb/mongo/blob/master/src/mongo/db/query/explain.cpp"
          ]
        },
        {
          "text": "Percona ClusterSync documents manual export with $querySettings because it does not automatically migrate persistent query settings. Its procedure applies to source and destination clusters running MongoDB 8.0 or later. (low confidence) (verified as of 2026-10-13)",
          "source": "https://docs.percona.com/percona-clustersync-for-mongodb/pqs.html",
