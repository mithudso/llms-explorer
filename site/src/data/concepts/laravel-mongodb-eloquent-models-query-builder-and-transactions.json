    {
      "title": "Problems, failure modes and limitations",
      "facts": [
        {
          "text": "Issue #2720 reports that Laravel MongoDB 4.1 raised `Transaction already in progress` when `firstOrCreate()` attempted creation inside an existing transaction. A maintainer attributed the error to an attempted nested transaction and described replacing that implementation with an atomic operation. This is historical issue evidence, not verification of current installed behavior. (low confidence)",
          "source": "https://github.com/mongodb/laravel-mongodb/issues/2720",
          "note": null,
          "claimId": "clm:41c0645ed2da1610c58ecb33f0d8d77250a6d674d8f0821747d0aa1d63f6884f",
          "validationStatus": "SUPPORTED",
          "evidenceIds": [
