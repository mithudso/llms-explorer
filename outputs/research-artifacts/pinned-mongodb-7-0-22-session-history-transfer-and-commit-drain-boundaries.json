    {
      "id": "clm:c091c96dc2a4f9efa0bda591f998f77f22ca272cc7207f616bbddb921ce8b6f3",
      "text": "The donor casts the migration session identifier to its parent identity and excludes any record with the same parent identity. The source comment explains that transferring this migration bookkeeping session could deadlock against the recipient session checkout. (low confidence)",
      "source_url": "https://raw.githubusercontent.com/mongodb/mongo/dacdbc3df2fbe579b03336a2f01fc9aedf406a41/src/mongo/db/s/session_catalog_migration_source.cpp",
