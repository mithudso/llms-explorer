  "facets": [
    {
      "title": "How it works",
      "facts": [
        {
          "text": "Bitemporal history separates when a fact applies in the modeled world from when the system recorded it. (medium confidence)",
          "source": "https://docs.xtdb.com/about/time-in-xtdb.html",
          "note": null,
          "claimId": "clm:7afedc8bbe17d97e878e4d357a882a6fcadb08d3418424019c510770ed8840b8",
