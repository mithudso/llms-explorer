    {
      "title": "How it works",
      "facts": [
        {
          "text": "The Parkinson’s Foundation states that medications, toxins or other neurological conditions can cause secondary parkinsonism. (low confidence)",
          "source": "https://www.parkinson.org/understanding-parkinsons/what-is-parkinsons/types-parkinsonisms",
          "note": null,
          "claimId": "clm:d58e3883b296f1db049bc42dc997d25c5e5ad963744e80bba0d2bb41d3582ac8",
