            "ev:9d838e8f4964756b331d7c1de835539aafc7d1375f4ed12aca3c1e8bd69de2b7"
          ]
        },
        {
          "text": "Billing distinguishes processed bytes from returned/transferred bytes. The latter includes client results, inter-node transfers, and $out/$merge writes, so a small result set alone does not imply a small bill. (medium confidence) (verified as of 2026-10-30)",
          "source": "https://www.mongodb.com/docs/atlas/billing/data-federation/",
          "note": null,
