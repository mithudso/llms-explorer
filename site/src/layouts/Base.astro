---
import "../styles/global.css";
import "../styles/lx-polish.css";
const { title, heading = title, description, route, twin: twinProp, noindex = false, adEligible = false } = Astro.props;
// `noindex` keeps mirrored material (the hub's docs under /sources/, the
// per-file /directory/<key>/ grade cards) out of search results so the index
// reflects the site's own writing. `follow` still lets crawlers walk the links,
// and tools/build_sitemap.py drops these pages from sitemap.xml.
// Content pages carry a `.md` twin at the same route; the generated listing
// pages (home, section indexes) pass `twin={null}` because twins.py writes a
// twin only for `src/content/**`, and a link to a file that is not published
// is worse than no link.
const twin = twinProp === undefined ? route.replace(/\/$/, "") + ".md" : twinProp;
// Routes that hold a secret (session islands, the one-time key, API-key
// inputs) get no third-party script. Mirrors STRICT_ROUTES in tools/twins.py,
// which gives these routes the CSP that would block the tags anyway.
const STRICT_ROUTES = ["/login/", "/account/", "/keys/", "/usage/", "/contribute/",
                       "/donate/", "/moderate/", "/proposals/", "/playground/"];
const strict = STRICT_ROUTES.some((r) => route.startsWith(r));
// Reader journeys lead. The resource catalogue remains in the More menu.
const NAV = [
  ["/start-here/", "Start here", "Try a small workflow before installing anything"],
  ["/blog/", "Guides & research", "Worked guides, experiments and architecture reports"],
  ["/downloads/", "Tools", "Choose a workbench and find its installation guide"],
  ["/skills/", "Skills", "Reusable instructions for your coding agent"],
  ["/tree/", "Concept tree", "Explore connected topics and their published references"],
];
const RESOURCES = [
  ["/context/", "Context files", "Research and concept facts as Markdown"],
  ["/directory/", "Source directory", "llms files and their format scores"],
  ["/reference/", "Technical reference", "Formats, lint rules and publishing conventions"],
  ["/examples/", "Code examples", "Copyable recipes with stated assumptions"],
  ["/demo/", "Retrieval demo", "Recorded keyword, vector and hybrid results"],
  ["/explorer/", "LLMSX Explorer", "Research workbench features and shortcuts"],
  ["/family/", "For agents: llms.txt", "The machine-readable site index"],
  ["/contribute/", "Contribute", "Suggest additions to the research library"],
  ["/donate/", "Support the project", "Help fund the work"],
  ["/login/", "Sign in", "Account, API keys and hosted tools"],
  ["/account/", "Account", "Your signed-in profile and settings"],
  ["/keys/", "API keys", "Manage access to hosted tools"],
  ["/usage/", "Usage", "Inspect your account usage"],
  ["/proposals/", "Your proposals", "Track submitted contributions"],
];
---
<html lang="en"><head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {!strict && (<>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-0KWFPMH6WX" crossorigin="anonymous"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-0KWFPMH6WX');
  </script>
  </>)}
  {/* Ownership verification is separate from page-level ad eligibility.
      Enable ads only after assessing the page and the consent setup. */}
  <meta name="google-adsense-account" content="ca-pub-1706083044457708" />
  {adEligible && !strict && !noindex && <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1706083044457708" crossorigin="anonymous"></script>}
  <title>{title} · LLMS-Explorer</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={new URL(route, Astro.site).href} />
  {twin && <link rel="alternate" type="text/markdown" href={twin} />}
  <link rel="describedby" href="/llms.txt" />
  <script src="../scripts/lx-polish.js"></script>
</head><body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <nav class="site-nav" aria-label="Primary">
      <a class="brand" href="/" aria-label="LLMSX home">llmsx<span class="brand-note"> / practical AI workflows</span></a>
      <span class="links">
        {NAV.map(([href, label, note]) => (
          <a href={href} title={note} aria-current={route.startsWith(href) ? "page" : null} data-track="nav_click" data-label={label} data-destination={href}>{label}</a>
        ))}
        <details class="menu"><summary data-track="resources_menu_open">More</summary>
          <div class="menu-items">
            {RESOURCES.map(([href, name, note]) => (
              <a href={href}>{name}<span class="menu-note">{note}</span></a>
            ))}
          </div>
        </details>
      </span>
    </nav>
  </header>
  <main id="main-content"><h1>{heading}</h1><slot /></main>
  <footer class="site-footer">
    <p>LLMSX — practical guides, open tools and reusable context for AI work.</p>
    <nav aria-label="Footer">
      <a href="/about/">About & contact</a>
      <a href="/editorial/">Sources & editorial standards</a>
      <a href="/privacy/">Privacy</a>
      <a href="https://github.com/mithudso/llms-explorer">Source code</a>
      <a href="/family/">For agents: llms.txt</a>
      {twin && <a href={twin}>This page as Markdown</a>}
    </nav>
  </footer>
  <script is:inline>
    // Delegated GA4 click tracking (measurement-plan-2026-09-07.md §2, redesign-spec-2026-09-07.md §9).
    // One listener covers every current and future [data-track] element; no-ops if gtag is
    // unavailable (ad blockers) rather than throwing. Never blocks navigation.
    document.addEventListener("click", function (event) {
      if (typeof gtag !== "function") return;
      var el = event.target.closest && event.target.closest("[data-track]");
      if (!el) return;
      var name = el.dataset.track;
      // resources_menu_open fires from the toggle listener below, not from this click delegate,
      // so a click that merely opens/closes the <details> doesn't double-count or fire on close.
      if (name === "resources_menu_open") return;
      var params = {};
      if (el.dataset.card) params.card = el.dataset.card;
      if (el.dataset.ctaId) params.cta_id = el.dataset.ctaId;
      if (el.dataset.label) params.label = el.dataset.label;
      if (el.dataset.destination) params.destination = el.dataset.destination;
      else if (el.href) params.destination = el.pathname;
      gtag("event", name, params);
    });
    document.addEventListener(
      "toggle",
      function (event) {
        if (typeof gtag !== "function") return;
        var details = event.target;
        if (details.matches && details.matches("details.menu") && details.open) {
          gtag("event", "resources_menu_open", {});
        }
      },
      true,
    );
  </script>
</body></html>
