          ]
        },
        {
          "text": "Per-shape maxTimeMS overrides command maxTimeMS. Zero clears the setting and restores command/defaultMaxTimeMS fallback. (low confidence) (verified as of 2026-10-14)",
          "source": "https://www.mongodb.com/docs/manual/reference/command/setQuerySettings.md",
          "note": null,
          "claimId": "clm:facf4dba30af3bb3cc4f198f138483b12e1da1c96914f1417c6652856c71b786",
