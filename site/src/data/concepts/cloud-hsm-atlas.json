  "facets": [
    {
      "title": "Comparisons and alternatives",
      "facts": [
        {
          "text": "Cloud HSM documents an 8 KiB message-size limit and separate HSM quota usage. Atlas’s key-wrapping design means these operations concern encryption keys rather than whole database files. (medium confidence) (verified as of 2026-10-22) Sources: https://cloud.google.com/kms/docs/hsm ; https://www.mongodb.com/docs/atlas/security-gcp-kms.md",
          "source": "https://cloud.google.com/kms/docs/hsm",
          "note": null,
          "claimId": "clm:52ca5d4f8dff3e0c50a7bb88ee027684d33d34c243cd707abb4255a36c6dedea",
          "validationStatus": "REMEDIATED-PROJECTION",
          "evidenceIds": [],
          "also": [
            "https://www.mongodb.com/docs/atlas/security-gcp-kms.md"
          ],
          "originValidationStatus": "SUPPORTED",
          "originEvidenceIds": [
            "ev:113c8d089eb1628c651cd4a53fce6e58aaa8bc1c13264344ea4ed06b3e3926ca",
            "ev:3acce97cd5a596288c40a09f45cfaa0a2f0ac9011fd33b8459ce30b918b49902",
            "ev:485755200837a242db4b9b21aa692e9d1e41abbfdf6ec823c9134c99b0c8a2cd"
          ],
          "remediation": {
            "schema": "claim-remediation-projection/v1",
            "record": "remediation.json",
