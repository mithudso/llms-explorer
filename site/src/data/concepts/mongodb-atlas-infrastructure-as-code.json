    {
      "title": "Drift Detection",
      "facts": [
        {
          "text": "Terraform detects drift in terraform plan. Atlas API changes made outside Terraform (via UI or CLI) cause drift. Use terraform import to bring unmanaged resources under Terraform control.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-iac/#drift-detection",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "Independent vs Subobject CRDs",
      "facts": [
        {
          "text": "Subobject CRDs: Managed as fields in AtlasProject (e.g., spec.alertConfigurations)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-iac/#independent-vs-subobject-crds",
          "note": null,
          "level": 0
        },
        {
          "text": "Independent CRDs: Deployed as separate Kubernetes objects, can be managed by different teams",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-iac/#independent-vs-subobject-crds",
          "note": null,
          "level": 0
        }
      ]
