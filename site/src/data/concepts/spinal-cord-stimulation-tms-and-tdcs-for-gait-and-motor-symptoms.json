      "documentSlug": "spinal-cord-stimulation-tms-and-tdcs-for-gait-and-motor-symptoms",
      "documentConcept": "Spinal cord stimulation, TMS and tDCS for gait and motor symptoms",
      "canonicalConceptId": "concept:32751397857cf61158808007104df095460896d2d57de12980c4571df7983c69",
      "text": "Which stimulation targets and dosing schedules provide reproducible, durable improvements in objectively measured freezing, falls, and daily walking?",
      "sources": [
        "https://clinicaltrials.gov/api/v2/studies/NCT06798844",
        "https://pmc.ncbi.nlm.nih.gov/articles/PMC12786542/",
