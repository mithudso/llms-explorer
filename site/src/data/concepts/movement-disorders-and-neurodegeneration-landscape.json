    },
    {
      "title": "Facts and statements",
      "facts": [
        {
          "text": "The MDS clinical diagnostic criteria define motor parkinsonism as bradykinesia plus rest tremor or rigidity. (low confidence)",
          "source": "https://pubmed.ncbi.nlm.nih.gov/26474316/",
          "note": null,
          "claimId": "clm:68cad4a9c3e8958a290e2f268c28b76e71934e13a312cab82880c4bd1e88f6c3",
          "validationStatus": "SUPPORTED",
          "evidenceIds": [
            "ev:27ba2dd8ccbf1fa0b3375c33bbdcbc936ec37b74e2365a7aa5bca2494552cc3e"
          ]
        },
        {
          "text": "WHO reports gaps in medication and surgical-resource accessibility, availability and affordability, particularly in low- and middle-income countries. (low confidence) (verified as of 2023-08-09)",
