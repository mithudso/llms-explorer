  "claims": [
    {
      "id": "clm:3ce2f13189d3e5e87b9f3b4ed772c8b44cd827f321aae79191a2efe8defbf2d9",
      "text": "The LUMA primary endpoint was time to confirmed worsening in the MDS-UPDRS Parts II and III combined score. (high confidence)",
      "source_url": "https://investors.biogen.com/news-releases/news-release-details/biogen-and-denali-therapeutics-provide-update-phase-2b-luma",
      "also": [
        "https://clinicaltrials.gov/api/v2/studies/NCT05348785"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:0570c57d6615a03db5be21506672a7b9e1965ad612dcb9d3f17ab23f65a883ee",
        "ev:55a6808778af5df337774c272fb812ded1e97abec08c43c34d93c0f0c6a24f5a"
      ]
    },
    {
      "id": "clm:d282291923b8d33bf815b9e96f6f60590b713181e00038862634bbb21dbb9eab",
      "text": "The REASON authors report adverse events in 64.5% (20/31) of part A participants and 84.8% (28/33) of part B participants, mainly mild to moderate and not dose limiting, with no serious adverse events related to BIIB094. (low confidence) (verified as of 2026-11-27)",
      "source_url": "https://pubmed.ncbi.nlm.nih.gov/41876647/",
      "also": [],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:2a02a398768179601049d27f22c3038a18217e93b61adf8d706a4761f174dd4c"
      ]
    },
    {
      "id": "clm:70142b4219ed9ceed56aca509655cb2742c3cfe757fcb9884607678e919cd2dd",
      "text": "REASON participant numbers differ by source: the paper abstract reports 40 participants in part A and 42 in part B, while the registry record NCT03976349 lists 62 actual enrollment. (medium confidence) (verified as of 2026-11-27)",
      "source_url": "https://pubmed.ncbi.nlm.nih.gov/41876647/",
      "also": [
        "https://clinicaltrials.gov/api/v2/studies/NCT03976349"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:8d812d090d8722b958d5c659c52b728541c9b532d14e8fa0897fb5b1d8d104d7",
        "ev:a20106356779092556e7db249526e30b6490ee9bea911c938b7de9815466a45d"
      ]
    },
    {
      "id": "clm:6b010866842d23209f6b5bfdf8bfa951d7319cbb38ed86a0f5a6ee5bc8bb7ee3",
      "text": "NeurologyLive, reporting a late-breaking conference presentation, gives the LUMA primary-endpoint hazard ratio as 1.04 (95% CI, 0.85-1.28; P =.4538). (low confidence) (verified as of 2026-10-05)",
      "source_url": "https://www.neurologylive.com/view/lrrk2-inhibitor-biib122-fails-slow-early-stage-parkinson-disease",
      "also": [],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:0b61f3b5538defe57d590250d9894178e2af182f3e287a3c3216e1288bfb710b",
        "ev:39288bdd8f0c40c5b3ffd276a72415458f3e28c1f55f352d88dcf2ea9f189fb3",
        "ev:9c6da75e8173550b2176f3043a99e5eac658fb0fb054e1f8e733dd26b603a192"
      ]
    },
    {
      "id": "clm:6b27c134d6c51664070e400f864c362341e6b0a24ff3f53337bb4edd1f54ba36",
      "text": "Biogen and Denali report exploratory LUMA biomarker results of >90% kinase inhibition of peripheral LRRK2 (phosphoserine 935) and, in a CSF sub-study, up to approximately 30% reduction in phosphorylated Rab10. (medium confidence) (verified as of 2026-05-21)",
      "source_url": "https://investors.biogen.com/news-releases/news-release-details/biogen-and-denali-therapeutics-provide-update-phase-2b-luma",
      "also": [
        "https://www.neurologylive.com/view/lrrk2-inhibitor-biib122-fails-slow-early-stage-parkinson-disease"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:0570c57d6615a03db5be21506672a7b9e1965ad612dcb9d3f17ab23f65a883ee",
        "ev:3079c279884201ef9b7437b52a0582021f341afb3911cddd6871977eaac93f8c"
      ]
    },
    {
      "id": "clm:33b1d758d2cca3a509069bacc36dfc7d19606ac57e121a88634495e68473eeed",
      "text": "The REASON authors report that cerebrospinal fluid (CSF) LRRK2 and phosphorylated Rab10 levels were lowered by up to 59% and up to 50%, respectively, irrespective of LRRK2 variant status after intrathecal BIIB094. (low confidence) (verified as of 2026-11-27)",
      "source_url": "https://pubmed.ncbi.nlm.nih.gov/41876647/",
      "also": [],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:2a02a398768179601049d27f22c3038a18217e93b61adf8d706a4761f174dd4c"
      ]
    },
    {
      "id": "clm:bee0d5b038aa8596bd6895199143770a4c7e08dc5072cd4bbceaecbd5df4bd28",
      "text": "Biogen and Denali report that the Phase 2b LUMA study of BIIB122 in early-stage Parkinson\u2019s disease did not meet its primary or secondary endpoints. (high confidence) (verified as of 2026-05-21)",
      "source_url": "https://investors.biogen.com/news-releases/news-release-details/biogen-and-denali-therapeutics-provide-update-phase-2b-luma",
      "also": [
        "https://www.michaeljfox.org/news/news-context-parkinsons-drug-luma-lrrk2-clinical-trial-outcomes",
        "https://www.neurologylive.com/view/lrrk2-inhibitor-biib122-fails-slow-early-stage-parkinson-disease"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:00d26a0b8da53bcf184b7aab2f2ae0f36d790a336401e04bbec2f4513968d647",
        "ev:39288bdd8f0c40c5b3ffd276a72415458f3e28c1f55f352d88dcf2ea9f189fb3",
        "ev:4fa2ab18bca0faa6807c442c4127d5dc0193a72a07fb0de1f03110635692e393"
      ]
    },
    {
      "id": "clm:e73d42ea0d2799825c8da2365a899f4b13a2c885b7868b2eb78015f3ec5f110b",
      "text": "LUMA included individuals with early-stage Parkinson\u2019s disease with or without a pathogenic LRRK2 variant, and MJFF describes the trial as largely including people without known genetic mutations. (high confidence)",
      "source_url": "https://investors.biogen.com/news-releases/news-release-details/biogen-and-denali-therapeutics-provide-update-phase-2b-luma",
      "also": [
        "https://www.michaeljfox.org/news/news-context-parkinsons-drug-luma-lrrk2-clinical-trial-outcomes"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:0570c57d6615a03db5be21506672a7b9e1965ad612dcb9d3f17ab23f65a883ee",
        "ev:19cfa76c9c85a424a94dc430df4810bedc96d99a2423ef5d5565ece7a52f6fcc",
        "ev:1c89d7b7a7d43f77c8f0a8d3da6366b2176ecae7dba57ae9d665d3fc3f89ebe8"
      ]
    },
    {
      "id": "clm:cff9c6f17d1bb92073a488e56b58f185e8c803e02e0e6af047498d503748a362",
      "text": "Based on the LUMA results, Biogen and Denali state they will discontinue further development of BIIB122 in idiopathic Parkinson\u2019s disease, while Denali continues the Phase 2a BEACON study in carriers of a pathogenic LRRK2 variant. (high confidence) (verified as of 2026-05-21)",
      "source_url": "https://investors.biogen.com/news-releases/news-release-details/biogen-and-denali-therapeutics-provide-update-phase-2b-luma",
      "also": [
        "https://www.michaeljfox.org/news/news-context-parkinsons-drug-luma-lrrk2-clinical-trial-outcomes"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:00d26a0b8da53bcf184b7aab2f2ae0f36d790a336401e04bbec2f4513968d647",
        "ev:0570c57d6615a03db5be21506672a7b9e1965ad612dcb9d3f17ab23f65a883ee"
      ]
    },
    {
      "id": "clm:499f86d9b16885d42676a8a87a6e424341708ce421afd58e5caef044fb76ab0d",
      "text": "BEACON is registered as a Phase 2a randomized, double-blind, placebo-controlled study of BIIB122 in LRRK2-associated Parkinson's disease whose primary outcome is the incidence of TEAEs and SAEs over a 12-week double-blind period. (medium confidence) (verified as of 2026-11-27)",
      "source_url": "https://clinicaltrials.gov/api/v2/studies/NCT06602193",
      "also": [
        "https://investors.biogen.com/news-releases/news-release-details/biogen-and-denali-therapeutics-provide-update-phase-2b-luma"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:217f5fdabaea6f5bb53233e05ce060a5536fc80fbe7bf256ce4b91a18c27ec30",
        "ev:71e91368c4ea543787e9d5fd97361dd9bf33152d36b4afabd5f034220b059657",
        "ev:f61b902539252a759834200e6494c08ab8d5ac0564d5624fa46bf39251235027"
      ]
    },
    {
      "id": "clm:e6b12ddeaf4019c97f5e5f89095c74b1231e46a3876cdab19cd509e1acb214d6",
      "text": "NeurologyLive reports that treatment-emergent adverse events led to study drug withdrawal in 11.2% of BIIB122/DNL151-treated LUMA participants versus 4.6% of placebo-treated participants. (low confidence) (verified as of 2026-10-05)",
      "source_url": "https://www.neurologylive.com/view/lrrk2-inhibitor-biib122-fails-slow-early-stage-parkinson-disease",
      "also": [],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:17a33cceaa6f57f1c37e117533fc5e27e67a9960ebd127df8e7e6120b7d5362d",
        "ev:9c6da75e8173550b2176f3043a99e5eac658fb0fb054e1f8e733dd26b603a192"
      ]
    },
    {
      "id": "clm:b6463383f3773c08f2fdd24f9bbc33f8c6596792ff54dd5255e1c823f011cf2f",
      "text": "LIGHTHOUSE (NCT05418673), a Phase 3 study of BIIB122/DNL151 in participants with Parkinson's disease and pathogenic LRRK2 variants, is registered as TERMINATED with the reason Sponsor Decision and 7 actual participants; NeurologyLive attributes the June 2023 termination to complexity and a projected completion date of 2031 rather than any safety or efficacy concern. (medium confidence) (verified as of 2026-11-27)",
      "source_url": "https://clinicaltrials.gov/api/v2/studies/NCT05418673",
      "also": [
        "https://www.neurologylive.com/view/lrrk2-inhibitor-biib122-fails-slow-early-stage-parkinson-disease"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:2d82dc1842acc546c6f1a79a58e39c2cd0ee1b33b95f23db1e64416bf44576e0",
        "ev:5073ac8e43c5f5f5eb2544433673594121e0d2f60e8d23c009dfa8b0488ca663",
        "ev:6bf9b9160de35228ca1e3d07c3573d11a650b915e68b65df1e138e79b73806a6",
        "ev:773234c0a0fa7ed112a8b8664539ad7c3fa20a1e64abb407eaed096fde974ab9",
        "ev:a138a2289ed3993f757ff4a78a50699e0df637d09974ba64690dec7d3f7221a6"
      ]
    },
    {
      "id": "clm:28cda38d0b0d8a0565603e9e0a3f64573ce1b61051e4048413d95f1329e92a7f",
      "text": "LUMA participant numbers differ by source: Biogen and Denali cite 648 people, while the registry record NCT05348785 lists 650 actual enrollment. (medium confidence) (verified as of 2026-11-27)",
      "source_url": "https://investors.biogen.com/news-releases/news-release-details/biogen-and-denali-therapeutics-provide-update-phase-2b-luma",
      "also": [
        "https://clinicaltrials.gov/api/v2/studies/NCT05348785"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:1c89d7b7a7d43f77c8f0a8d3da6366b2176ecae7dba57ae9d665d3fc3f89ebe8",
        "ev:bf2bb05b3fdefa9d7f7fa1fa6f1fa2cfc38666c7e9f2bc52e064dcf4b778b851",
        "ev:d9cf8f70e6e41acf7f569ee5892eacf46c2981bed30caed43820478df37413a4"
      ]
    },
    {
      "id": "clm:378f21c33ddfa7fe65b51b82283d8132eb1b7cb5e6c69ee8a476e1245c41595f",
      "text": "Biogen and Denali state that BIIB122 was generally well tolerated with an acceptable safety profile in LUMA. (medium confidence) (verified as of 2026-05-21)",
      "source_url": "https://investors.biogen.com/news-releases/news-release-details/biogen-and-denali-therapeutics-provide-update-phase-2b-luma",
      "also": [
        "https://www.michaeljfox.org/news/news-context-parkinsons-drug-luma-lrrk2-clinical-trial-outcomes"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:00d26a0b8da53bcf184b7aab2f2ae0f36d790a336401e04bbec2f4513968d647",
        "ev:0570c57d6615a03db5be21506672a7b9e1965ad612dcb9d3f17ab23f65a883ee"
      ]
    },
    {
      "id": "clm:acbb5e6337c28173b8ff5cd2dcc8fda559268331b32bbe11b11b89704158e0ac",
      "text": "The registry record for BEACON (NCT06602193) lists the study as ACTIVE_NOT_RECRUITING with an estimated primary completion of 2027-03, and Biogen and Denali state that BEACON data are anticipated in the first half of 2027. (medium confidence) (verified as of 2026-11-27)",
      "source_url": "https://clinicaltrials.gov/api/v2/studies/NCT06602193",
      "also": [
        "https://investors.biogen.com/news-releases/news-release-details/biogen-and-denali-therapeutics-provide-update-phase-2b-luma"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:217f5fdabaea6f5bb53233e05ce060a5536fc80fbe7bf256ce4b91a18c27ec30",
        "ev:6b3ce95a257b416c3a7c2e689e122ca80cd1c5ee407ff2d269b56f5db995ec33",
        "ev:93bcae5fc69151ae598610f8d59f087862bf04af3b2fe5abb59514a9b00ba63f",
        "ev:9d40ba5cc7eb5c2ce0ee3eb78f8dc39c40fa68853bbacef9fc3863985178274d"
      ]
    },
    {
      "id": "clm:afa05fa50fdd72c93e9ca32d821f7c605c4874cc0d3010b7ca7f7fe682350489",
      "text": "The REASON authors describe BIIB094 (ION859) as an antisense oligonucleotide that targets LRRK2 mRNA for degradation; REASON (NCT03976349) was a first-in-human randomized phase 1 study of intrathecal BIIB094 in patients with PD. (medium confidence) (verified as of 2026-11-27)",
      "source_url": "https://pubmed.ncbi.nlm.nih.gov/41876647/",
      "also": [
        "https://clinicaltrials.gov/api/v2/studies/NCT03976349"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:14942d35fd2cb23352aecb8dba5d43bae092783e9e59ae056402a404be7a828d",
        "ev:2a02a398768179601049d27f22c3038a18217e93b61adf8d706a4761f174dd4c"
      ]
    },
    {
      "id": "clm:07c6a5e65c1ddf12572d91b380ea579deb4b4f957f339107d8dcf7bfd8482012",
      "text": "A Science Translational Medicine summary states that several different LRRK2 inhibitors induced on-target histopathological changes in the lungs of nonhuman primates that were reversible after drug withdrawal and had no effect on pulmonary function; Alzforum describes three inhibitors tested at least over a period of two weeks. (high confidence)",
      "source_url": "https://www.science.org/doi/10.1126/scitranslmed.aav0820",
      "also": [
        "https://www.alzforum.org/news/research-news/sigh-relief-lung-effects-lrrk2-inhibitors-are-mild"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:48e32b60ebc862ab912daf8f696d67f55c1fd257ffeaf33d5ec235621a2be5c7",
        "ev:9be29aea37be0da20324870b22964aadc4ed8aa848f72c8a9b80b0c1692c891a"
      ]
    }
  ],
