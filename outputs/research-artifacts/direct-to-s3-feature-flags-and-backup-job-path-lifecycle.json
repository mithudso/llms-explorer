    {
      "id": "clm:668acaa9585095837f981c8e877b75a987bd43a898fe590370c1f137c96d1650",
      "text": "Ops Manager places uploadPath=AGENT_DIRECT_S3 in the backup cursor description, and the MongoDB Agent reads that value to select the job\u2019s upload path. (low confidence) (verified as of 2026-10-14)",
      "source_url": "https://www.mongodb.com/docs/ops-manager/current/core/backup-direct-to-s3.md",
      "also": [],
      "validation_status": "SUPPORTED",
