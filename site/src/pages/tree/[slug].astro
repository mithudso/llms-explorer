---
import Base from "../../layouts/Base.astro";
import tree from "../../data/tree.json";

// `/tree/3d/` is Task 3. Link it only once that page exists, so the node pages
// never point at a route the build does not produce (test_internal_links_resolve).
const has3d = Object.keys(import.meta.glob("./3d.astro")).length > 0;

// The researched content (facets of source-cited facts) used to live on a
// separate /tree/<slug>/read/ page, one click past this one. Loaded here
// instead — same glob idiom `has3d` uses to check a sibling page exists,
// applied to enumerate data files — so a node's own page is the whole
// answer: no second page to find just to read what was researched.
const packs = import.meta.glob("../../data/concepts/*.json", { eager: true });
const packBySlug = new Map(
  Object.entries(packs).map(([path, mod]) => [
    path.split("/").pop().replace(/\.json$/, ""),
    mod.default,
  ])
);

// The "Download this reference file" link: a concept's mirrored source doc
// (gen_downloads.py's copy of src/content/sources/<hub>/<name>.md into
// public/downloads/sources/) when one exists for this slug. Only the path
// is needed, so the glob stays non-eager — nothing is loaded, just listed.
//
// The source doc's filename is NOT the concept slug in general — e.g. the
// doc `mdb-context-hub/mcp-servers.md` backs the concept slugged
// `mcp-server-development`. Matching by filename==slug (the original
// approach) only covered 130/361 concepts. Every researched pack's facts
// carry the real filename in their own `source` URL
// (`https://llms-explorer.com/sources/<hub>/<name>/#...`), so that's the
// ground truth to key off instead: walk each pack's facts for the first one
// whose source names an existing mirrored doc. Covers 346/361.
const sourceFiles = import.meta.glob("../../content/sources/*/*.md");
const existingSourceDocs = new Set(
  Object.keys(sourceFiles).map((path) => {
    const parts = path.split("/");
    const file = parts.pop().replace(/\.md$/, "");
    const hub = parts.pop();
    return `${hub}/${file}`;
  })
);
const SOURCE_URL_RE = /^https:\/\/llms-explorer\.com\/sources\/([^/]+)\/([^/#]+)\//;
const downloadBySlug = new Map();
for (const [slug, pack] of packBySlug) {
  let hit = null;
  for (const facet of pack.facets ?? []) {
    for (const fact of facet.facts ?? []) {
      const m = SOURCE_URL_RE.exec(fact.source ?? "");
      if (m && existingSourceDocs.has(`${m[1]}/${m[2]}`)) {
        hit = `/downloads/sources/${m[1]}/${m[2]}.md`;
        break;
      }
    }
    if (hit) break;
  }
  if (hit) downloadBySlug.set(slug, hit);
}

// Astro resolves a static route before a dynamic one, so a node slugging to `3d`
// would be silently served the 3D viewer instead of its own page, and two concepts
// slugging alike would silently share one URL. Fail the build instead: a concept
// with no page of its own is worse than a red build.
export async function getStaticPaths() {
  // Declared inside: Astro evaluates getStaticPaths in its own module scope, so a
  // frontmatter const is not in scope here.
  const RESERVED = new Set(["3d", "index"]);
  const seen = new Map();
  return Object.values(tree.nodes).map((n) => {
    if (RESERVED.has(n.slug)) {
      throw new Error(
        `concept "${n.concept}" slugs to the reserved route /tree/${n.slug}/ — rename it or ` +
        "the static page at that route will shadow its node page");
    }
    if (seen.has(n.slug)) {
      throw new Error(
        `two concepts slug alike: "${seen.get(n.slug)}" and "${n.concept}" both want /tree/${n.slug}/`);
    }
    seen.set(n.slug, n.concept);
    return { params: { slug: n.slug }, props: { node: n } };
  });
}
const { node } = Astro.props;
const pack = packBySlug.get(node.slug);
const downloadHref = downloadBySlug.get(node.slug);
const frontier = tree.frontier.filter((f) => f.parent_slug === node.slug);
const plural = (n, word) => `${n} ${word}${n === 1 ? "" : "s"}`;

// A related concept in a pack names its target by concept text, not slug —
// resolved against the live tree so the link always lands on a real page.
function relatedHref(concept) {
  const match = Object.values(tree.nodes).find(
    (n) => n.concept.toLowerCase() === concept.toLowerCase()
  );
  return match ? `/tree/${match.slug}/` : null;
}

const esc = (s) =>
  String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

// A facet's facts are a flat array; each carries the nesting `level`
// build_concept_packs.py derived from the source markdown's own list
// indentation (0 = a facet's top-level point, 1+ = a sub-point under the
// item before it — e.g. "Lazarus split appraisal into two steps:" at 0
// with the two steps themselves at 1). Walked here into real nested
// <ul><li> HTML so a sub-point renders indented under the point that
// introduces it, not as a same-level sibling. Packs from the other
// generator (gen_concepts.py, the 15 hand-run llms-concept-abstractor
// ones) carry no `level` field at all — `|| 0` treats every one of
// their facts as top-level, so they render as one flat list, same as
// they always have.
function renderFacts(facts) {
  const factHtml = (fact) =>
    `${esc(fact.text)} <a href="${esc(fact.source)}" class="fact-source" rel="noopener">[source]</a>` +
    (fact.note ? ` <em>— ${esc(fact.note)}</em>` : "");
  let html = "<ul>";
  let level = 0;
  facts.forEach((fact, i) => {
    const l = fact.level || 0;
    if (i === 0) {
      // first item opens the outer <li> below; nothing to close yet
    } else if (l > level) {
      html += "<ul>".repeat(l - level);
    } else if (l < level) {
      html += "</li>" + "</ul></li>".repeat(level - l);
    } else {
      html += "</li>";
    }
    html += `<li>${factHtml(fact)}`;
    level = l;
  });
  if (facts.length > 0) html += "</li>" + "</ul></li>".repeat(level);
  html += "</ul>";
  return html;
}

const description = pack
  ? String(pack.summary).slice(0, 180)
  : `Concept node: ${node.children.length} children, ${node.sourcesCount} sources, researched ${node.researchedAt}.`;
---
<Base title={node.concept} description={description} route={`/tree/${node.slug}/`} twin={null}>
  <p>
    {node.parent_slug && <>Parent: <a href={`/tree/${node.parent_slug}/`}>{node.parent}</a> · </>}
    <strong class="state" data-state={node.state}>{node.state}</strong> {node.researchedAt}
    · {plural(node.sourcesCount, "source")} · {plural(node.conceptsCount, "concept")}
    {node.skillId && <> · skill <code>{node.skillId}</code></>}
  </p>
  {node.aliases.length > 0 && <p>Also known as: {node.aliases.join(", ")}</p>}
  {downloadHref && (
    <p>
      <a href={downloadHref} download class="download-ref">
        ↓ Download this reference file
      </a>
    </p>
  )}

  {pack && (
    <>
      <blockquote>{pack.summary}</blockquote>
      {pack.facets.map((facet) => (
        <section>
          <h2>{facet.title}</h2>
          <Fragment set:html={renderFacts(facet.facts)} />
        </section>
      ))}
      {pack.related.length > 0 && (
        <section>
          <h2>Related concepts</h2>
          <ul>
            {pack.related.map((r) => {
              const href = relatedHref(r.concept);
              return (
                <li>
                  {href ? <a href={href}>{r.concept}</a> : r.concept}
                  {" "}— {r.relation}{r.note && <>; {r.note}</>}
                </li>
              );
            })}
          </ul>
        </section>
      )}
    </>
  )}

  <h2>Children</h2>
  <ul>
    {node.children.map((c) => (
      <li>
        {c.state === "researched"
          ? <a href={`/tree/${c.slug}/`}>{c.concept}</a>
          : <span class="frontier" title="frontier: named but not yet researched">{c.concept} <em>(frontier)</em></span>}
      </li>
    ))}
    {node.children.length === 0 && <li><em>No children recorded.</em></li>}
  </ul>
  {frontier.length > 0 && <p><strong>Frontier under this node:</strong> {frontier.map((f) => f.concept).join(", ")}</p>}
  <p>
    <a href="/tree/">← the whole tree</a>
    {has3d && <> · <a href="/tree/3d/">3D view</a></>}
    · <a href="/reference/concept-tree/">how to read this page</a>
  </p>
</Base>

<style>
  blockquote { border-left: 3px solid var(--line); padding-left: var(--sp-3); margin-left: 0; }
  .fact-source { font-size: var(--step--1); }
  .download-ref {
    display: inline-block;
    font-size: var(--step--1);
    padding: 0.3em 0.7em;
    border: 1px solid var(--line);
    border-radius: 0.4em;
    text-decoration: none;
  }
  .download-ref:hover { background: var(--code-bg); }
</style>
