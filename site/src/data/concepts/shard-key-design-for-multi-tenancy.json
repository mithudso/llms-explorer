            "https://mongodb.com/docs/vector-search/deployment/multi-tenant-architecture/",
            "https://www.mongodb.com/docs/manual/core/sharded-cluster-query-router.md"
          ],
          "originValidationStatus": "SUPPORTED",
          "originEvidenceIds": [
