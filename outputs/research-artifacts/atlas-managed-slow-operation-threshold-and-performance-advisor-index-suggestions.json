      ]
    },
    {
      "id": "clm:1bad274de056d7d0a818809d38a3ffb6838a45ed639991cbc263aef515c2ff36",
      "text": "In a worked Java application example, requests filtering movies by title and year produced an Advisor suggestion for {title: 1, year: 1}. This illustrates workload-driven suggestions, not a general benchmark. (low confidence)",
      "source_url": "https://nljug.org/foojay/why-mirroring-production-in-dev-helps-you-avoid-costly-mistakes/",
      "also": [],
      "validation_status": "SUPPORTED",
