---
import Base from "../layouts/Base.astro";
import GithubExplorer from "../components/GithubExplorer.astro";
import SkillsExplorerDownload from "../components/SkillsExplorerDownload.astro";
import { getCollection } from "astro:content";
import { readFileSync, existsSync } from "node:fs";
import { resolve } from "node:path";
// The llmsx wheel + sdist that tools/gen_downloads.py builds in prebuild
// (public/downloads/llmsx/manifest.json). Absent when uv is not on PATH,
// in which case the page falls back to the from-source instructions.
const manifestPath = resolve(process.cwd(), "public/downloads/llmsx/manifest.json");
const pkg = existsSync(manifestPath)
  ? (JSON.parse(readFileSync(manifestPath, "utf8")) as {
      package: string; version: string;
      files: { name: string; bytes: number; sha256: string; kind: string }[] })
  : null;
const wheel = pkg?.files.find((f) => f.kind === "wheel")?.name ?? "";
const title = "Downloads";
const description = "Install Skills Explorer, GitHub Explorer and llmsx; download agent skills, context and facts files.";
const skillGuides = await getCollection("skills");

// What each surface is TODAY, not at GA. Neither package is published to a
// registry yet, and writing `pip install llmsx` here would be a lie the first
// person to paste it discovers. The GA plan lives in
// docs/superpowers/plans/2026-08-31-remaining-build-plan.md; when it lands,
// change the command here and nowhere else.
const SKILLS = [
  ["crawl-repo-to-llms", "/skills/crawl-repo-to-llms/", "compile a whole repo into an agent dossier"],
  ["crawl-customer-to-llms", "/skills/crawl-customer-to-llms/", "merge a shared-drive engagement folder with an enterprise index"],
  ["crawl-to-llms-txt", "/skills/crawl-to-llms-txt/", "condense a site or repo into an llms family"],
  ["llms-concept-abstractor", "/skills/llms-concept-abstractor/", "pull one concept out of a corpus"],
  ["llms-deep-optimizer", "/skills/llms-deep-optimizer/", "audit and fix an existing llms family"],
  ["concept-family-explorer", "/skills/concept-family-explorer/", "map the family around a subject"],
  ["full-suite", "/skills/full-suite/", "the whole pipeline, end to end"],
];
---
<Base title={title} description={description} route="/downloads/">
  <section class="tool-chooser" aria-labelledby="tool-chooser-heading">
    <h2 id="tool-chooser-heading">Choose the tool for your task</h2>
    <p>Start with the job you want to do. Each option below leads to its setup instructions, requirements and source.</p>
    <ul class="tool-options">
      <li>
        <p class="tool-task">Research a subject and keep the results</p>
        <h3><a href="#llmsx">LLMSX research workbench</a></h3>
        <p>Explore the concept tree, save notes and assemble reference files for your agent.</p>
        <p class="tool-requirement">Python 3.11+ · Terminal application</p>
        <a class="tool-action" href="#llmsx">Install LLMSX →</a>
      </li>
      <li>
        <p class="tool-task">Maintain your installed agent skills</p>
        <h3><a href="#skills-explorer">Skills Explorer</a></h3>
        <p>Browse, edit, optimize and evaluate the skill libraries already on your machine.</p>
        <p class="tool-requirement">Local skill libraries · Terminal application</p>
        <a class="tool-action" href="#skills-explorer">Install Skills Explorer →</a>
      </li>
      <li>
        <p class="tool-task">Work in a GitHub repository</p>
        <h3><a href="#github-explorer">GitHub Explorer</a></h3>
        <p>Edit files in Vim and find Git and GitHub CLI commands in one repository workbench.</p>
        <p class="tool-requirement">macOS or Linux · Terminal application</p>
        <a class="tool-action" href="#github-explorer">Install GitHub Explorer →</a>
      </li>
      <li>
        <p class="tool-task">Give an agent a prompt or reference</p>
        <h3><a href="#agent-skills">Skills and context files</a></h3>
        <p>Read or copy a skill prompt, or fetch a Markdown reference file for the subject you need.</p>
        <p class="tool-requirement">No application install · Plain Markdown</p>
        <div class="tool-actions">
          <a class="tool-action" href="#agent-skills">Get a skill →</a>
          <a class="tool-action" href="#context-files">Get context →</a>
        </div>
      </li>
    </ul>
  </section>
  {pkg ? (
    <section class="quick-install">
      <h2>LLMSX quick install</h2>
      <pre><code>{`python -m pip install 'https://llms-explorer.com/downloads/llmsx/${wheel}[tui]'
llmsx explorer        # clones the concept tree on first run`}</code></pre>
      <p>
        <code>{pkg.package} {pkg.version}</code>, Python 3.11+. Full options, the npm package,
        and the agent skills are below.
      </p>
    </section>
  ) : null}
  <SkillsExplorerDownload />

  <GithubExplorer />

  <h2>More downloads</h2>
  <p>
    Alongside Skills Explorer and GitHub Explorer, four things are installable from this project: the <strong>agent skills</strong>, which
    are prompts an agent loads and needs no runtime; <strong><code>llmsx</code></strong>, a
    Python library and CLI for the llms.txt standard; <strong><code>llmsx-skills</code></strong>,
    the same reading surface for JavaScript; and the <strong>terminal browser</strong> over the
    concept tree, which today ships inside <code>llmsx</code> rather than as its own binary.
  </p>

  <h2 id="agent-skills">Agent skills</h2>
  <p>
    Installed with the <a href="https://github.com/vercel-labs/skills"><code>skills</code></a>
    CLI, which reads them straight out of this repository — there is no tarball to download and
    nothing to build. Each skill is a single <code>SKILL.md</code>; installing one copies that
    file into your agent's skills directory.
  </p>
  <pre><code>{`# one skill, into the current project
npx skills add mithudso/llms-explorer --skill crawl-repo-to-llms

# globally, without prompts
npx skills add mithudso/llms-explorer --skill crawl-repo-to-llms -g -y

# see everything on offer first
npx skills add mithudso/llms-explorer --list`}</code></pre>
  <p>
    The <a href="/skills/">catalogue has {skillGuides.length} skill guides</a>, each with its
    prompt and exact install command. Start with the workflows below, or browse the catalogue
    for research, capture, optimization and domain skills.
  </p>
  <table class="family-files">
    <tbody>
      {SKILLS.map(([name, href, note]) => (
        <tr>
          <td><a href={href}><code>{name}</code></a></td>
          <td>{note}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2 id="context-files">Context files and concept facts files</h2>
  <p>
    Nothing to install: these are plain markdown an agent fetches. The
    <a href="/context/">context index</a> lists every one of the hub's mirrored research reports
    (<code>/downloads/sources/&lt;hub&gt;/&lt;name&gt;.md</code>) and every concept's facts file
    (<code>/downloads/concepts/&lt;slug&gt;.md</code>), filed under the roots of the concept tree;
    the same listing with absolute URLs is <a href="/context.md"><code>/context.md</code></a>, the
    one file to read before picking the next fetch.
  </p>
  <pre><code>{`# the listing, then any one row of it
curl -s https://llms-explorer.com/context.md
curl -s https://llms-explorer.com/downloads/concepts/llms-txt.md`}</code></pre>

  <h2 id="llmsx"><code>llmsx</code> — Python library, CLI and the explorer workbench</h2>
  <p>
    A dependency-free CLI over the concept tree this site renders, a parser for the llms.txt
    standard v2, and <code>llmsx explorer</code>: the terminal workbench that browses the
    tree in place, marks, tags and links concepts, keeps local notes, bundles reference
    files for an agent, runs the research and optimizer skills, imports external llms files,
    and syncs with the repo using your own GitHub token (stored 0600 on your machine, never
    in the package). Python 3.11 or newer, MIT.
  </p>
  {pkg ? (
    <>
      <p>
        <strong>Download {pkg.package} {pkg.version}</strong> — built from this commit, scanned
        for credential-shaped strings before publishing; each file's SHA-256 is listed so you can
        verify what you fetched.
      </p>
      <ul>
        {pkg.files.map((f) => (
          <li>
            <a href={`/downloads/llmsx/${f.name}`} download>{f.name}</a>
            <span class="root-count"> {f.kind} · {(f.bytes / 1024).toFixed(0)} KB</span>
            <br /><code class="sha">sha256 {f.sha256}</code>
          </li>
        ))}
      </ul>
      <pre><code>{`python -m pip install 'https://llms-explorer.com/downloads/llmsx/${wheel}[tui]'
llmsx explorer        # clones the tree to ~/.llmsx/llms-explorer on first run`}</code></pre>
    </>
  ) : (
    <p><strong>Not on PyPI yet</strong> — install from source:</p>
  )}
  <p>Or from a checkout:</p>
  <pre><code>{`git clone https://github.com/mithudso/llms-explorer
cd llms-explorer

# the library and CLI
python -m pip install -e llmsx

# with the terminal browser
python -m pip install -e 'llmsx[tui]'

llmsx --help`}</code></pre>

  <h2><code>llmsx-skills</code> — npm package</h2>
  <p>
    The JavaScript counterpart: ESM, Node 20 or newer, MIT, zero dependencies.
    <strong>Not on npm yet</strong> — version <code>0.1.0</code> is consumed from the
    repository, either as a path dependency or by importing it directly out of a clone.
  </p>
  <pre><code>{`git clone https://github.com/mithudso/llms-explorer

# from your own package.json
npm install ./llms-explorer/llmsx-js

# then
import { parse } from "llmsx-skills";`}</code></pre>

  <h2>The terminal browser</h2>
  <p>
    There is a TUI today, and it is <em>not</em> a separate download: it ships inside
    <code>llmsx</code> as <code>llmsx tui</code>, behind the <code>[tui]</code> extra. It is the
    same Textual screen as the hub manager's Concepts tab — a tree, a filter that shows only
    matching branches, a detail pane, and frontier concepts drawn dim italic — reading the same
    generated tree this site serves at <a href="/tree/">/tree/</a>.
  </p>
  <pre><code>{`python -m pip install -e 'llmsx[tui]'
llmsx tui`}</code></pre>
  <p>
    What it deliberately does not do: the hub manager's two write actions —
    <code>n</code> to queue a concept and <code>R</code> to launch research — are absent,
    because they mutate a hub that a read-only package cannot reach.
  </p>
  <h3>Standalone, later</h3>
  <p>
    The planned standalone <strong>llms-explorer TUI</strong> is the same screen with its data
    source swapped: pointed at the API instead of a generated file, which is what makes the two
    write actions possible and turns the browser into something that can queue work rather than
    only read it. It is designed but not implemented — the hub manager's Concepts tab stays the
    reference implementation until it lands. No download exists yet, and this page will carry it
    when one does.
  </p>

  <h3>Two different "concepts"</h3>
  <p>
    <code>llmsx tui</code> and <code>llmsx concepts tui</code> browse two different data
    models, on purpose. The tree (<code>llmsx tree</code> / <code>llmsx tui</code>) is this
    site's own research concept tree — see <a href="/family/">this site's llms family</a> for
    what it is built from. Concept packs (<code>llmsx concepts</code>) are
    <code>&lt;slug&gt;.llms/</code> directories the
    <a href="/skills/llms-concept-abstractor/">concept abstractor</a> builds around one named
    concept: a <code>manifest.json</code>, a <code>concept-graph.json</code> of related terms,
    and the familiar <code>llms.txt</code> / <code>llms-full.txt</code> /
    <code>llms-small.txt</code> / <code>llms-facts.txt</code> /
    <code>llms-vocabulary.txt</code> ladder — pointed by default at
    <code>~/.global-ai-hub/llms-concepts</code>, overridable with <code>--data</code> or
    <code>$LLMSX_CONCEPTS_PATH</code>.
  </p>

  <h2>Running a skill from the CLI</h2>
  <p>
    <code>llmsx family</code> and <code>llmsx optimize</code> are thin wrappers over
    <code>llmsx.skills.run_skill</code>: one model turn holding the named skill's own
    instructions as the system prompt, your input as the user turn. Both print a one-line
    disclaimer before the model's output, because it is genuinely not the same thing as running
    <a href="/skills/concept-family-explorer/">concept-family-explorer</a> or
    <a href="/skills/full-suite/">the full suite</a> end to end — those orchestrate multi-pass
    loops, subagent fan-out and concept-tree writes that a single API call does not drive.
    Useful for a quick read on a topic or a file; not a substitute for the loop when you need
    the loop.
  </p>

  <h2>Reading the site itself</h2>
  <p>
    The site is also a download, in the sense that matters to an agent: five
    <a href="/family/">llms files</a> that describe every page here, served as
    <code>text/markdown</code> and refreshed on every build.
  </p>
</Base>

<style>
  p, li, td { overflow-wrap: anywhere; }
  .family-files td:first-child { white-space: normal; }
  .family-files { table-layout: fixed; width: 100%; }
  h2[id] { scroll-margin-top: 7rem; }
  .tool-chooser { margin-bottom: var(--sp-7); }
  .tool-chooser > h2 { margin-top: 0; }
  .tool-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-4); padding: 0; margin: var(--sp-5) 0 0; list-style: none; }
  .tool-options > li { display: flex; flex-direction: column; gap: var(--sp-2); min-width: 0; margin: 0; padding: var(--sp-5); background: var(--paper-raised); border: 1px solid var(--line); border-radius: var(--radius); }
  .tool-options h3 { margin: 0; font-size: var(--step-0); }
  .tool-options h3 a { color: var(--ink); text-decoration: none; }
  .tool-options h3 a:hover { color: var(--accent); text-decoration: underline; }
  .tool-options p { margin: 0; }
  .tool-task { color: var(--accent); font-size: var(--step--1); font-weight: 600; }
  .tool-requirement { color: var(--ink-muted); font-size: var(--step--1); }
  .tool-action { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }
  .tool-options > li > .tool-action, .tool-actions { margin-top: auto; }
  .tool-actions { display: flex; flex-wrap: wrap; gap: var(--sp-4); }
  .sha { overflow-wrap: anywhere; }
  .quick-install { border: 1px solid var(--accent); border-radius: var(--radius); padding: 1rem 1.25rem; margin-bottom: 1.5rem; background: var(--accent-soft); }
  .quick-install h2 { margin-top: 0; }
  .quick-install pre { margin-bottom: 0.5rem; }
  @media (max-width: 680px) { .tool-options { grid-template-columns: 1fr; } }
</style>
