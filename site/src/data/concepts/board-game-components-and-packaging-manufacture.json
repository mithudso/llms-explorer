            "ev:4ed9b347f25dbe1ca478e1aac03948b9d24b912d4393382ef3c603654062e7a6",
            "ev:af4b88cf40ed8200a2f11127f4957c9e933840eb8857c0d684fa8e9a32821021",
            "ev:d46e37ef8981da04b0cf388ebfe247ed45dd7adf006923a70bcf64678638dc99"
          ]
        },
        {
          "text": "Panda reviews a complete mass-production copy before final assembly and checks completeness as components enter the box; Scorpion Masqué also describes component QA and a full assembly check on production samples. (medium confidence)",
          "source": "https://pandagm.com/our-process/",
