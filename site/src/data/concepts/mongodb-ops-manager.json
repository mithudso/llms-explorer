    {
      "title": "Ops Manager Upgrade Path",
      "facts": [
        {
          "text": "Backup App DB before upgrade",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#ops-manager-upgrade-path",
          "note": null,
          "level": 1
        },
        {
          "text": "Check compatibility matrix: Ops Manager version → MongoDB Agent version → MongoDB server version",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#ops-manager-upgrade-path",
          "note": null,
          "level": 1
        },
        {
          "text": "Upgrade Ops Manager application (rolling upgrade supported for multi-node OM deployments)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#ops-manager-upgrade-path",
          "note": null,
          "level": 1
        },
        {
          "text": "Upgrade MongoDB Agents on all hosts (Ops Manager prompts for agent upgrade)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#ops-manager-upgrade-path",
          "note": null,
          "level": 1
        },
        {
          "text": "Verify: Check agent connectivity status in Ops Manager UI",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#ops-manager-upgrade-path",
          "note": null,
          "level": 1
        },
        {
          "text": "Version support policy: Ops Manager N, N-1, N-2 are supported. MongoDB Agent must be ≥ Ops Manager version.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#ops-manager-upgrade-path",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "Anti-Patterns",
      "facts": [
        {
          "text": "Single-node App DB: Ops Manager becomes unavailable if App DB node fails; always use 3-node RS",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#anti-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Backup Daemon on the MongoDB host: Backup creates I/O; place on dedicated host",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#anti-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Air-gap without pre-downloading all required MongoDB binaries: Automation will fail if the Agent can't find the requested version locally",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#anti-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Not using immutable S3 snapshots for compliance: Object Lock prevents accidental or malicious deletion of backup data",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#anti-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Manual edits to MongoDB configs outside Ops Manager automation: Ops Manager will reconcile these back to the goal state on next agent heartbeat",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#anti-patterns",
          "note": null,
          "level": 0
        }
      ]
    },
