---
import "../styles/global.css";
import "../styles/lx-polish.css";
const { title, description, route, twin: twinProp, noindex = false } = Astro.props;
// `noindex` keeps mirrored material (the hub's docs under /sources/, the
// per-file /directory/<key>/ grade cards) out of search results so the index
// reflects the site's own writing. `follow` still lets crawlers walk the links,
// and tools/build_sitemap.py drops these pages from sitemap.xml.
// Content pages carry a `.md` twin at the same route; the generated listing
// pages (home, section indexes) pass `twin={null}` because twins.py writes a
// twin only for `src/content/**`, and a link to a file that is not published
// is worse than no link.
const twin = twinProp === undefined ? route.replace(/\/$/, "") + ".md" : twinProp;
// Routes that hold a secret (session islands, the one-time key, API-key
// inputs) get no third-party script. Mirrors STRICT_ROUTES in tools/twins.py,
// which gives these routes the CSP that would block the tags anyway.
const STRICT_ROUTES = ["/login/", "/account/", "/keys/", "/usage/", "/contribute/",
                       "/donate/", "/moderate/", "/proposals/", "/playground/"];
const strict = STRICT_ROUTES.some((r) => route.startsWith(r));
// The three things an agent comes here for lead the line — skills to install,
// context files to load, concepts to look up — then the blog and the surfaces
// that verify them. /tree/ keeps its URL and is labelled by what it holds. Each
// entry carries a one-line note, shown as the link's title, so a first-time
// reader can tell Context files (the shelf: files to load) from Concepts (the
// map: what is known, browsed inline).
const NAV = [
  ["/skills/", "Skills", "Prompts to install — braindump, to-do, research, llms.txt builders"],
  ["/context/", "Context files", "The shelf: research reports and facts files to load, sized in tokens"],
  ["/tree/", "Concepts", "The map: every researched concept, expanded inline"],
  ["/explorer/", "Explorer", "The research workbench: live jobs, queue, flashcards, quizzes & highlights"],
  ["/blog/", "Blog", "Posts with figures measured from the corpus"],
  ["/directory/", "Directory", "Public llms-full.txt files, scored"],
  ["/reference/", "Reference", "The rubric the scores come from"],
  ["/downloads/", "Downloads", "The skills, library, CLI and terminal browser"],
];
// The skills a reader is most likely to want first — the two personal-capture
// ones, then the skills the concept tree is built WITH. Listed in a menu rather
// than the nav line because nine more top-level links would bury the sections a
// first-time reader actually needs.
const SKILLS = [
  ["/skills/braindump/", "Braindump (/braindump)", "dump loose thoughts; get categorised llms files back"],
  ["/skills/todo/", "To-do (/todo)", "one list that collects what every session left open"],
  ["/skills/notes-to-llms-txt/", "Notes to llms.txt", "turn a mess of notes into loadable context"],
  ["/skills/memory-to-llms-txt/", "Memory to llms.txt", "compile an agent's memory store into one family"],
  ["/skills/concept-family-explorer/", "Concept family explorer", "map the family around a subject"],
  ["/skills/rabbithole/", "Rabbithole", "exhaust one concept, depth-first"],
  ["/skills/dr/", "Deep research (/dr)", "research one named topic"],
  ["/skills/crawl-repo-to-llms/", "Crawl repo to llms", "compile a repo into an agent dossier"],
  ["/playground/notes-to-llms/", "Playground", "three skills you can run in the browser"],
  ["/skills/", "All skills", "the full catalogue — each installable via npx"],
];
---
<html lang="en"><head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {!strict && (<>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-0KWFPMH6WX" crossorigin="anonymous"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-0KWFPMH6WX');
  </script>
  <!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1706083044457708" crossorigin="anonymous"></script>
  </>)}
  <title>{title} · LLMS-Explorer</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={new URL(route, Astro.site).href} />
  {twin && <link rel="alternate" type="text/markdown" href={twin} />}
  <link rel="describedby" href="/llms.txt" />
  <script src="../scripts/lx-polish.js"></script>
</head><body>
  <header class="site-header">
    <nav class="site-nav" aria-label="Primary">
      <a class="brand" href="/">llms-explorer</a>
      <span class="links">
        {NAV.map(([href, label, note]) => (
          <a href={href} title={note} aria-current={route.startsWith(href) ? "page" : null} data-track="nav_click" data-label={label} data-destination={href}>{label}</a>
        ))}
        <details class="menu"><summary data-track="skills_menu_open">Popular skills</summary>
          <div class="menu-items">
            {SKILLS.map(([href, name, note]) => (
              <a href={href}>{name}<span class="menu-note">{note}</span></a>
            ))}
          </div>
        </details>
        <span class="utility">
          <a href="/contribute/" data-track="nav_click" data-label="Contribute" data-destination="/contribute/">Contribute</a>
          <a href="/donate/" data-track="nav_click" data-label="Donate" data-destination="/donate/">Donate</a>
          <a href="/login/" data-track="nav_click" data-label="Sign in" data-destination="/login/">Sign in</a>
        </span>
        {/* /family/ renders the served llms.txt with clickable links; the raw
            file stays text/markdown, unreadable in a browser (see /family/). */}
        <a class="twin" href="/family/">llms.txt</a>
        {twin && <a class="twin" href={twin}>.md</a>}
      </span>
    </nav>
  </header>
  <main><h1>{title}</h1><slot /></main>
  <footer class="site-footer">
    Built for agents and the people who run them — every page here has a <code>.md</code> twin, every context file is a plain fetch, and the whole site ships as one <a href="/llms.txt">llms.txt</a> family.
  </footer>
  <script is:inline>
    // Delegated GA4 click tracking (measurement-plan-2026-09-07.md §2, redesign-spec-2026-09-07.md §9).
    // One listener covers every current and future [data-track] element; no-ops if gtag is
    // unavailable (ad blockers) rather than throwing. Never blocks navigation.
    document.addEventListener("click", function (event) {
      if (typeof gtag !== "function") return;
      var el = event.target.closest && event.target.closest("[data-track]");
      if (!el) return;
      var name = el.dataset.track;
      // skills_menu_open fires from the toggle listener below, not from this click delegate,
      // so a click that merely opens/closes the <details> doesn't double-count or fire on close.
      if (name === "skills_menu_open") return;
      var params = {};
      if (el.dataset.card) params.card = el.dataset.card;
      if (el.dataset.ctaId) params.cta_id = el.dataset.ctaId;
      if (el.dataset.label) params.label = el.dataset.label;
      if (el.dataset.destination) params.destination = el.dataset.destination;
      else if (el.href) params.destination = el.pathname;
      gtag("event", name, params);
    });
    document.addEventListener(
      "toggle",
      function (event) {
        if (typeof gtag !== "function") return;
        var details = event.target;
        if (details.matches && details.matches("details.menu") && details.open) {
          gtag("event", "skills_menu_open", {});
        }
      },
      true,
    );
  </script>
</body></html>
