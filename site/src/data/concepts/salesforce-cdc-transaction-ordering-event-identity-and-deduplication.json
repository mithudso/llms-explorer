  "facets": [
    {
      "title": "Definitions",
      "facts": [
        {
          "text": "If some objects participating in a transaction are not enabled for CDC, sequence numbers can have gaps; a missing sequence number alone therefore does not prove delivery loss. (low confidence)",
          "source": "https://developer.salesforce.com/docs/platform/change-data-capture/guide/cdc-replication-steps.html",
          "note": null,
          "claimId": "clm:46bfd0009cc6b793cbb9a28434294921c7395f2248514d47674ee199397ecf4a",
          "validationStatus": "SUPPORTED",
