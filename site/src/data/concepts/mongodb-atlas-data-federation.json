            "ev:dd08e61dcadf0f2d842d8734950bddbe56899650d325d7bbf36ea8389271406f"
          ],
          "also": [
            "https://www.mongodb.com/docs/atlas/data-federation/supported-unsupported/limitations.md"
          ]
        },
        {
          "text": "Federation prunes object-storage files using partition information. (medium confidence)",
          "source": "https://www.mongodb.com/docs/atlas/data-federation/adf-overview/query-performance-optimization.md",
          "note": null,
          "claimId": "clm:aaa5b0f0954ebaf3ac54c3763e6fc6b6eb7b96ae0ffe10c4a2060188cfca2b8c",
          "validationStatus": "SUPPORTED",
          "evidenceIds": [
