    {
      "title": "9. Abstract vs. introduction — different jobs",
      "facts": [
        {
          "text": "Abstract - a self-contained summary readable without the paper. 150–300 words.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/academic-and-citation-writing/#9-abstract-vs-introduction-different-jobs",
          "note": null
        },
        {
          "text": "Context / problem (1 sentence)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/academic-and-citation-writing/#9-abstract-vs-introduction-different-jobs",
          "note": null
        },
        {
          "text": "Method (1–2 sentences)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/academic-and-citation-writing/#9-abstract-vs-introduction-different-jobs",
          "note": null
        },
        {
          "text": "Results (2–3 sentences with the actual numbers)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/academic-and-citation-writing/#9-abstract-vs-introduction-different-jobs",
          "note": null
        },
        {
          "text": "Implication (1 sentence)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/academic-and-citation-writing/#9-abstract-vs-introduction-different-jobs",
          "note": null
        },
        {
          "text": "Introduction - the opening section of the paper proper. Reviews relevant prior work, identifies the gap, states the research question.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/academic-and-citation-writing/#9-abstract-vs-introduction-different-jobs",
          "note": null
        }
      ]
    },
    {
      "title": "Anti-Patterns",
      "facts": [
        {
          "text": "Pseudo-citation - \"Studies show...\", \"research suggests...\"",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/academic-and-citation-writing/#anti-patterns",
          "note": null
        },
        {
          "text": "Quote-bombing - paragraph after paragraph of standalone quotations",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/academic-and-citation-writing/#anti-patterns",
          "note": null
        },
        {
          "text": "Secondary cited as primary - citing a source without reading it",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/academic-and-citation-writing/#anti-patterns",
          "note": null
        },
        {
          "text": "Style mixing - APA in-text with MLA works-cited entries",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/academic-and-citation-writing/#anti-patterns",
          "note": null
        },
        {
          "text": "Missing DOIs - references with URLs that will rot",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/academic-and-citation-writing/#anti-patterns",
          "note": null
        }
      ]
