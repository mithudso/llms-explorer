---
import "../styles/global.css";
const { title, description, route, twin: twinProp } = Astro.props;
// Content pages carry a `.md` twin at the same route; the generated listing
// pages (home, section indexes) pass `twin={null}` because twins.py writes a
// twin only for `src/content/**`, and a link to a file that is not published
// is worse than no link.
const twin = twinProp === undefined ? route.replace(/\/$/, "") + ".md" : twinProp;
const NAV = [
  ["/reference/", "Reference"],
  ["/essays/", "Essays"],
  ["/examples/", "Examples"],
  ["/blog/", "Blog"],
];
// The skills the concept tree is built WITH, as opposed to the concepts in it.
// Listed in a menu rather than the nav line because six more top-level links
// would bury the four sections a first-time reader actually needs.
const SKILLS = [
  ["/skills/concept-family-explorer/", "Concept family explorer", "map the family around a subject"],
  ["/skills/rabbithole/", "Rabbithole", "exhaust one concept, depth-first"],
  ["/skills/dr/", "Deep research (/dr)", "research one named topic"],
  ["/skills/skill-tree-architect/", "Skill tree architect", "rebalance the tree itself"],
  ["/skills/full-suite/", "Full suite", "the whole pipeline, end to end"],
  ["/skills/llms-concept-abstractor/", "Concept abstractor", "pull one concept out of a corpus"],
];
---
<html lang="en"><head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · LLMS-Explorer</title>
  <meta name="description" content={description} />
  {twin && <link rel="alternate" type="text/markdown" href={twin} />}
  <link rel="describedby" href="/llms.txt" />
</head><body>
  <header class="site-header">
    <nav class="site-nav" aria-label="Primary">
      <a class="brand" href="/">llms-explorer</a>
      <span class="links">
        {NAV.map(([href, label]) => (
          <a href={href} aria-current={route.startsWith(href) ? "page" : null}>{label}</a>
        ))}
        <details class="menu"><summary>Skills</summary>
          <div class="menu-items">
            {SKILLS.map(([href, name, note]) => (
              <a href={href}>{name}<span class="menu-note">{note}</span></a>
            ))}
          </div>
        </details>
        <a href="/login/">Sign in</a>
        {/* /family/ renders the served llms.txt with clickable links; the raw
            file stays text/markdown, unreadable in a browser (see /family/). */}
        <a class="twin" href="/family/">llms.txt</a>
        {twin && <a class="twin" href={twin}>.md</a>}
      </span>
    </nav>
  </header>
  <main><h1>{title}</h1><slot /></main>
  <footer class="site-footer">
    Built for machines and humans alike — every page here has a <code>.md</code> twin and the whole site ships as one <a href="/llms.txt">llms.txt</a> family.
  </footer>
</body></html>
