            "claim_text_sha256": "e7ea98d0f2981876c3282afcafd3f1febd65bbfc07c3d94e31baeb9e06173e2c"
          }
        },
        {
          "text": "MongoDB recommends Authorization Code Flow with PKCE for workforce users; Device Authorization Flow is an option for machines without a browser. Register a public native client with redirect URI http://localhost:27097/redirect. (low confidence) (verified as of 2026-10-23)",
          "source": "https://www.mongodb.com/docs/atlas/workforce-oidc/?fresh=20261023",
          "note": null,
          "claimId": "clm:7a984fa042208b0dfa89f6163cd9f3b8db5f90488b05d00726e22892553606d3",
          "validationStatus": "SUPPORTED",
