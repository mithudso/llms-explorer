    {
      "id": "clm:117d4ac4d9140273743e0fe88caa75ba16dc0e6df7b1e58a17050ff060606c4c",
      "text": "Confluent warns that external stream enrichment can overload dependencies during replay, propagate latency/failures, and retrieve current rather than historical state. These are useful ASP validation questions, not established native-stage guarantees. (low confidence)",
      "source_url": "https://docs.confluent.io/cloud/current/ai/external-tables/overview.html",
