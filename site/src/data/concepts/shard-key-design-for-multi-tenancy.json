          }
        },
        {
          "text": "Zones can associate shard-key value ranges with selected shards, supporting placement policies such as isolating a specific subset of data on a specific set of shards. A chunk that represents a single shard key value cannot be split, so repeated tenantId values in a tenant-only key do not become splittable. Sources: https://www.mongodb.com/docs/manual/core/zone-sharding.md ; https://www.mongodb.com/docs/manual/core/sharding-data-partitioning.md",
          "source": "https://www.mongodb.com/docs/manual/core/zone-sharding.md",
          "note": null,
          "claimId": "clm:3d363dc4c43c09f24f365d00a2309daab969d4e7142e5c321dfb9a6901d6b1ac",
          "validationStatus": "REMEDIATED-PROJECTION",
          "evidenceIds": [],
          "also": [
            "https://www.mongodb.com/docs/manual/reference/method/sh.updateZoneKeyRange.md",
            "https://www.mongodb.com/docs/vector-search/deployment/multi-tenant-architecture.md",
            "https://www.mongodb.com/docs/manual/core/sharding-choose-a-shard-key/",
            "https://www.mongodb.com/docs/manual/core/sharding-data-partitioning.md"
          ],
          "originValidationStatus": "SUPPORTED",
