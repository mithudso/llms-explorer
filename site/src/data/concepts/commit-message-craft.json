      "title": "7. Fixup / squash / autosquash discipline",
      "facts": [
        {
          "text": "git commit --fixup=<sha> writes a commit message starting with fixup! <original-subject>.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/commit-message-craft/#7-fixup-squash-autosquash-discipline",
          "note": null
        },
        {
          "text": "--fixup discards the fixup's commit message; only the original is kept. Use for typo fixes.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/commit-message-craft/#7-fixup-squash-autosquash-discipline",
          "note": null
        },
        {
          "text": "--squash keeps both messages joined. Use when the \"fix\" adds meaningful nuance.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/commit-message-craft/#7-fixup-squash-autosquash-discipline",
          "note": null
        },
        {
