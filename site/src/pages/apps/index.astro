---
import Base from "../../layouts/Base.astro";
import APPS from "../../data/apps.json";
---
<Base title="Apps" heading="Choose a workbench for the job" description="Compare LLMSX Explorer, Skills Explorer and GitHub Explorer by task, requirements and first useful result." route="/apps/">
  <p class="lede">Three separate terminal applications. Start with the job you need to do.</p>
  <ul class="app-grid">
    {APPS.map(app => <li>
      <p class="content-kind">{app.task}</p>
      <h2><a href={`/apps/${app.slug}/`} data-track="app_open" data-label={app.slug}>{app.name}</a></h2>
      <p>{app.description}</p>
      <a href={`/apps/${app.slug}/`} tabindex="-1" aria-hidden="true"><img src={app.image} alt="" loading="lazy" /></a>
      <p>{app.requirements}</p>
      <a class="btn secondary" href={`/apps/${app.slug}/`} data-track="app_open" data-label={app.slug}>Explore {app.name}</a>
    </li>)}
  </ul>
  <h2>Start without an application</h2>
  <p><a href="/workflows/">Try a worked workflow</a>, <a href="/skills/">read a reusable skill</a> or <a href="/research/">find a reference by task</a>. These work without installing a terminal app.</p>
  <p><a href="/downloads/">All installation methods and downloads</a> · <a href="/tree/">Explore the concept tree</a></p>
</Base>

