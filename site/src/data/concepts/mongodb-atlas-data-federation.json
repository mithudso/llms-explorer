    {
      "title": "Structure and components",
      "facts": [
        {
          "text": "ISG analyst Matt Aslett’s April 2023 assessment framed federation and SQL access as part of application-driven analytics and argued that MongoDB should clarify how its analytics capabilities complement separate BI, data-science, and machine-learning platforms. This is historical analyst positioning, not a performance benchmark. (low confidence)",
          "source": "https://research.isg-one.com/analyst-perspectives/mongodbs-atlas-delivers-data-driven-applications",
          "note": null,
          "claimId": "clm:0d25e2003f03014cac48e584f70faa4f7c39a23ce3aee5e5902357be89117711",
          "validationStatus": "SUPPORTED",
          "evidenceIds": [
