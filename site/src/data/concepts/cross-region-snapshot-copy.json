          }
        },
        {
          "text": "If the primary region goes down and its snapshot is unavailable, Atlas can restore from a copied snapshot in another region. This is a backup recovery path that requires restoration; it does not itself provide automatic application failover. (medium confidence) (verified as of 2026-10-23) Sources: https://www.mongodb.com/docs/atlas/backup/cloud-backup/snapshot-distribution.md ; https://www.mongodb.com/docs/atlas/architecture/current/disaster-recovery.md",
          "source": "https://www.mongodb.com/docs/atlas/backup/cloud-backup/snapshot-distribution.md",
          "note": null,
          "claimId": "clm:9a3efcc1c255fdd7f7019c894edee4d64c40ac0df2ad5ab9ff6bcd8b6d250d19",
          "validationStatus": "REMEDIATED-PROJECTION",
          "evidenceIds": [],
          "also": [
            "https://www.mongodb.com/docs/atlas/architecture/current/disaster-recovery.md",
            "https://oneuptime.com/blog/post/2026-03-31-mongodb-set-up-cross-region-backup-atlas/view"
          ],
          "originValidationStatus": "SUPPORTED",
          "originEvidenceIds": [
