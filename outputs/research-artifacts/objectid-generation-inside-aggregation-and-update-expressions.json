  "concept": "ObjectId generation inside aggregation and update expressions",
  "slug": "objectid-generation-inside-aggregation-and-update-expressions",
  "canonical_concept_id": "concept:34f35411e10af487f50c2d1c2715eb4c6b3674a335dba10899ab9eadc1310d33",
