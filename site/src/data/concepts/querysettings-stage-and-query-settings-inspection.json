    {
      "title": "Comparisons and alternatives",
      "facts": [
        {
          "text": "If an aggregation has additional stages, $querySettings must be its first stage. The manual uses database-level db.aggregate rather than a collection aggregation. (low confidence)",
          "source": "https://www.mongodb.com/docs/manual/reference/operator/aggregation/querySettings.md",
          "note": null,
