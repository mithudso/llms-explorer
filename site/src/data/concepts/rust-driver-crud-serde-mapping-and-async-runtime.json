    {
      "title": "Comparisons and alternatives",
      "facts": [
        {
          "text": "Serde rename changes a serialized and deserialized field name. The driver integrates Serde attributes into custom mapping, allowing a Rust field name to differ from its stored name. (high confidence)",
          "source": "https://serde.rs/field-attrs.html",
          "note": null,
          "claimId": "clm:6083dc0178aa0bb75ff4662bbce4d7c510fdc278b42adf562c37800c5a0ed03b",
          "validationStatus": "SUPPORTED",
          "evidenceIds": [
