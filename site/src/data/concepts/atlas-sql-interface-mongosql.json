    {
      "title": "Overview",
      "facts": [
        {
          "text": "Two distinct approaches for SQL-based BI tool integration with MongoDB:",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-bi-connector/#overview",
          "note": null
        },
        {
          "text": "Legacy BI Connector (mongosqld): EOL September 2026. Self-hosted translation layer.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-bi-connector/#overview",
          "note": null
        },
        {
          "text": "Atlas SQL Interface (current): Managed service via Atlas Data Federation. Certified connectors for Tableau and Power BI.",
