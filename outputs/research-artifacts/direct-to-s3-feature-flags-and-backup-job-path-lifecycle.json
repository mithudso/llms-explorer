    {
      "id": "clm:2cd4157f31c2211322a4c9a25bc45c8cec2b70f268cd50ed04701e298099afa0",
      "text": "An operator can enable or disable Direct S3 Backup for an individual job through Admin > Backup > Jobs, then save the change. (low confidence) (verified as of 2026-10-14)",
      "source_url": "https://www.mongodb.com/docs/ops-manager/current/core/backup-direct-to-s3.md",
      "also": [],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:ec5889912f03a64438bd95711a012bae6b8b66e7ce6765f428c20c336abf26a1"
