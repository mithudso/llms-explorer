      "title": "Orchestration patterns",
      "facts": [
        {
          "text": "Five patterns dominate production agent systems:",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/agent-plan-writing/#orchestration-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Fan-Out: Parallel execution of independent subtasks. Coordinator dispatches to N agents simultaneously.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/agent-plan-writing/#orchestration-patterns",
          "note": null,
          "level": 1
        },
        {
          "text": "Pipeline: Sequential chain where each stage requires the prior stage's output.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/agent-plan-writing/#orchestration-patterns",
          "note": null,
          "level": 1
        },
        {
          "text": "Supervisor: A supervisor agent decomposes the task, delegates to specialists, and synthesizes results. The 2026 production default.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/agent-plan-writing/#orchestration-patterns",
          "note": null,
          "level": 1
        },
        {
          "text": "Debate: Multiple agents reason independently, then argue toward convergence.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/agent-plan-writing/#orchestration-patterns",
          "note": null,
          "level": 1
        },
        {
          "text": "Swarm: Dynamic spawning of agents based on workload.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/agent-plan-writing/#orchestration-patterns",
          "note": null,
          "level": 1
        }
      ]
    },
