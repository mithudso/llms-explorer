    },
    {
      "id": "clm:0c9d4c485360b62ce5463febf589c3e9281c8a85f284eadc9e8048849bc97490",
      "text": "The coordinator attaches interceptors for resumable builds before onStepUp returns and the node accepts writes. Its comment explains that an earlier write would otherwise be invisible to the resumed build. (low confidence) (verified as of 2026-10-20)",
      "source_url": "https://raw.githubusercontent.com/mongodb/mongo/master/src/mongo/db/index_builds/index_builds_coordinator.cpp",
