---
import Base from "../../layouts/Base.astro";
import DirectoryTable from "../../components/DirectoryTable.astro";
import directory from "../../data/directory.json";

// A generated listing page, like the section indexes: `twin={null}`, because
// twins.py writes a `.md` twin only for `src/content/**`. The prose that does
// carry a twin — and so enters this site's own llms family — is
// /reference/directory/, linked below.
const { sites, count, generated } = directory;
const GRADES = ["A", "B", "C", "D", "F"];
const spread = GRADES.map((g) => [g, sites.filter((s) => s.grade === g).length]);
const pages = sites.reduce((n, s) => n + s.pages, 0);
const title = "The directory of known llms files";
const description = `${count} sites that publish an llms-full.txt, each scored against the /ldo rubric by llms_lint. Recorded ${generated}.`;
---
<Base title={title} description={description} route="/directory/" twin={null}>
  <p>
    Every site we know of that publishes an <code>llms-full.txt</code>, scored against
    the <a href="/reference/attributes/">attribute rubric</a> by <code>llms_lint</code>.
    <strong>{count} sites</strong>, {pages.toLocaleString("en-US")} pages between them,
    scored on <strong>{generated}</strong>.
  </p>
  <p>
    The grade is the linter's arithmetic, not an opinion:
    {spread.map(([g, n], i) => (<>{i > 0 && ", "}<strong>{g}</strong> {n}</>))}.
    <a href="/reference/directory/">What the grade means</a>, and why we link each
    source's own file instead of republishing the text we mirrored.
  </p>

  <DirectoryTable sites={sites} />

  <p>
    <a href="/reference/directory/">How the directory is scored</a> ·
    <a href="/reference/attributes/">The attribute rubric</a> ·
    <a href="/reference/spec/">The spec</a>
  </p>
</Base>
