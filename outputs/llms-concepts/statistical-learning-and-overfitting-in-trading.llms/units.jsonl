{"id": "clm:1699d512ed8dbdaa2f651a567cbad00173e3e601c3ec903a43c79ac1cf70fde4", "type": "statement", "text": "A naive forecast sets every future forecast equal to the last observed value. (low confidence)", "source_url": "https://otexts.com/fpp3/simple-methods.html", "anchor": "", "page_class": "reference", "keywords": ["Statistical learning and overfitting in trading"], "code": null, "origin": "dr", "section": "facts", "relation": "about", "score": 1.0, "also": [], "semantic_score": null, "pass": "keyword", "canonical_concept_id": "concept:e505ec9a82ab5533269cdaeb3ff55cf2b9a13e88e02032ef58e7feea24eb8a86", "validation_status": "SUPPORTED", "evidence_ids": ["ev:80d132fcd147a037997304350e19945129f995de8e16a90f1c90c1c65c2f08a4"]}
