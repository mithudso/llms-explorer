    {
      "id": "clm:7840996db1af031872ee027080d1f02f22d43a616a0e48d2208f88bd36bf852f",
      "text": "Recipient history replay writes local no-ops. An incoming non-no-op is preserved as the nested original operation; an already migrated no-op is not nested again. Image no-ops retain their image object, and owning-shard-change sentinels retain their special object. Other operations receive the session-migration tag, a local previous-write link, a newly allocated operation time and the from-migration marker. These statements describe history records, not reapplication of donor user-data mutations. (low confidence)",
      "source_url": "https://raw.githubusercontent.com/mongodb/mongo/dacdbc3df2fbe579b03336a2f01fc9aedf406a41/src/mongo/db/s/session_catalog_migration_destination.cpp",
      "also": [
        "https://api.github.com/repos/mongodb/mongo/git/ref/tags/r7.0.22",
        "https://api.github.com/repos/mongodb/mongo/git/tags/ef98696d6009abf1b6f73a935c9f7bb3fa3ea4c4",
        "https://www.mongodb.com/docs/v7.0/release-notes/7.0/"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:2c2c2a9c3f1e3192a084d545122ad01680285240684928f25e20f3e553ae7d92",
        "ev:65df6cd8d3003206d34351dabc24c1c7eafbde5a6c98453a50c2e8b4290236f3",
        "ev:6f2f65e6aec688a312f3fc143d0cd48918f6955cccb839e550fc5ffb2b44b24c",
        "ev:6fd7ddbbf1c54421feca69dce8e596d50a2dfe87da07d850b7a4e7498c543bdc",
        "ev:e648c6fc3cb3e2ed2034aca9de1a0b6e7d30392b8ed620c1875340a59140d439"
      ],
      "temporal": {
