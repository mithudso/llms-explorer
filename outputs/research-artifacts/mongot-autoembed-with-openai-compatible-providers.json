      ]
    },
    {
      "id": "clm:ec7f4f319f2464eb025e1f00707770172f62ab2bdb1054de5206d6903eba6234",
      "text": "Percona documents per-model provider selection: the index model matches catalog modelName, whose embeddingProvider selects the client. The global embedding.providerEndpoint override applies only to VOYAGE; OPENAI_COMPATIBLE models use their catalog endpoint. (high confidence) (verified as of 2026-10-29)",
      "source_url": "https://docs.percona.com/percona-search-for-mongodb/configure-automatic-embedding.html",
      "also": [
        "https://docs.percona.com/percona-search-for-mongodb/automatic-embedding-with-OpenAI-providers.html",
