          "note": null,
          "level": 0
        },
        {
          "text": "Automation: Declarative goal-state management of MongoDB clusters (topology, version, config)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#overview",
          "note": null,
          "level": 1
        },
        {
          "text": "Monitoring: Real-time metrics, alerts, and dashboards",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#overview",
          "note": null,
          "level": 1
        },
        {
          "text": "Backup: Continuous oplog-based backup with PITR",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#overview",
          "note": null,
          "level": 1
        }
      ]
    },
    {
      "title": "App Database Sizing",
      "facts": [
        {
          "text": "The App DB stores Ops Manager's own state. Sizing:",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#app-database-sizing",
          "note": null,
          "level": 0
        },
        {
          "text": "Small (< 50 MongoDB processes): 3-node RS, M10 equivalent (8 GB RAM)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#app-database-sizing",
          "note": null,
          "level": 1
        },
        {
          "text": "Medium (50-500 processes): 3-node RS, M30 equivalent (32 GB RAM)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#app-database-sizing",
          "note": null,
          "level": 1
        },
        {
          "text": "Large (500+ processes): 5-node RS or sharded cluster",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#app-database-sizing",
          "note": null,
          "level": 1
        },
        {
          "text": "App DB HA: Always use 3-node replica set. Single-node App DB = single point of failure for Ops Manager.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#app-database-sizing",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "MongoDB Agent",
      "facts": [
        {
          "text": "A single binary that handles automation, monitoring, and backup for all MongoDB processes on the host.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#mongodb-agent",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "Automation (Declarative Goal State)",
      "facts": [
        {
          "text": "Ops Manager maintains the desired topology in the automation config JSON. The Agent continuously reconciles actual state to match the goal state.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#automation-declarative-goal-state",
          "note": null,
          "level": 0
        },
        {
          "text": "Example: Add a replica set via API",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#automation-declarative-goal-state",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "Backup Daemon",
      "facts": [
        {
          "text": "Backup Daemon runs on a dedicated host. It:",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#backup-daemon",
          "note": null,
          "level": 0
        },
        {
          "text": "Reads from oplog of source MongoDB (via agent)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#backup-daemon",
          "note": null,
          "level": 1
        },
        {
          "text": "Writes snapshots to configured store",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#backup-daemon",
          "note": null,
          "level": 1
        },
        {
          "text": "Maintains PITR window by tailing the oplog",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#backup-daemon",
          "note": null,
          "level": 1
        },
        {
          "text": "Place the Backup Daemon close to the data (low latency to both source MongoDB and snapshot store).",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#backup-daemon",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "Immutable S3 Snapshots (Object Lock)",
      "facts": [
        {
          "text": "Enable S3 Object Lock on the S3 bucket to prevent snapshot deletion:",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#immutable-s3-snapshots-object-lock",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "Air-Gap Deployments (Local Mode)",
      "facts": [
        {
          "text": "In air-gapped environments, Ops Manager must serve MongoDB binaries from a local mirror:",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#air-gap-deployments-local-mode",
          "note": null,
          "level": 0
        },
        {
          "text": "Download MongoDB Community/Enterprise binaries and place in the local versions directory for Agent to use.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-ops-manager/#air-gap-deployments-local-mode",
          "note": null,
          "level": 0
        }
      ]
    },
