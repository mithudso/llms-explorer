    },
    {
      "id": "clm:c5c2a5749470304f2210cf450e47c8e21b4ecfb620c8f413e4e65f0e6cc0bfde",
      "text": "Billing dashboards provide prebuilt Atlas spending charts and can be customized after billing-data ingestion. (high confidence)",
      "source_url": "https://www.mongodb.com/docs/charts/dashboards/manage-dashboards/billing-dashboards/",
      "also": [
        "https://www.mongodb.com/docs/atlas/architecture/current/billing-data.md",
