<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.global-ai-hub.facts-db</string>
  <!-- Daily 04:00 local: rebuild the derived claim-level index (facts.db) from every llms-facts file and reference skill. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/mitch/.global-ai-hub/scripts/facts_db.py</string>
    <string>build</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/mitch</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/mitch/.global-ai-hub/logs/facts-db.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/mitch/.global-ai-hub/logs/facts-db.log</string>
</dict>
</plist>
