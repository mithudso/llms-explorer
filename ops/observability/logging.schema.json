{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops.llmsx.org/contracts/logging-1.0.0.json",
  "title": "Fleet structured log 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["timestamp", "severity", "project", "environment", "service_name", "service_version", "event"],
  "properties": {
    "timestamp": {"type": "number", "minimum": 0},
    "severity": {"enum": ["debug", "info", "warn", "error", "fatal"]},
    "project": {"enum": ["fleet", "llmsx", "llms-explorer", "oraclebot", "twss", "morelube", "skaas"]},
    "environment": {"enum": ["production", "staging", "development"]},
    "service_name": {"type": "string", "pattern": "^[a-z0-9_.-]{1,96}$"},
    "service_version": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,96}$"},
    "event": {"type": "string", "pattern": "^[a-z0-9_.-]{1,96}$"},
    "collector": {"type": "string", "pattern": "^[a-z0-9_.-]{1,96}$"},
    "outcome": {"enum": ["success", "failure", "retry", "cancelled"]},
    "duration_ms": {"type": "number", "minimum": 0},
    "error_type": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,96}$"},
    "error_code": {"type": "string", "pattern": "^[a-z0-9_.-]{1,96}$"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,96}$"},
    "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "span_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "http_route": {"type": "string", "maxLength": 128, "pattern": "^/[A-Za-z0-9_{}./:-]*$"},
    "http_method": {"enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]},
    "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
    "job": {"type": "string", "pattern": "^[a-z0-9_.-]{1,96}$"},
    "retry_count": {"type": "integer", "minimum": 0}
  }
}
