          "level": 0
        }
      ]
    },
    {
      "title": "2. Shard Key Design and Zone Sharding",
      "facts": [
        {
          "text": "Always compound shard key with tenantId prefix: { tenantId: 1, _id: 1 }",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#2-shard-key-design-and-zone-sharding",
          "note": null,
          "level": 0
        },
        {
          "text": "Zone sharding (MongoDB 6.0+):",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#2-shard-key-design-and-zone-sharding",
          "note": null,
          "level": 0
        },
        {
          "text": "Atlas Global Clusters = managed zone sharding; shard key { location: 1, _id: 1 }.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#2-shard-key-design-and-zone-sharding",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "3. RBAC and Connection Security",
      "facts": [
        {
          "text": "Model C: one DB user per tenant scoped to their database only",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#3-rbac-and-connection-security",
          "note": null,
          "level": 0
        },
        {
          "text": "Collection-level RBAC alone does NOT prevent cross-tenant document reads - must combine with app-layer filter injection",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#3-rbac-and-connection-security",
          "note": null,
          "level": 0
        },
        {
          "text": "CSFLE: per-tenant DEK, one MongoClient per tenant, autoEncryption.schemaMap",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#3-rbac-and-connection-security",
          "note": null,
          "level": 0
        },
        {
          "text": "QE: shared client possible, autoEncryption.encryptedFieldsMap, supports range queries",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#3-rbac-and-connection-security",
          "note": null,
          "level": 0
        },
        {
          "text": "Atlas Cedar Resource Policies (2025): org-wide enforcement of MFA, public access blocks, project-scoped tenant API keys",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#3-rbac-and-connection-security",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "4. Connection Pooling",
      "facts": [
        {
          "text": "Shared pool (Model A): single MongoClient, maxPoolSize 100, all queries include tenantId",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#4-connection-pooling",
          "note": null,
          "level": 0
        },
        {
          "text": "Per-tenant LRU pool (CSFLE): lru-cache with max:100, dispose closes evicted clients; maxPoolSize:5 per tenant; rule: LRU max × poolSize < cluster connection limit",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#4-connection-pooling",
          "note": null,
          "level": 0
        },
        {
          "text": "Lambda/serverless: cache client in module scope outside handler; maxPoolSize:5, minPoolSize:0, maxIdleTimeMS:15000-30000; never call close() inside handler",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#4-connection-pooling",
          "note": null,
          "level": 0
        },
        {
          "text": "Atlas Serverless: no pool config needed; scales to zero",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#4-connection-pooling",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "5. Schema Design",
      "facts": [
        {
          "text": "tenantId in every document, every collection",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#5-schema-design",
          "note": null,
          "level": 0
        },
        {
          "text": "All compound indexes: tenantId as leading field",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#5-schema-design",
          "note": null,
          "level": 0
        },
        {
          "text": "Partial indexes for sparse tenant data",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#5-schema-design",
          "note": null,
          "level": 0
        },
        {
          "text": "Model C: $jsonSchema collection validators per tenant DB",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#5-schema-design",
          "note": null,
          "level": 0
        },
        {
          "text": "Model A: app-layer validation (Zod/Joi/Mongoose)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#5-schema-design",
          "note": null,
          "level": 0
        },
        {
          "text": "Repository pattern: structurally prepend tenantId to all find/aggregate/update/delete calls",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#5-schema-design",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "6. Atlas Projects as Hard Isolation",
      "facts": [
        {
          "text": "Per-project isolation: DB users, network access lists, PrivateLink, API keys, alerts, backup, BYOK encryption.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#6-atlas-projects-as-hard-isolation",
          "note": null,
          "level": 0
        },
        {
          "text": "Provision via Atlas Admin API v2 or Terraform mongodbatlas_project + mongodbatlas_cluster.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#6-atlas-projects-as-hard-isolation",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "7. Billing and Cost Chargeback",
      "facts": [
        {
          "text": "Projects = cost allocation units; tags (tenant, tier, cost-center) appear in invoice line items API",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#7-billing-and-cost-chargeback",
          "note": null,
          "level": 0
        },
        {
          "text": "Shared clusters: instrument app-layer usage metrics; aggregate monthly",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#7-billing-and-cost-chargeback",
          "note": null,
          "level": 0
        },
        {
          "text": "ADF for cross-tenant analytics: named virtual database (NOT $external); dedicated federated connection string",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#7-billing-and-cost-chargeback",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "8. Tenant Lifecycle",
      "facts": [
        {
          "text": "Onboarding Model A: meta-store insert → create indexes → seed config → activate",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#8-tenant-lifecycle",
          "note": null,
          "level": 0
        },
        {
          "text": "Onboarding Model D: Atlas Admin API pseudocode: create project → cluster → wait IDLE → DB user → network access → store connection string",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#8-tenant-lifecycle",
          "note": null,
          "level": 0
        },
        {
          "text": "Offboarding: soft-delete → export/archive → batched delete (find _ids → deleteMany by _id, no limit option on deleteMany) → remove from meta-store",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#8-tenant-lifecycle",
          "note": null,
          "level": 0
        },
        {
          "text": "Backup schedule: /backup/schedule endpoint; separate /backupCompliancePolicy for governance floors",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#8-tenant-lifecycle",
          "note": null,
          "level": 0
        },
        {
          "text": "Migration: moveCollection = intra-cluster only; cross-cluster = mongosync or Atlas Live Migrate",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#8-tenant-lifecycle",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "9. Row-Level Security Patterns",
      "facts": [
        {
          "text": "Query filter injection (recommended): TenantScopedCollection middleware automatically appends tenantId to all operations",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#9-row-level-security-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "MongoDB views: read-only pre-filtered view per tenant; grant role on view not base collection",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#9-row-level-security-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Atlas App Services rules: %%user.custom_data.tenantId - requires populating custom user data on provisioning; strongest guarantee (enforced before query runs)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#9-row-level-security-patterns",
          "note": null,
          "level": 0
        }
      ]
    },
