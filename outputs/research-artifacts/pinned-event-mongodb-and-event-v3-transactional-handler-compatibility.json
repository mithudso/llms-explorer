        "ev:65c035fd279761415c472dbebaa3cadc4a1edebdbe8a777125429aed51cc66f9",
        "ev:734610461a7663c8d11d3b4db80cef1c803d63006f7b5fb80dfdd0a0738f9a7a"
      ],
      "temporal": {
        "applicability_version": "event-mongodb@ca444aedec31e7e959c0932a8f7577c15312f37e; declared github.com/rbaliyan/event/v3 v3.18.1; event@b112463682d44b0e57d8545e3cdf5d51e112e914",
        "recorded_at": "2026-11-02T15:09:47.664124+00:00"
      }
    },
    {
      "id": "clm:b0647ac957de329e660c8f4e814b297d094accbf47cbd305b6c159d4cc632304",
      "text": "The MongoDB idempotency package describes Tx variants as context-based transactional intent. Its displayed Tx methods forward their supplied context to the same helpers as the ordinary methods. This documented intent does not add the transaction-object parameter required by the upstream TransactionalStore signatures. (medium confidence)",
      "source_url": "https://raw.githubusercontent.com/rbaliyan/event-mongodb/ca444aedec31e7e959c0932a8f7577c15312f37e/idempotency/doc.go",
