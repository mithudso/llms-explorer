---
// AccountNav — the nav shared by the four account routes, and the one place the
// API origin is decided.
//
// The site is static and the API is a different origin, so every account page
// needs the same base URL. Reading `PUBLIC_API_URL` here — once, at build time —
// and publishing it as `data-api` keeps the default in one file: the islands on
// /login/, /account/, /keys/ and /usage/ read the attribute and never name a
// host of their own. Nothing here calls the API; a nav that knew whether you
// were signed in would be user data in a statically built page.
const API_DEFAULT = "https://api.llms-explorer.com";
const api = String(import.meta.env.PUBLIC_API_URL || API_DEFAULT).replace(/\/+$/, "");
const { route } = Astro.props;
const LINKS = [
  ["/account/", "Account"],
  ["/keys/", "API keys"],
  ["/usage/", "Usage"],
  ["/login/", "Sign in"],
];
---
<nav class="account-nav" aria-label="Account" data-api={api}>
  {LINKS.map(([href, label], i) => (
    <>
      {i > 0 && " · "}
      <a href={href} aria-current={href === route ? "page" : null}>{label}</a>
    </>
  ))}
</nav>

<style>
  .account-nav { font-size: .9em; margin: 0 0 1.5rem; padding-bottom: .4rem; border-bottom: 1px solid currentColor; }
  .account-nav [aria-current="page"] { font-weight: 600; }
</style>
