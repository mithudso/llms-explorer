#!/bin/sh
# ollama-egpu: Launch and route Ollama to the NVIDIA RTX 5080 eGPU on Apple Silicon.
set -eu

check_link() {
  if ! ioreg -r -c IOPCIDevice -l | grep -q "<022c0000>"; then
    echo "⚠️  RTX 5080 not detected in IOKit registry." >&2
    echo "   Thunderbolt link dropped. Re-seat the Thunderbolt 5 cable." >&2
    return 1
  fi
  return 0
}

PORT="${OLLAMA_PROXY_PORT:-11440}"
TINY_PORT="${TINY_PORT:-8000}"
DEFAULT_BLOB="$HOME/.ollama/models/blobs/sha256-de0334402b975e19dd48eb43a13f7534772fb5b4a054447f8f6a861b87ec5799"
MODEL="${1:-$DEFAULT_BLOB}"

echo "=== Ollama eGPU (RTX 5080) Service Manager ==="

if ! check_link; then
  exit 1
fi

# Ensure tinygrad.llm is running
if ! curl -s -m 2 "http://127.0.0.1:${TINY_PORT}/v1/models" >/dev/null; then
  echo "Starting tinygrad.llm server on RTX 5080 (port ${TINY_PORT})..."
  export DEV=NV
  export PYTHONPATH="$HOME/tinygrad${PYTHONPATH:+:$PYTHONPATH}"
  export PATH="$HOME/.local/bin:$HOME/.venvs/tinygpu/bin:$PATH"
  
  # Launch tinygrad.llm in background
  nohup "$HOME/.venvs/tinygpu/bin/python3" -m tinygrad.llm --model "$MODEL" --max_context 4096 --serve "$TINY_PORT" > /tmp/tinygrad_llm.log 2>&1 &
  echo "Waiting for RTX 5080 GSP boot and model loading..."
  for i in $(seq 1 120); do
    if curl -s -m 1 "http://127.0.0.1:${TINY_PORT}/v1/models" >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done
fi

# Ensure proxy is running
if ! curl -s -m 2 "http://127.0.0.1:${PORT}/api/version" >/dev/null; then
  echo "Starting Ollama eGPU proxy bridge on port ${PORT}..."
  export TINYGRAD_LLM_URL="http://127.0.0.1:${TINY_PORT}"
  export OLLAMA_PROXY_PORT="${PORT}"
  nohup python3 "$HOME/.local/bin/ollama-egpu-proxy.py" > /tmp/ollama_proxy.log 2>&1 &
  sleep 1
fi

echo "✅ Ollama eGPU ready!"
echo "   Endpoint: http://127.0.0.1:${PORT}"
echo "   To route standard ollama CLI commands to eGPU:"
echo "     export OLLAMA_HOST=http://127.0.0.1:${PORT}"
echo "     ollama list"
