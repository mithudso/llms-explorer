# Commit only per-cell result.json, the claims file and gate.json. Transcripts, source caches
# and run state are large and hold absolute local paths.
cells/**
!cells/*/
!cells/*/result.json
!cells/*/hub/
!cells/*/hub/research/
!cells/*/hub/research/bench/
!cells/*/hub/research/bench/claims/
!cells/*/hub/research/bench/claims/*.json
!cells/*/hub/research/bench/gate.json
results.jsonl
# Pipeline lane: the discovered source list and the per-claim validation verdicts. Library
# snapshots and extracted quotes stay under the cell's private hub (never committed).
!cells/*/pipeline/
!cells/*/pipeline/discovery.json
!cells/*/pipeline/validate.json
