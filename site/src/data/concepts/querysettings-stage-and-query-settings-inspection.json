    {
      "title": "How it works",
      "facts": [
        {
          "text": "Inspect explain output to verify settings attached to a particular query. MongoDB source appends nonempty querySettings to queryPlanner and sets indexFilterSet to false when those settings are present. (high confidence)",
          "source": "https://www.mongodb.com/docs/manual/reference/command/setquerysettings/",
          "note": null,
          "claimId": "clm:ac5a79431dbde6c919fd4acab2b0e0c956c9bdfd2684af9a9645faa6372a577b",
          "validationStatus": "SUPPORTED",
