            "https://docs.atlan.com/apps/connectors/database/mongodb/how-tos/set-up-mongodb",
            "https://www.mongodb.com/docs/atlas/security-add-mongodb-users.md"
          ],
          "originValidationStatus": "SUPPORTED",
          "originEvidenceIds": [
            "ev:98785064cf32d2c8f3569f99ca6b09571bc06621eff5531cd667ef8a1c1efdce",
            "ev:be7ba896d10dbfe4f9447d99f44404e24664051d540958d0cf7d14ccde8db3aa"
          ],
          "remediation": {
