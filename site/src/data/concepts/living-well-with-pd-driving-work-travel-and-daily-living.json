  "facets": [
    {
      "title": "How it works",
      "facts": [
        {
          "text": "The Parkinson’s Foundation advises avoiding driving when fatigued, when medication is wearing off, or when starting a new medicine. (low confidence)",
          "source": "https://www.parkinson.org/living-with-parkinsons/management/activities-daily-living/driving",
          "note": null,
          "claimId": "clm:5e47b7f4611ae1e9d5aa02eb2d12e866c92e370a856c37708664801ee9575021",
