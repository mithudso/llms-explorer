  "narrative": [
    {
      "assertionId": "prose:ac4e901aab69e34b30c00ed2c79c4f55b007b73ac79c5848e10304f42402a9e1",
      "statementSha256": "ac4e901aab69e34b30c00ed2c79c4f55b007b73ac79c5848e10304f42402a9e1",
      "assertionKind": "summary",
      "index": 0,
      "documentSlug": "imaging-biomarkers-datscan-mri-and-pet",
      "documentConcept": "Imaging biomarkers: DaTscan, MRI and PET",
      "canonicalConceptId": "concept:53e8279c52a5fadc6f6e889dcdb651bc23d1d565ce35baf50682dc629e7c26f7",
      "text": "Imaging contributes complementary evidence rather than a single disease-specific answer. Dopamine-transporter SPECT identifies presynaptic dysfunction but does not reliably separate PD from atypical degenerative parkinsonism. Structural MRI helps assess alternative causes; nigrosome and neuromelanin MRI offer promising research measures whose diagnostic performance depends on population, acquisition and validation. FDG-PET examines cerebral metabolic patterns, whereas fluorodopa PET assesses presynaptic dopaminergic function. Small MRI case-control studies should not be equated with routine clinical accuracy. Drug interference, structural lesions, non-diagnostic scans and clinical rather than pathological reference standards constrain interpretation. Selected older-onset cases with initially normal DAT-SPECT further caution against absolute exclusion claims. The FDA label positions DaTscan as an adjunct to other diagnostic evaluations, and NICE NG71 recommends considering it when essential tremor cannot be clinically differentiated from parkinsonism.",
