    {
      "id": "clm:e28c55023cdd7f99b5576ca9e4faac26bffe4020ab46abd0a541a88afd996011",
      "text": "Percona\u2019s published catalog examples differ: the reference shorthand uses provider and a top-level providerEndpoint, while its settings table names config.providerEndpoint; the setup guide uses embeddingProvider and nests providerEndpoint under config. This records documentation positions without establishing which schema a binary accepts. (high confidence) (verified as of 2026-10-29)",
      "source_url": "https://raw.githubusercontent.com/percona/percona-search-for-mongodb-docs/main/docs/automatic-embedding-configuration-reference.md",
      "also": [
        "https://raw.githubusercontent.com/percona/percona-search-for-mongodb-docs/main/docs/configure-automatic-embedding.md"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:2211bb7cb93387df1701e75b55427b092b4ba3dd3fc893e7969855b2ec8fdb76",
