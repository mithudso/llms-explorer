            "claim_text_sha256": "1ffca826298b83c90b36a1c5e3d0e0bf63e70517a763fcddac1acb4a5afe6a39"
          }
        },
        {
          "text": "Cloud HSM documentation limits user-provided plaintext/ciphertext plus additional authenticated data to 8 KiB, versus 64 KiB for software keys. This API message limit should not be interpreted as an Atlas document-size limit. (low confidence) (verified as of 2026-10-22)",
          "source": "https://cloud.google.com/kms/docs/hsm",
          "note": null,
          "claimId": "clm:b853bcb27a69053ba77cad73eef7b6f68d5269d93dd1ce8584605f183015afea",
          "validationStatus": "SUPPORTED",
