    {
      "id": "clm:90682c6442fe4fc1683355db7f84885ba4e770efce0c03036248e47a5b634181",
      "text": "The recipient fetches from the donor primary with the no-retry command policy. It rejects a response whose oplog field is not an array. Each incoming oplog entry must parse successfully, contain a session identifier and transaction number, and have a nonempty statement-identifier list. (low confidence)",
      "source_url": "https://raw.githubusercontent.com/mongodb/mongo/dacdbc3df2fbe579b03336a2f01fc9aedf406a41/src/mongo/db/s/session_catalog_migration_destination.cpp",
