{"id": "clm:76cc358d23edda4d3853fd46758d123067ec459cad3322686c091a51a8dd1421", "type": "statement", "text": "A June–July 2025 community thread reports 'Usage data unavailable' in Compass. A respondent recommends checking privileges for $indexStats; the thread does not demonstrate a confirmed fix for the original reporter. (low confidence)", "source_url": "https://www.mongodb.com/community/forums/t/index-usage-data-unavailable-in-compass/323476", "anchor": "", "page_class": "reference", "keywords": ["Compass Index Management"], "code": null, "origin": "dr", "section": "facts", "relation": "about", "score": 1.0, "also": [], "semantic_score": null, "pass": "keyword", "canonical_concept_id": "concept:dc28efbb5d9f5d80e90213a1a5faac1665ecca9938e59cbd7d19cfafa8964a37", "validation_status": "SUPPORTED", "evidence_ids": ["ev:025430021bddcdb31a772febf99f37747a8da5761bf0a0408ecf3c211e423f06"]}
