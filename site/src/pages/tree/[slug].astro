---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { packBySlug as downloadablePacks } from "../../data/context-downloads";
import { RESEARCH_TASKS } from "../../data/research";
import { tree, type TreeNode } from "../../data/tree";
import type { ConceptPack, PackFact } from "../../data/types";
import { isPublishedArticle } from "../../data/publication";

// `/tree/3d/` is Task 3. Link it only once that page exists, so the node pages
// never point at a route the build does not produce (test_internal_links_resolve).
const has3d = Object.keys(import.meta.glob("./3d.astro")).length > 0;

// The researched content (facets of source-cited facts) used to live on a
// separate /tree/<slug>/read/ page, one click past this one. Loaded here
// instead — same glob idiom `has3d` uses to check a sibling page exists,
// applied to enumerate data files — so a node's own page is the whole
// answer: no second page to find just to read what was researched.
const packs = import.meta.glob<{ default: ConceptPack }>("../../data/concepts/*.json", { eager: true });
const packBySlug = new Map<string, ConceptPack>(
  Object.entries(packs).map(([path, mod]) => [
    (path.split("/").pop() ?? "").replace(/\.json$/, ""),
    mod.default,
  ])
);

// Astro resolves a static route before a dynamic one, so a node slugging to `3d`
// would be silently served the 3D viewer instead of its own page, and two concepts
// slugging alike would silently share one URL. Fail the build instead: a concept
// with no page of its own is worse than a red build.
export async function getStaticPaths() {
  // Declared inside: Astro evaluates getStaticPaths in its own module scope, so a
  // frontmatter const is not in scope here.
  const RESERVED = new Set(["3d", "index"]);
  const seen = new Map<string, string>();
  return Object.values(tree.nodes).map((n) => {
    if (RESERVED.has(n.slug)) {
      throw new Error(
        `concept "${n.concept}" slugs to the reserved route /tree/${n.slug}/ — rename it or ` +
        "the static page at that route will shadow its node page");
    }
    if (seen.has(n.slug)) {
      throw new Error(
        `two concepts slug alike: "${seen.get(n.slug)}" and "${n.concept}" both want /tree/${n.slug}/`);
    }
    seen.set(n.slug, n.concept);
    return { params: { slug: n.slug }, props: { node: n } };
  });
}
interface Props {
  node: TreeNode;
}
const { node } = Astro.props;
const pack = packBySlug.get(node.slug);
// This checks content availability, not editorial review or factual accuracy.
// Tree metadata can outlive a pack, so hasPack/state alone cannot establish
// that a visitor will find a reference at this route.
const hasPublishedReference = Boolean(pack?.summary?.trim() &&
  pack.facets?.some((facet) => facet.facts?.some((fact) =>
    fact.text?.trim() && fact.source?.trim())));
const frontier = tree.frontier.filter((f) => f.parent_slug === node.slug);
// Concept Viability Score: concept-family-explorer's 0-5 pre-research gate. Shown so a reader can
// see how useful a topic was judged before it was researched; the auto-researchers skip below 3.2.
const CVS_GATE = 3.2;
const cvsLabel = (v: number) => `${v.toFixed(2)} / 5`;
const frontierCvs = (concept: string): string => {
  const f = tree.frontier.find((x) => x.concept === concept);
  return f?.cvs !== undefined ? `, viability ${cvsLabel(f.cvs)}${f.cvs < CVS_GATE ? ", below research gate" : ""}` : "";
};

// A related concept in a pack names its target by concept text, not slug —
// resolved against the live tree so the link always lands on a real page.
function relatedHref(concept: string): string | null {
  const match = Object.values(tree.nodes).find(
    (n) => n.concept.toLowerCase() === concept.toLowerCase()
  );
  return match ? `/tree/${match.slug}/` : null;
}

const esc = (s: unknown) =>
  String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

// The research pipeline writes a confidence label into the fact text itself,
// either as a leading "[low]" or as "(low confidence)". Lift it out into a badge
// so the claim reads as a sentence, and lift a trailing "Sources: url ; url"
// list into the citation links it duplicates.
const CONFIDENCE = /^\s*\[(low|medium|high)\]\s*|\s*\((low|medium|high) confidence\)/i;
const TRAILING_SOURCES = /\s*Sources?:\s*((?:https?:\/\/\S+?\s*;?\s*)+)$/;
function splitFact(text: string): { text: string; confidence: string | null; urls: string[] } {
  let confidence: string | null = null;
  let body = text.replace(CONFIDENCE, (_, a, b) => { confidence = (a || b).toLowerCase(); return " "; });
  const urls: string[] = [];
  body = body.replace(TRAILING_SOURCES, (_, list: string) => {
    urls.push(...list.split(/[\s;]+/).map((u) => u.replace(/[.,)]+$/, "")).filter((u) => /^https?:\/\//.test(u)));
    return "";
  });
  return { text: body.replace(/\s{2,}/g, " ").trim(), confidence, urls };
}

// Only real web addresses become links. Older packs cite the archived
// /sources/ reports this site no longer hosts, and many cite a research note on
// the build machine (`~/.global-ai-hub/...`): linking either would publish a
// broken link and a private path, so both render as a plain note.
const isWebSource = (source: string) =>
  /^https?:\/\//.test(source) && !/^https?:\/\/(?:llms-explorer\.com|llmsx\.org)\/sources\//.test(source);

// A facet's facts are a flat array; each carries the nesting `level`
// build_concept_packs.py derived from the source markdown's own list
// indentation (0 = a facet's top-level point, 1+ = a sub-point under the
// item before it — e.g. "Lazarus split appraisal into two steps:" at 0
// with the two steps themselves at 1). Walked here into real nested
// <ul><li> HTML so a sub-point renders indented under the point that
// introduces it, not as a same-level sibling. Packs from the other
// generator (gen_concepts.py, the 15 hand-run llms-concept-abstractor
// ones) carry no `level` field at all — `|| 0` treats every one of
// their facts as top-level, so they render as one flat list, same as
// they always have.
function renderFacts(facts: PackFact[]): string {
  const factHtml = (fact: PackFact) => {
    const { text, confidence, urls } = splitFact(fact.text);
    const sources = [...new Set([fact.source, ...(fact.also ?? []), ...urls]
      .filter((source) => typeof source === "string")
      .map((source) => source.trim())
      .filter(Boolean))];
    const web = sources.filter(isWebSource);
    const links = web.map((source, index) =>
      `<a href="${esc(source)}" class="fact-source" rel="noopener">${web.length > 1 ? `[source ${index + 1}]` : "[source]"}</a>`);
    if (web.length < sources.length) links.push(`<span class="fact-source fact-note">[unpublished research note]</span>`);
    const badge = confidence ? `<span class="conf" data-confidence="${confidence}">${confidence}</span> ` : "";
    return `${badge}${esc(text)} ${links.join(" ")}` + (fact.note ? ` <em>— ${esc(fact.note)}</em>` : "");
  };
  let html = "<ul>";
  let level = 0;
  facts.forEach((fact, i) => {
    const l = fact.level || 0;
    if (i === 0) {
      // first item opens the outer <li> below; nothing to close yet
    } else if (l > level) {
      html += "<ul>".repeat(l - level);
    } else if (l < level) {
      html += "</li>" + "</ul></li>".repeat(level - l);
    } else {
      html += "</li>";
    }
    html += `<li>${factHtml(fact)}`;
    level = l;
  });
  if (facts.length > 0) html += "</li>" + "</ul></li>".repeat(level);
  html += "</ul>";
  return html;
}

const isDomain = node.state === "domain";

// Search indexes only the curated part of the tree (KNOW-1220): the topic
// groups, which carry an editorial summary, and the packs an editor picked for
// a task on /research/. Every other concept page stays published for readers
// and agents but carries noindex, so the sitemap leaves it out too. Widen the
// set by adding a pick to research-tasks.json, not by size.
const picks = RESEARCH_TASKS.filter((task) => task.references.includes(node.slug));
const indexable = isDomain || (hasPublishedReference && picks.length > 0);

// pack.summary is often generator boilerplate ("Run status: COMPLETED", router
// text, other languages; KNOW-968), so the page describes a pack from its own
// shape instead: how many facts, in which sections, citing which sites.
const facts = pack?.facets.flatMap((facet) => facet.facts) ?? [];
const hostCounts = new Map<string, number>();
for (const fact of facts) {
  for (const source of new Set([fact.source, ...(fact.also ?? []), ...splitFact(fact.text).urls])) {
    if (typeof source !== "string" || !isWebSource(source.trim())) continue;
    try {
      const host = new URL(source.trim()).hostname.replace(/^www\./, "");
      hostCounts.set(host, (hostCounts.get(host) ?? 0) + 1);
    } catch { /* not a URL after all */ }
  }
}
const topHosts = [...hostCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 4);
const unpublished = facts.filter((fact) => !isWebSource((fact.source ?? "").trim()) &&
  !(fact.also ?? []).some((s) => isWebSource(s.trim())) && splitFact(fact.text).urls.length === 0).length;
const facetId = (i: number) => `facet-${i + 1}`;
const facetList = pack?.facets.map((facet) => facet.title.toLowerCase()).slice(0, 4).join(", ") ?? "";
const plural = (n: number, word: string) => `${n.toLocaleString()} ${word}${n === 1 ? "" : "s"}`;

const skillPages = new Set((await getCollection("skills")).map((entry) => entry.id));
const skillPage = node.skillId && skillPages.has(node.skillId) ? `/skills/${node.skillId}/` : null;
// Editorial papers can explain a topic group without inventing a researched
// concept pack for it. Resolve every read against actual published content.
const readCollections = {
  blog: new Map((await getCollection("blog")).filter((entry) => isPublishedArticle(entry)).map((entry) => [entry.id, entry.data])),
  examples: new Map((await getCollection("examples")).map((entry) => [entry.id, entry.data])),
};
const relatedReads = [...new Map(RESEARCH_TASKS
  .filter((task) => task.family === node.slug || task.references.includes(node.slug))
  .flatMap((task) => task.reads.flatMap((read) => {
    const data = readCollections[read.collection].get(read.id);
    return data ? [[`${read.collection}/${read.id}`, { ...read, title: data.title }] as const] : [];
  }))).values()];

const description = hasPublishedReference && pack
  ? `${plural(facts.length, "fact")} on ${node.concept}, in sections: ${facetList}.`.slice(0, 180)
  : isDomain && node.summary
  ? node.summary.slice(0, 180)
  : `Topic entry for ${node.concept}. A published reference is not available for this topic yet.`;
---
<Base title={node.concept} description={description} route={`/tree/${node.slug}/`} twin={null} noindex={!indexable} adEligible={indexable && hasPublishedReference}>
  <p>
    {node.parent_slug && <>Parent: <a href={`/tree/${node.parent_slug}/`}>{node.parent}</a> · </>}
    <strong class="state" data-state={hasPublishedReference ? "reference" : isDomain ? "domain" : "topic"}>
      {hasPublishedReference ? "Published reference" : isDomain ? "Topic group" : "Topic entry"}
    </strong>
    {hasPublishedReference
      ? <> · snapshot {pack?.generated || node.researchedAt}</>
      : node.children.length > 0 && <> · {node.children.length} {node.children.length === 1 ? "branch" : "branches"}</>}
    {skillPage && <> · <a href={skillPage}>agent skill</a></>}
    {node.cvs !== undefined && (
      <> · <span class="cvs" data-cvs={node.cvs} title="Concept Viability Score: relevance, usefulness, novelty, interest and researchability, weighted 0-5. Topics below 3.2 are not researched automatically.">
        viability {cvsLabel(node.cvs)}{node.cvsDecision ? ` (${node.cvsDecision.toLowerCase()})` : ""}
      </span></>
    )}
  </p>
  {!hasPublishedReference && (
    <>
      {isDomain && node.summary
        ? <p class="lede">{node.summary} Choose a branch below to read its references.</p>
        : <p>A published reference is not available for this topic yet.</p>}
      {!isDomain && node.summary && <p>{node.summary}</p>}
    </>
  )}
  {node.aliases.length > 0 && <p>Also known as: {node.aliases.join(", ")}</p>}
  {hasPublishedReference && (
    <p class="downloads">
      {pack && (
        <a href={`/downloads/concepts/${node.slug}.md`} download class="download-ref">
          ↓ Facts as markdown
        </a>
      )}
      {downloadablePacks.has(node.slug) && <a href={`/downloads/context-packs/${node.slug}.llms.zip`} download class="download-ref">↓ Portable .llms pack</a>}
      <a href="/context/" class="download-note">agent context libraries</a>
    </p>
  )}

  {hasPublishedReference && pack && (
    <>
      <section class="pack-about" aria-label="About this context pack">
        {picks.map((task) => (
          <p class="pack-pick">
            <span class="content-kind">Editor's pick</span>{" "}
            For the task <a href={`/research/#task-${task.id}`}>{task.title}</a>: {task.summary}
          </p>
        ))}
        <p>
          {plural(facts.length, "fact")} in {plural(pack.facets.length, "section")}
          {topHosts.length > 0 && <>, citing {topHosts.map(([host]) => host).join(", ")}{hostCounts.size > topHosts.length && ` and ${plural(hostCounts.size - topHosts.length, "other site")}`}</>}.
          {unpublished > 0 && <> {plural(unpublished, "fact")} cite{unpublished === 1 ? "s" : ""} only an unpublished research note.</>}
          {" "}Confidence labels come from the research run. Check the linked source before relying on a claim; see the <a href="/editorial/">editorial standards</a>.
        </p>
        {pack.facets.length > 1 && (
          <nav aria-label="Sections in this pack">
            <ol class="pack-toc">{pack.facets.map((facet, i) => <li><a href={`#${facetId(i)}`}>{facet.title}</a> <span>({facet.facts.length})</span></li>)}</ol>
          </nav>
        )}
      </section>
      {(pack.narrative ?? []).map((assertion) => {
        const originalStatus = assertion.originValidationStatus ?? assertion.validationStatus;
        const proposed = originalStatus === "NO-FACTUAL-ASSERTION";
        return (
          <section class="pack-narrative" data-assertion-id={assertion.assertionId}>
            <h2>{proposed ? "Proposed guidance" : "Research summary"} — {assertion.documentConcept}</h2>
            <p class="narrative-text">{assertion.text}</p>
            {proposed && <p>Original conditional design guidance; contributes no factual evidence.</p>}
            <details>
              <summary>Summary provenance</summary>
              <p>Gate verdict: {assertion.validationStatus}. Auxiliary assertion: <code>{assertion.assertionId}</code>.</p>
              <p>Statement hash: <code>{assertion.statementSha256}</code>.</p>
              {assertion.evidenceIds.length > 0 && <p>Evidence IDs: {assertion.evidenceIds.join(", ")}.</p>}
            </details>
          </section>
        );
      })}
      {pack.facets.map((facet, i) => (
        <section>
          <h2 id={facetId(i)}>{facet.title}</h2>
          <Fragment set:html={renderFacts(facet.facts)} />
        </section>
      ))}
      {pack.related.length > 0 && (
        <section>
          <h2>Related concepts</h2>
          <ul>
            {pack.related.map((r) => {
              const href = relatedHref(r.concept);
              return (
                <li>
                  {href ? <a href={href}>{r.concept}</a> : r.concept}
                  {" "}— {r.relation}{r.note && <>; {r.note}</>}
                </li>
              );
            })}
          </ul>
        </section>
      )}
    </>
  )}

  {relatedReads.length > 0 && <section aria-labelledby="related-reading">
    <h2 id="related-reading">Implementation papers and related reading</h2>
    <p>These articles are separate from the source-linked reference packs.</p>
    <ul>{relatedReads.map((read) => <li><a href={`/${read.collection}/${read.id}/`}>{read.title}</a> — {read.kind}</li>)}</ul>
  </section>}

  <h2>Children</h2>
  <ul>
    {node.children.map((c) => (
      <li>
        {c.state !== "frontier"
          ? <a href={`/tree/${c.slug}/`}>{c.concept}</a>
          : <span class="frontier" title="frontier: named but not yet researched">{c.concept} <em>(frontier{frontierCvs(c.concept)})</em></span>}
      </li>
    ))}
    {node.children.length === 0 && <li><em>No children recorded.</em></li>}
  </ul>
  {frontier.length > 0 && <p><strong>Frontier under this node:</strong> {frontier.map((f) => f.cvs !== undefined ? `${f.concept} (${f.cvs.toFixed(2)})` : f.concept).join(", ")}</p>}
  <p>
    <a href="/tree/">← the whole tree</a>
    {has3d && <> · <a href="/tree/3d/">3D view</a></>}
    · <a href="/reference/concept-tree/">how to read this page</a>
  </p>
</Base>

<style>
  .pack-about { border-left: 3px solid var(--line); padding-left: var(--sp-3); }
  .narrative-text { white-space: pre-wrap; }
  .pack-toc { columns: 2 16rem; padding-left: 1.2em; }
  .pack-toc span { color: var(--ink-faint); font-size: var(--step--1); }
  .fact-source { font-size: var(--step--1); }
  .fact-note { color: var(--ink-faint); }
  .conf {
    display: inline-block;
    font-size: var(--step--1);
    line-height: 1.2;
    padding: 0 0.4em;
    border: 1px solid var(--line);
    border-radius: 0.3em;
    color: var(--ink-faint);
    text-transform: lowercase;
  }
  .conf[data-confidence="high"] { color: inherit; }
  .download-ref {
    display: inline-block;
    font-size: var(--step--1);
    padding: 0.3em 0.7em;
    border: 1px solid var(--line);
    border-radius: 0.4em;
    text-decoration: none;
  }
  .download-ref:hover { background: var(--code-bg); }
  .downloads { display: flex; gap: var(--sp-2); flex-wrap: wrap; align-items: center; }
  .download-note { font-size: var(--step--1); color: var(--ink-faint); }
</style>
