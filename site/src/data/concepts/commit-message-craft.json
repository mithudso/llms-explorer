      "title": "6. Multi-commit storytelling for PR reviewers",
      "facts": [
        {
          "text": "Prep commits first - refactors, renames, type-only changes with no behavior change.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/commit-message-craft/#6-multi-commit-storytelling-for-pr-reviewers",
          "note": null
        },
        {
          "text": "The substantive commit - the one that does the actual feature/fix.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/commit-message-craft/#6-multi-commit-storytelling-for-pr-reviewers",
          "note": null
        },
        {
