    {
      "title": "Common Anti-Patterns",
      "facts": [
        {
          "text": "Manual UI changes on AKO-managed resources: AKO will reconcile them away on next cycle",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-kubernetes-operator/#common-anti-patterns",
          "note": null
        },
        {
          "text": "Storing Atlas API keys in plain Kubernetes Secrets without encryption: Use SealedSecrets, External Secrets Operator, or Workload Identity",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-kubernetes-operator/#common-anti-patterns",
          "note": null
        },
        {
          "text": "Not scoping AKO to specific namespaces in multi-tenant clusters: AKO with cluster-wide watch can interfere with other applications' secrets",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-kubernetes-operator/#common-anti-patterns",
          "note": null
        },
        {
          "text": "Upgrading AKO without reading the changelog: Major AKO versions introduce CRD schema changes that require migration",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-kubernetes-operator/#common-anti-patterns",
          "note": null
        }
      ]
    },
