    {
      "title": "Facts and statements",
      "facts": [
        {
          "text": "CoalesceByDocumentKey delegates to WithCoalesceByMetadata with MetadataDocumentKey. The metadata constant is the literal \"document_key\" and denotes the string representation of the changed document’s _id. The adapter does not construct a namespace-qualified key. (medium confidence)",
          "source": "https://raw.githubusercontent.com/rbaliyan/event-mongodb/ca444aedec31e7e959c0932a8f7577c15312f37e/coalesce.go",
          "note": null,
          "claimId": "clm:30c31a4026ede5c31980593054ee65a872467d3e6e8401cdd0f4edd76a9a416a",
          "validationStatus": "SUPPORTED",
