    {
      "id": "clm:6291ecfd05d1ecf60accf84d9666239d68dcd3d7c89cb140a2d68fe19e69a4fc",
      "text": "from requires an Atlas connection. No matches produce an empty results array. (low confidence) (verified as of 2026-10-27)",
      "source_url": "https://www.mongodb.com/docs/atlas/atlas-stream-processing/sp-agg-vectorsearch/",
