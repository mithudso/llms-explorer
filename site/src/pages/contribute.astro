---
import Base from "../layouts/Base.astro";
import AccountNav from "../components/AccountNav.astro";

const title = "Contribute a subject";
const description = "Submit a new concept to the directory: a subject name, optional parent, and your text, run through a research pass and routed to moderators.";
---
<Base title={title} description={description} route="/contribute/">
  <AccountNav route="/contribute/" />
  <p>
    The directory is built by contributions like yours. Submit a concept name,
    an optional parent concept, and text (or upload a file) describing your
    subject. We'll run it through a research pass, and a moderator will review
    it before it lands in the tree.
  </p>

  <div class="island" id="contribute-form" data-island="contribute" hidden></div>

  <div data-signed-out id="contribute-signed-out">
    <p>
      Contributions belong to an account. <a href="/login/">Sign in</a> to submit
      a new subject to the directory.
    </p>
  </div>

  <noscript>
    <p>Submitting a contribution requires JavaScript to interact with the API.</p>
  </noscript>

  <script>
    const nav = document.querySelector(".account-nav");
    const api = nav ? nav.getAttribute("data-api") : "";
    const panel = document.getElementById("contribute-form");
    const out = document.getElementById("contribute-signed-out");

    const call = (path, init) =>
      fetch(api + path, { credentials: "include", headers: { accept: "application/json" }, ...init });

    function buildForm() {
      const form = document.createElement("form");
      form.className = "contribute-form";

      // Subject name
      const nameLabel = document.createElement("label");
      nameLabel.textContent = "Subject name";
      const nameInput = document.createElement("input");
      nameInput.type = "text";
      nameInput.name = "concept";
      nameInput.required = true;
      nameInput.placeholder = "e.g., Prompt injection defense";
      form.appendChild(nameLabel);
      form.appendChild(nameInput);

      // Parent concept
      const parentLabel = document.createElement("label");
      parentLabel.textContent = "Parent concept (optional)";
      const parentInput = document.createElement("input");
      parentInput.type = "text";
      parentInput.name = "parent";
      parentInput.placeholder = "e.g., RAG security";
      form.appendChild(parentLabel);
      form.appendChild(parentInput);

      // Text area
      const textLabel = document.createElement("label");
      textLabel.textContent = "Content";
      const textArea = document.createElement("textarea");
      textArea.name = "text";
      textArea.required = true;
      textArea.placeholder = "Describe the subject...";
      textArea.rows = 8;
      form.appendChild(textLabel);
      form.appendChild(textArea);

      // File input
      const fileLabel = document.createElement("label");
      fileLabel.textContent = "Or upload a file";
      const fileInput = document.createElement("input");
      fileInput.type = "file";
      fileInput.accept = "text/plain,.md,.txt";
      fileInput.addEventListener("change", (e) => {
        const file = e.target.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (ev) => {
          textArea.value = String(ev.target?.result || "");
        };
        reader.readAsText(file);
      });
      form.appendChild(fileLabel);
      form.appendChild(fileInput);

      // Submit button
      const submitBtn = document.createElement("button");
      submitBtn.type = "submit";
      submitBtn.textContent = "Submit";
      form.appendChild(submitBtn);

      // Handle form submission
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        submitBtn.disabled = true;
        submitBtn.textContent = "Submitting...";

        const conceptValue = nameInput.value.trim();
        const textValue = textArea.value.trim();
        const parentValue = parentInput.value.trim() || null;

        if (!conceptValue || !textValue) {
          alert("Subject name and content are required.");
          submitBtn.disabled = false;
          submitBtn.textContent = "Submit";
          return;
        }

        try {
          const r = await call("/api/contribute", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              concept: conceptValue,
              text: textValue,
              parent: parentValue,
            }),
          });

          const data = await r.json();

          if (r.ok) {
            // Success: show output and proposal status
            const result = document.createElement("div");
            result.className = "success-result";
            result.innerHTML = `
              <h3>Submitted successfully</h3>
              <p><strong>Status:</strong> ${data.status || "pending"}</p>
              <p><strong>Generated content:</strong></p>
              <pre>${escapeHtml(data.pass_output || "")}</pre>
              ${data.lint_findings ? `<p><strong>Lint findings:</strong> ${escapeHtml(data.lint_findings)}</p>` : ""}
            `;
            panel.replaceChildren(result);
          } else if (r.status === 201) {
            // Lint rejection: still a submission, just rejected
            const rejected = document.createElement("div");
            rejected.className = "rejected-result";
            rejected.innerHTML = `
              <h3>Submission reviewed — improvements needed</h3>
              <p><strong>Status:</strong> ${data.status || "rejected"}</p>
              <p><strong>Findings:</strong></p>
              <pre>${escapeHtml(data.findings || JSON.stringify(data))}</pre>
            `;
            panel.replaceChildren(rejected);
          } else {
            // Error
            const error = document.createElement("div");
            error.className = "error-result";
            error.innerHTML = `
              <h3>Error</h3>
              <p>${escapeHtml(data.detail || data.message || "An error occurred.")}</p>
            `;
            panel.replaceChildren(error);
            submitBtn.disabled = false;
            submitBtn.textContent = "Submit";
          }
        } catch (err) {
          const error = document.createElement("div");
          error.className = "error-result";
          error.innerHTML = `<h3>Error</h3><p>${escapeHtml(String(err))}</p>`;
          panel.replaceChildren(error);
          submitBtn.disabled = false;
          submitBtn.textContent = "Submit";
        }
      });

      return form;
    }

    function escapeHtml(text) {
      const div = document.createElement("div");
      div.textContent = text;
      return div.innerHTML;
    }

    function load() {
      const form = buildForm();
      panel.replaceChildren(form);
      panel.hidden = false;
      out.hidden = true;
    }

    // Check if signed in by trying to fetch user info
    (async () => {
      try {
        const r = await call("/api/account");
        if (r.ok) load();
      } catch {
        /* signed out: the static fallback already says so */
      }
    })();
  </script>
</Base>

<style>
  .contribute-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 40rem;
  }
  .contribute-form label {
    font-weight: 600;
    margin-top: 0.5rem;
  }
  .contribute-form input[type="text"],
  .contribute-form textarea,
  .contribute-form input[type="file"] {
    padding: 0.5rem;
    border: 1px solid #ccc;
    border-radius: 4px;
    font: inherit;
  }
  .contribute-form textarea {
    font-family: monospace;
  }
  .contribute-form button {
    align-self: flex-start;
    padding: 0.5rem 1rem;
    background: #0066cc;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
  }
  .contribute-form button:hover:not(:disabled) {
    background: #0052a3;
  }
  .contribute-form button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .success-result,
  .rejected-result,
  .error-result {
    margin: 1rem 0;
    padding: 1rem;
    border-radius: 4px;
  }
  .success-result {
    background: #e8f5e9;
    border: 1px solid #4caf50;
    color: #1b5e20;
  }
  .rejected-result {
    background: #fff3e0;
    border: 1px solid #ff9800;
    color: #e65100;
  }
  .error-result {
    background: #ffebee;
    border: 1px solid #f44336;
    color: #b71c1c;
  }
  .success-result pre,
  .rejected-result pre,
  .error-result pre {
    background: rgba(0, 0, 0, 0.1);
    padding: 0.5rem;
    border-radius: 4px;
    overflow-x: auto;
    font-size: 0.9em;
  }
</style>
