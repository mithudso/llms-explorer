    {
      "id": "clm:e40c43159c6e098cc2117c6fa01c40b0511621e108c11e8ead9ea745318a31d6",
      "text": "At MongoDB revision 35647d07bc4bc11966c90fe7100eb1db0b0ac1d9, timeseriesSideBucketCatalogMemoryUsageThreshold is a byte threshold above which idle buckets in the side bucket catalog are expired; Alibaba Cloud documents the same threshold semantics. (medium confidence)",
      "source_url": "https://github.com/mongodb/mongo/blob/35647d07bc4bc11966c90fe7100eb1db0b0ac1d9/src/mongo/db/timeseries/timeseries.idl",
