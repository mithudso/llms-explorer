    {
      "title": "Anti-Patterns",
      "facts": [
        {
          "text": "Multi-cloud without read preference tuning: Default primary read preference sends all reads cross-cloud → high latency. Set readPreference: nearest.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#anti-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Majority writes in high-latency multi-cloud setups without wtimeoutMS: Writes can block indefinitely if cross-cloud replication stalls. Always set wtimeoutMS.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#anti-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Using VNet peering instead of Private Link for new Azure deployments: Private Link is recommended and simpler (no IP overlap constraints).",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#anti-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Legacy GCP PSC endpoints without migration plan: Must migrate to port-mapped before April 30, 2027.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#anti-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Forgetting cross-cloud egress costs in TCO analysis: Multi-cloud replication incurs ~$0.08/GB egress.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#anti-patterns",
          "note": null,
          "level": 0
        }
      ]
    },
