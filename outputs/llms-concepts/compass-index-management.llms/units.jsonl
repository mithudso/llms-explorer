{"id": "clm:f2f0bc22b41fa6a3d148ceb97fb5d9754dfd7cf52f4893e0ce8552507341ea93", "type": "statement", "text": "Compass Usage reflects lookup activity on the connected node since creation or server restart; inspect $indexStats on each node for broader coverage. (high confidence)", "source_url": "https://www.mongodb.com/docs/compass/indexes/", "anchor": "", "page_class": "reference", "keywords": ["Compass Index Management"], "code": null, "origin": "dr", "section": "facts", "relation": "about", "score": 1.0, "also": ["https://www.percona.com/blog/identifying-unused-indexes-in-mongodb/", "https://www.mongodb.com/docs/compass/indexes.md", "https://stackoverflow.com/questions/79119345/why-doesnt-mongooses-findbyid-method-increment-id-index-usage-in-mongo"], "semantic_score": null, "pass": "keyword", "canonical_concept_id": "concept:dc28efbb5d9f5d80e90213a1a5faac1665ecca9938e59cbd7d19cfafa8964a37", "validation_status": "SUPPORTED", "evidence_ids": ["ev:c2b61aa6977d6fd77f8c9a9ad9988123f58ebbc74159148629ce9b03dbf9cdfd"]}
{"id": "clm:212cf7b85a4d9354d03b016a7572c064b438fddb412d917cbc6e5f4b51c50fb0", "type": "statement", "text": "Hide an index before dropping it to assess query impact. Compass provides hide/unhide controls and a Hidden property badge. (high confidence)", "source_url": "https://www.mongodb.com/docs/compass/indexes.md", "anchor": "", "page_class": "reference", "keywords": ["Compass Index Management"], "code": null, "origin": "dr", "section": "facts", "relation": "about", "score": 1.0, "also": ["https://oneuptime.com/blog/post/2026-03-31-mongodb-how-to-manage-indexes-with-mongodb-compass/view", "https://www.mongodb.com/docs/compass/indexes/", "https://www.mongodb.com/docs/manual/core/indexes/drop-index.md"], "semantic_score": null, "pass": "keyword", "canonical_concept_id": "concept:dc28efbb5d9f5d80e90213a1a5faac1665ecca9938e59cbd7d19cfafa8964a37", "validation_status": "SUPPORTED", "evidence_ids": ["ev:feaf41d0448cdc9ce99d67e448db93579addf5691de53e3c46cc619720e51057"]}
