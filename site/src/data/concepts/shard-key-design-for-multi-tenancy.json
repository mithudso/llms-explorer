    {
      "title": "Facts and statements",
      "facts": [
        {
          "text": "Evaluate a shard-key candidate by cardinality, frequency of each value, monotonicity, and the common query patterns. High cardinality alone does not guarantee even distribution. (high confidence)",
          "source": "https://www.mongodb.com/docs/manual/core/sharding-choose-a-shard-key/",
          "note": null,
          "claimId": "clm:b881eabd0d8bbfe0b013f3bafb8004c1619f7f130584bdf68e458488fa3b9df5",
          "validationStatus": "SUPPORTED",
