    {
      "id": "clm:aca46992613b077b56b8276a63507d1cb987ecf2ee870082ba401c91359994e7",
      "text": "New writes enter an opTime queue separately from initial session history. The donor reads the queued oplog outside its queue mutex and asserts if it is absent. Ordinary retryable writes transfer directly; retryable internal transactions unroll filtered applyOps and enqueue previous applyOps links; non-retryable internal transactions are skipped; non-internal transaction prepare/commit history becomes a sentinel. Image conversion and identity down-conversion also apply to this path. (high confidence)",
      "source_url": "https://raw.githubusercontent.com/mongodb/mongo/dacdbc3df2fbe579b03336a2f01fc9aedf406a41/src/mongo/db/s/session_catalog_migration_source.cpp",
      "also": [
        "https://api.github.com/repos/mongodb/mongo/git/ref/tags/r7.0.22",
        "https://api.github.com/repos/mongodb/mongo/git/tags/ef98696d6009abf1b6f73a935c9f7bb3fa3ea4c4",
        "https://www.mongodb.com/docs/v7.0/release-notes/7.0/"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:081c00ca40d833a67535a0dfe2a677273d539560a5f0f2695cfb3ab3fbf6e3fb",
        "ev:47d5b60ba68d1f492ad98cdd38988de7ec9dca205ea0b735a08a2d98a67e85eb",
        "ev:65df6cd8d3003206d34351dabc24c1c7eafbde5a6c98453a50c2e8b4290236f3",
        "ev:6f2f65e6aec688a312f3fc143d0cd48918f6955cccb839e550fc5ffb2b44b24c",
        "ev:6fd7ddbbf1c54421feca69dce8e596d50a2dfe87da07d850b7a4e7498c543bdc",
        "ev:d0ff6924be82d7eece3dea79c6accfde69d48cf71b7147e29e87dbf58b07e585"
      ],
      "temporal": {
        "applicability_version": "7.0.22"
      }
