    {
      "title": "When NOT to use this skill",
      "facts": [
        {
          "text": "Single-tenant applications - no isolation patterns needed; use standard MongoDB schema design",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#when-not-to-use-this-skill",
          "note": null,
          "level": 0
        },
        {
          "text": "On-premises deployments without Atlas - some patterns (Atlas Projects, Data Federation, Atlas App Services Rules) are Atlas-only",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#when-not-to-use-this-skill",
          "note": null,
          "level": 0
        },
        {
          "text": "Fewer than ~5 tenants with no growth plans - operational overhead of isolation patterns exceeds the benefit",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#when-not-to-use-this-skill",
          "note": null,
          "level": 0
        },
        {
          "text": "Internal tooling where all users belong to the same trust boundary",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#when-not-to-use-this-skill",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "Hybrid (Production SaaS)",
      "facts": [
        {
          "text": "Tier 1 Enterprise → Model D",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#hybrid-production-saas",
          "note": null,
          "level": 0
        },
        {
          "text": "Tier 2 Mid-market → Model C",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#hybrid-production-saas",
          "note": null,
          "level": 0
        },
        {
          "text": "Tier 3 SMB/free → Model A",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-multi-tenancy/#hybrid-production-saas",
          "note": null,
          "level": 0
        },
        {
