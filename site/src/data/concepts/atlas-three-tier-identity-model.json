  "facets": [
    {
      "title": "Definitions",
      "facts": [
        {
          "text": "The three-tier description refers to organization roles, project roles, and database-user roles within clusters. Atlas users are separate from database users. Sources: https://aws.amazon.com/blogs/opensource/decoupling-authorization-at-scale-mongodb-atlas-and-cedar-based-resource-policies/ ; https://www.mongodb.com/docs/atlas/organizations-projects.md",
          "source": "https://aws.amazon.com/blogs/opensource/decoupling-authorization-at-scale-mongodb-atlas-and-cedar-based-resource-policies/",
          "note": null,
          "claimId": "clm:1d271ceeae63105f84a68aecacc4d470a7c82b28ee1ab0d7a44ce402fa51d438",
          "validationStatus": "REMEDIATED-PROJECTION",
          "evidenceIds": [],
          "also": [
            "https://www.mongodb.com/docs/atlas/organizations-projects.md",
            "https://www.mongodb.com/docs/atlas/security-add-mongodb-users.md",
            "https://www.mongodb.com/docs/atlas/reference/user-roles.md"
          ],
          "originValidationStatus": "SUPPORTED",
