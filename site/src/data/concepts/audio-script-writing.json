    },
    {
      "title": "The one rule: writing for the ear is single-pass",
      "facts": [
        {
          "text": "Listeners process roughly 150–160 words per minute for narration, 130–145 wpm for voice-UI prompts, and 110–125 wpm for IVR. They lose comprehension on:",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/audio-script-writing/#the-one-rule-writing-for-the-ear-is-single-pass",
          "note": null
        },
        {
          "text": "Subordinate clauses stacked more than one deep",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/audio-script-writing/#the-one-rule-writing-for-the-ear-is-single-pass",
          "note": null
        },
        {
          "text": "Parentheticals (the ear has no parens)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/audio-script-writing/#the-one-rule-writing-for-the-ear-is-single-pass",
          "note": null
        },
        {
          "text": "Lists longer than three items without explicit numbering",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/audio-script-writing/#the-one-rule-writing-for-the-ear-is-single-pass",
          "note": null
        },
        {
          "text": "Numbers and proper nouns delivered without a beat of silence after",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/audio-script-writing/#the-one-rule-writing-for-the-ear-is-single-pass",
          "note": null
        }
      ]
    },
