            "ev:e82deea80c3301e912fadd67cbfa529e01dea32ece70572f58657028f47f1383",
            "ev:f45992fe75f9d3bb2fa2f58913118aca67f6e960f206edfc3926f002abbc5da6"
          ],
          "also": [
            "https://www.mongodb.com/docs/atlas/billing/data-transfer-costs.md"
          ],
          "remediation": {
            "claim_id": "clm:4c8cb7f425af3c4e47bcffa7bdc9cfcd185f36608c9f88ec23503e3e3f68b225",
            "outcome": "CORRECTED",
            "at": "2026-11-02T10:24:29Z"
          }
        },
        {
          "text": "A private path does not universally eliminate transfer charges: AWS states that same-AZ VPC peering transfer is free while cross-AZ and cross-region VPC peering transfer incurs charges. This is an AWS networking rule, not proof of a particular Atlas replication invoice rate. (low confidence) (verified as of 2026-10-31)",
          "source": "https://aws.amazon.com/blogs/networking-and-content-delivery/demystifying-amazon-vpc-peering-charges/",
