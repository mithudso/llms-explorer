---
import "../styles/global.css";
import "../styles/lx-polish.css";
const { title, heading = title, description, route, twin: twinProp, noindex = false, adEligible = false } = Astro.props;
// `noindex` excludes incomplete references and unverified evidence from search.
// Content pages carry a `.md` twin at the same route; the generated listing
// pages (home, section indexes) pass `twin={null}` because twins.py writes a
// twin only for `src/content/**`, and a link to a file that is not published
// is worse than no link.
const twin = twinProp === undefined ? route.replace(/\/$/, "") + ".md" : twinProp;
// Routes that hold a secret (session islands, the one-time key, API-key
// inputs) get no third-party script. Mirrors STRICT_ROUTES in tools/twins.py,
// which gives these routes the CSP that would block the tags anyway.
const STRICT_ROUTES = ["/login/", "/account/", "/keys/", "/usage/", "/contribute/",
                       "/donate/", "/moderate/", "/proposals/", "/playground/"];
const strict = STRICT_ROUTES.some((r) => route.startsWith(r));
// Reader journeys lead. The resource catalogue remains in the More menu.
const NAV = [
  ["/workflows/", "Guides & experiments", "Worked workflows and the evidence behind them"],
  ["/skills/", "Skills", "Read and reuse agent instructions"],
  ["/research/", "Research library", "Find references, guides and skills by task"],
  ["/apps/", "Apps", "Choose a terminal workbench"],
];
const RESOURCES = [
  ["/queue/", "Research queue", "What is being researched now, and what is waiting"],
  ["/context/", "Context files", "Research and concept facts as Markdown"],
  ["/blog/", "Article archive", "All guides, experiments and case studies"],
  ["/start-here/", "Start here", "Try a short handoff without installing anything"],
  ["/downloads/", "Installation reference", "All setup instructions and download options"],
  ["/reference/", "Technical reference", "Formats, lint rules and publishing conventions"],
  ["/examples/", "Code examples", "Copyable recipes with stated assumptions"],
  ["/demo/", "Retrieval demo", "Recorded keyword, vector and hybrid results"],
  ["/explorer/", "LLMSX Explorer", "Research workbench features and shortcuts"],
  ["/family/", "For agents: llms.txt", "The machine-readable site index"],
  ["/contribute/", "Contribute", "Suggest additions to the research library"],
  ["/donate/", "Support the project", "Help fund the work"],
  ["/login/", "Sign in", "Account, API keys and hosted tools"],
  ["/account/", "Account", "Your signed-in profile and settings"],
  ["/keys/", "API keys", "Manage access to hosted tools"],
  ["/usage/", "Usage", "Inspect your account usage"],
  ["/proposals/", "Your proposals", "Track submitted contributions"],
];
// App Review opens the Net-DNS-Monitor Support and Privacy pages. Guideline
// 3.1.1 treats a link that solicits funding as a payment path outside In-App
// Purchase, so those pages show no donate link. Every other page keeps it.
const menuResources = route.startsWith("/net-dns-monitor/")
  ? RESOURCES.filter(([href]) => href !== "/donate/")
  : RESOURCES;
---
<html lang="en"><head>
  <meta charset="utf-8" />
  {!strict && (<>
  <!-- Google tag (gtag.js) -->
  <script is:inline>
    if (navigator.doNotTrack !== "1" && !navigator.globalPrivacyControl && !window["ga-disable-G-0E31PW5CE9"]) {
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    window.gtag = gtag;
    gtag('config', 'G-0E31PW5CE9', {
      page_location: location.origin + location.pathname,
      page_referrer: document.referrer ? new URL(document.referrer).origin : "",
      allow_google_signals: false
    });
    var tag = document.createElement("script");
    tag.async = true;
    tag.src = "https://www.googletagmanager.com/gtag/js?id=G-0E31PW5CE9";
    tag.crossOrigin = "anonymous";
    document.head.append(tag);
    }
  </script>
  </>)}
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {/* Ownership verification is separate from page-level ad eligibility.
      Enable ads only after assessing the page and the consent setup. */}
  <meta name="google-adsense-account" content="ca-pub-1706083044457708" />
  {adEligible && !strict && !noindex && <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1706083044457708" crossorigin="anonymous"></script>}
  <title>{title} · LLMSX</title>
  <meta name="llmsx-release" content="reader-journeys-2026-11-07" />
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={new URL(route, Astro.site).href} />
  {twin && <link rel="alternate" type="text/markdown" href={twin} />}
  <link rel="describedby" href="/llms.txt" />
  <script src="../scripts/lx-polish.js"></script>
</head><body data-analytics-enabled={strict ? "false" : "true"}>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <nav class="site-nav" aria-label="Primary">
      <a class="brand" href="/" aria-label="LLMSX home">llmsx<span class="brand-note"> / practical agent engineering</span></a>
      <span class="links">
        {NAV.map(([href, label, note]) => (
          <a href={href} title={note} aria-current={(route.startsWith(href) || (href === "/workflows/" && (route.startsWith("/blog/") || route === "/start-here/")) || (href === "/research/" && (route.startsWith("/tree/") || route === "/context/"))) ? "page" : null} data-track="nav_click" data-label={label} data-destination={href}>{label}</a>
        ))}
        <a class="tree-shortcut" href="/tree/" data-track="nav_click" data-label="concept-tree">Concept tree</a>
        <details class="menu"><summary data-track="resources_menu_open">Resources & account</summary>
          <div class="menu-items">
            {menuResources.map(([href, name, note]) => (
              <a href={href}>{name}<span class="menu-note">{note}</span></a>
            ))}
          </div>
        </details>
      </span>
    </nav>
  </header>
  <main id="main-content" tabindex="-1"><h1>{heading}</h1><slot /></main>
  <footer class="site-footer">
    <p>LLMSX — practical engineering for AI agents.</p>
    <nav aria-label="Footer">
      <a href="/about/">About & contact</a>
      <a href="/editorial/">Sources & editorial standards</a>
      <a href="/privacy/">Privacy</a>
      <a href="https://github.com/mithudso/llms-explorer">Source code</a>
      <a href="/family/">For agents: llms.txt</a>
      {twin && <a href={twin}>This page as Markdown</a>}
    </nav>
  </footer>
  <script>
    import { installEngagement } from "../scripts/engagement";
    installEngagement();
  </script>
</body></html>
