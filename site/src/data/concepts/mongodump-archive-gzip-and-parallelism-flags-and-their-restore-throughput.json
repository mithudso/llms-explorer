          ],
          "also": [
            "https://www.mongodb.com/docs/database-tools/mongorestore/mongorestore-examples.md"
          ]
        },
        {
          "text": "mongodump --numParallelCollections (short option -j) controls the number of collections dumped concurrently and defaults to 4; it is collection-level parallelism. (medium confidence)",
          "source": "https://www.mongodb.com/docs/database-tools/mongodump.md",
          "note": null,
          "claimId": "clm:bb129b074f1fffb35924c866b765920b65bac490c3f9386f9143accf7a6d0f56",
          "validationStatus": "SUPPORTED",
          "evidenceIds": [
