      ]
    },
    {
      "id": "clm:279686ed06504627ed4c29af0c561be804d562b262c35749366e04f4ea43a618",
      "text": "Percona\u2019s reference lists config.providerEndpoint as optional with default https://api.openai.com/v1/embeddings; modelName is both the index lookup name and the value sent in the request model field. (low confidence) (verified as of 2026-10-29)",
      "source_url": "https://raw.githubusercontent.com/percona/percona-search-for-mongodb-docs/main/docs/automatic-embedding-configuration-reference.md",
      "also": [],
      "validation_status": "SUPPORTED",
