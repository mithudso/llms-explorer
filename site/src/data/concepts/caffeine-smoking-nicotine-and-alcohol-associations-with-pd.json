  "related": [],
  "canonicalArtifactSha256": "bd66c852c775c46551f89a87173bf4f4f4cc7bedaa0370363729568a4b4e5155",
  "canonicalConceptId": "concept:a69687150265a1c6967e337bac1e4254aed9d35e6cf43589d5b69ed52840ae10",
  "narrative": [
    {
      "assertionId": "prose:1a7116acce8e30fab0423b5933aafe67bf46c825951374a0fa7271efc4898ea2",
      "statementSha256": "1a7116acce8e30fab0423b5933aafe67bf46c825951374a0fa7271efc4898ea2",
      "assertionKind": "summary",
      "index": 0,
      "documentSlug": "caffeine-smoking-nicotine-and-alcohol-associations-with-pd",
      "documentConcept": "Caffeine, smoking, nicotine and alcohol associations with PD",
      "canonicalConceptId": "concept:a69687150265a1c6967e337bac1e4254aed9d35e6cf43589d5b69ed52840ae10",
      "text": "Caffeine, smoking, nicotine and alcohol require separate interpretations for PD incidence and treatment after diagnosis. Several cohorts associate caffeine or coffee with lower PD risk, but a large UK Biobank analysis found no overall association and reported genotype heterogeneity; caffeine did not improve motor outcomes in Café-PD. Smoking has an inverse epidemiologic association, with supportive but assumption-dependent Mendelian-randomisation evidence, while nicotine trials have not demonstrated clinical benefit. Alcohol findings vary between prospective cohorts, pooled observational analyses and genetic studies. These associations do not justify starting smoking or alcohol for prevention, or prescribing nicotine for PD progression. Key uncertainties include reverse causation, confounding, exposure definitions, genotype subgroup replication and whether any intervention before diagnosis changes incidence.",
