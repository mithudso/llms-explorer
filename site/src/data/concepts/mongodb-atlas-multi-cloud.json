    {
      "title": "DNS",
      "facts": [
        {
          "text": "Private DNS Zone <cluster-id>.mongodb.net with A records pointing to private endpoint NIC IP. Zone must be linked to every VNet needing resolution.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#dns",
          "note": null,
          "level": 0
        },
        {
          "text": "Connection string: mongodb+srv://cluster0-pl-0.<cluster-id>.mongodb.net",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#dns",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "Legacy vs Port-Mapped",
      "facts": [
        {
          "text": "Legacy (deprecated Apr 30 2027): _pl- prefix; 50 IP addresses per region; 50 forwarding rules",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#legacy-vs-port-mapped",
          "note": null,
          "level": 0
        },
        {
          "text": "Port-Mapped (current): _psc- prefix; 1 IP address; 1 forwarding rule; requires portMappingEnabled: true",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#legacy-vs-port-mapped",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "DNS for PSC",
      "facts": [
        {
          "text": "Cloud DNS private zone. Allow TCP 27017 + high ports (1024-65535) through VPC firewall rules for SRV connection strings.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#dns-for-psc",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "Topology Options",
      "facts": [
        {
          "text": "3-node across 2 clouds (HA across clouds):",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#topology-options",
          "note": null,
          "level": 0
        },
        {
          "text": "Primary: AWS US_EAST_1",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#topology-options",
          "note": null,
          "level": 1
        },
        {
          "text": "Secondary: GCP EASTERN_US",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#topology-options",
          "note": null,
          "level": 1
        },
        {
          "text": "Secondary: Azure EASTUS",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#topology-options",
          "note": null,
          "level": 1
        },
        {
          "text": "Write-concern latency: W:majority in multi-cloud = at least one write acknowledged from another cloud. Cross-cloud RTT typically 10-50ms. Use wtimeoutMS to prevent write stalls.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#topology-options",
          "note": null,
          "level": 0
        },
        {
          "text": "Read preference: Route reads to local secondary with readPreference: nearest + maxStalenessSeconds.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#topology-options",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "Cross-Cloud DR Pattern",
      "facts": [
        {
          "text": "Primary cloud (AWS): 3 electable nodes",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#cross-cloud-dr-pattern",
          "note": null,
          "level": 1
        },
        {
          "text": "DR cloud (Azure/GCP): 1-2 non-electable nodes (priority=0) or hidden secondaries",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#cross-cloud-dr-pattern",
          "note": null,
          "level": 1
        },
        {
          "text": "Hidden secondary in DR cloud: receives replication without being elected",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#cross-cloud-dr-pattern",
          "note": null,
          "level": 1
        },
        {
          "text": "Failover: promote DR nodes by changing priority",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#cross-cloud-dr-pattern",
          "note": null,
          "level": 1
        },
        {
          "text": "RPO: Near-zero (replication lag typically <1 second for healthy cluster) RTO: 10-30 seconds for automatic election after primary failure",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#cross-cloud-dr-pattern",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "Egress Cost Analysis",
      "facts": [
        {
          "text": "Cross-cloud data transfer incurs egress charges:",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#egress-cost-analysis",
          "note": null,
          "level": 0
        },
        {
          "text": "AWS→GCP: ~$0.08/GB (US East)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#egress-cost-analysis",
          "note": null,
          "level": 1
        },
        {
          "text": "AWS→Azure: ~$0.08/GB (US East)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#egress-cost-analysis",
          "note": null,
          "level": 1
        },
        {
          "text": "GCP→AWS: ~$0.08/GB (US Central)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#egress-cost-analysis",
          "note": null,
          "level": 1
        },
        {
          "text": "For a 3-replica-set with 10 GB/day replication across clouds: ~$0.80/day in egress costs.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#egress-cost-analysis",
          "note": null,
          "level": 0
        },
        {
          "text": "Mitigation: Keep primary and majority of nodes in lowest-cost cloud. Use hidden secondaries in DR cloud to limit replication traffic.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#egress-cost-analysis",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "Azure MACC",
      "facts": [
        {
          "text": "Atlas purchased via Azure Marketplace counts toward Microsoft Azure Consumption Commitment (MACC). Direct MongoDB invoices are NOT MACC-eligible.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#azure-macc",
          "note": null,
          "level": 0
        },
        {
          "text": "MACC-eligible purchases: Atlas cluster compute/storage, Advanced Security, Dedicated Search Nodes, Stream Processing.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#azure-macc",
          "note": null,
          "level": 0
        },
        {
          "text": "Azure Native MongoDB (ANM): First-party Azure resource in Azure Portal. Billing on Azure invoice (MACC-eligible). Generally at feature parity with standard Atlas.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#azure-macc",
          "note": null,
          "level": 0
        }
