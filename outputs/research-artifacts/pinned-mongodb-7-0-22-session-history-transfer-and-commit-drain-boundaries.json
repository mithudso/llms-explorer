    {
      "id": "clm:ca80b08ae93c57def008c8ea4a63d6aba350f5f628c1668d9eb9c379171e86cb",
      "text": "The initial majority barrier handles histories from older replication terms: after collecting session last-write times, the donor writes a new initialization no-op and waits for majority acknowledgement without a timeout. The header explains that directly waiting for an older-term operation time is unsupported; the later barrier covers earlier history, while a failed history lookup can mean truncation or rollback. (high confidence)",
      "source_url": "https://raw.githubusercontent.com/mongodb/mongo/dacdbc3df2fbe579b03336a2f01fc9aedf406a41/src/mongo/db/s/session_catalog_migration_source.h",
      "also": [
        "https://raw.githubusercontent.com/mongodb/mongo/dacdbc3df2fbe579b03336a2f01fc9aedf406a41/src/mongo/db/s/session_catalog_migration_source.cpp",
        "https://api.github.com/repos/mongodb/mongo/git/ref/tags/r7.0.22",
