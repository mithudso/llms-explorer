---
import Base from "../../layouts/Base.astro";
import Tree3D from "../../components/Tree3D.astro";
import tree from "../../data/tree.json";

const nodeCount = Object.keys(tree.nodes).length;
const description = `The whole concept tree as a 3D force-directed map: ${nodeCount} mapped topics, ${tree.frontier.length} frontier concepts, rendered in the browser from one inlined JSON file.`;
---

<Base title="The concept tree in 3D" description={description} route="/tree/3d/" twin={null}>
  <p>
    The same tree as <a href="/tree/">the browser</a>, drawn as a force-directed
    graph: {nodeCount} mapped topics and {tree.frontier.length} frontier
    concepts, coloured by the root domain each one hangs from. Drag to rotate,
    scroll to zoom, click a node to isolate it with its neighbours and read what
    the tree knows about it; click empty space to come back to the whole map.
  </p>
  <p>
    The graph data is inlined and the renderer loads from this site. The graph needs no separate data query; other page features, including analytics, may make network requests. Frontier names are drawn grey and small. They come from unresolved child concepts and unchecked entries in the snapshotted research queue, and have no topic node of their own. The map derives them at build time. Generated {tree.generated}.
  </p>

  <Tree3D />

  <p>
    <a href="/tree/">← the tree browser</a> ·
    <a href="/reference/">how the tree is built</a>
  </p>
</Base>
