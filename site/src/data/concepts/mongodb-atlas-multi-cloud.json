      "title": "Setup Steps",
      "facts": [
        {
          "text": "Request Private Endpoint in Atlas UI/API: POST /api/atlas/v2/groups/{groupId}/privateEndpoint/azure/endpointService",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-multicloud/#setup-steps",
          "note": null,
          "level": 0
        },
        {
