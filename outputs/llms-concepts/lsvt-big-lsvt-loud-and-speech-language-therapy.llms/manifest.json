  "narrative": [
    {
      "assertionId": "prose:3af6c3397e6d2399e2225e643cfa465859562d1a7642e966b29b9d80dcbcf919",
      "statementSha256": "3af6c3397e6d2399e2225e643cfa465859562d1a7642e966b29b9d80dcbcf919",
      "assertionKind": "summary",
      "index": 0,
      "documentSlug": "lsvt-big-lsvt-loud-and-speech-language-therapy",
      "documentConcept": "LSVT BIG, LSVT LOUD and speech-language therapy",
      "canonicalConceptId": "concept:ebe0026e97755037a4ba504055e4cd6f8ade3a88c240f46c9c156b2254807fb5",
      "text": "LSVT LOUD and LSVT BIG are standardized, intensive programmes (16 sessions over four weeks) that train the amplitude of voice or limb movement. In the PD COMM trial of 388 people, LSVT LOUD lowered self-reported voice handicap versus no therapy and versus NHS speech and language therapy, with benefit still present at 12 months and mostly minor vocal-strain adverse events. Two Cochrane reviews (searches to April 2011) found insufficient evidence; later meta-analyses report higher vocal loudness, while intelligibility results are mixed. NICE NG71 recommends speech and language therapy including attention to effort therapies; RCSLT guidance (December 2025) highly recommends LSVT LOUD. For LSVT BIG, the Berlin trial reported UPDRS motor gains, but a meta-analysis found only trends for walking and rated evidence preliminary.",
