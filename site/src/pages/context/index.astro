---
import Base from "../../layouts/Base.astro";
import { context } from "../../data/context";
import { tree } from "../../data/tree";

// One categorised list of everything an agent can load: the mirrored research
// reports (the context files) and the per-concept facts files, filed under the
// roots of the concept tree by tools/gen_context.py. Nothing is fetched at view
// time and nothing is rendered from HTML twice: every row links the raw `.md`
// the /*.md header rule serves as text/markdown, so the file a person clicks and
// the file an agent fetches are the same bytes. The agent-side copy of this
// page is /context.md, written by tools/twins.py from the same context.json.
const t = context.totals;
const mb = (t.bytes / 1_048_576).toFixed(1);
const kb = (b: number) => `${Math.max(1, Math.round(b / 1024))} KB`;
const tokens = (b: number) => `~${Math.round(b / 4).toLocaleString()} tokens`;
const nameOf = (slug: string) => tree.nodes[slug]?.concept ?? slug;

// Every root, largest first, so the page opens on the corpora with the most in
// them; a root with only one or two rows opens expanded because a <details>
// hiding two lines is friction, not structure.
const roots = [...context.roots].sort(
  (a, b) => b.files.length + b.concepts.length - (a.files.length + a.concepts.length) ||
    a.concept.localeCompare(b.concept));

const title = "Context files";
const description = `${t.files} research reports (${mb} MB) and ${t.concepts} concept facts files (${t.facts.toLocaleString()} source-anchored facts), filed under ${t.roots} concept-tree roots — every one a plain markdown fetch.`;
---
<Base title={title} description={description} route="/context/">
  <p class="lede">The shelf: every file an agent can load, filed under the concept it belongs to and sized in tokens.</p>
  <p class="tab-note">
    <strong>Context files</strong> is for loading: each row below is a plain markdown file — a
    research report, or one concept's facts — and the link on it is the file itself. Click a root
    or a concept name to expand it in place; nothing here navigates except the file links.
    <a href="/tree/">Concepts</a> is the other tab: the same research as a map you browse.
  </p>
  <p>
    A <strong>context file</strong> is a document an agent loads whole: a research report on one
    subject, written to be read into a context window rather than browsed. Third-party full text
    is never republished here — see <a href="/reference/ethos/">the ethos</a>. A
    <strong>facts file</strong> is one concept's facets and facts as a markdown list, each fact
    carrying the URL it came from. <a href="/reference/context-files/">How these files are filed
    and formatted</a>. Agents: fetch <a href="/context.md"><code>/context.md</code></a> for this
    whole listing as one file; any row below is the second and last hop.
  </p>

  <p class="proof">
    {t.files} files · {mb} MB · {t.concepts} concepts · {t.facts.toLocaleString()} facts in {t.facets.toLocaleString()} facets
    · {t.roots} roots · generated {context.generated}
  </p>

  <ul class="ctx-tree">
  {roots.map((root) => {
    const rows = root.files.length + root.concepts.length;
    return (
      <li>
      <details class="ctx-root" open={rows <= 2 || undefined}>
        <summary>
          <span class="ctx-root-name">{root.concept}</span>
          <span class="ctx-root-count">{root.files.length} file{root.files.length === 1 ? "" : "s"} · {root.concepts.length} concept{root.concepts.length === 1 ? "" : "s"}</span>
        </summary>
        <ul class="ctx-rows">
          {root.files.map((f) => (
            <li class="ctx-file">
              <a href={f.route} class="ctx-link">{f.title}</a>
              <span class="ctx-size">{kb(f.bytes)} · {tokens(f.bytes)}</span>
              <a href={f.download} class="ctx-md" download>.md</a>
              {f.description && <span class="ctx-desc">{f.description}</span>}
              {f.concepts.length > 0 && (
                <span class="ctx-cited">cited by {f.concepts.slice(0, 3).map(nameOf).join(", ")}{f.concepts.length > 3 ? ` +${f.concepts.length - 3}` : ""}</span>
              )}
            </li>
          ))}
          {root.concepts.map((c) => (
            <li class="ctx-concept">
              <details>
                <summary>
                  <span class="ctx-concept-name">{c.concept}</span>
                  <span class="ctx-count">{c.facts} facts · {c.facets} facets</span>
                </summary>
                <p class="ctx-concept-body">
                  <a href={c.download} class="ctx-md" download>facts.md</a>
                  {tree.nodes[c.slug] && <> · <a href={`/tree/${c.slug}/`}>read on the concept page</a></>}
                </p>
              </details>
            </li>
          ))}
        </ul>
      </details>
      </li>
    );
  })}
  </ul>
</Base>

<style>
  .ctx-tree, .ctx-rows { list-style: none; padding: 0; margin: 0; }
  .ctx-tree > li { border-top: 1px solid var(--line); padding: var(--sp-3) 0; margin: 0; }
  .ctx-root > summary, .ctx-concept summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: var(--sp-3); align-items: baseline; }
  .ctx-root > summary::-webkit-details-marker, .ctx-concept summary::-webkit-details-marker { display: none; }
  .ctx-root > summary::before, .ctx-concept summary::before { content: "▸"; display: inline-block; width: 1em; color: var(--ink-faint); transition: transform 0.1s; }
  details[open] > summary::before { transform: rotate(90deg); }
  .ctx-root-name { font-family: var(--font-display); font-size: var(--step-1); font-weight: 600; flex: 1; }
  .ctx-root-count, .ctx-count, .ctx-size { font-family: var(--font-mono); font-size: var(--step--1); color: var(--ink-faint); white-space: nowrap; }
  .ctx-rows { padding-left: calc(1em + var(--sp-2)); margin-top: var(--sp-2); }
  .ctx-rows > li { margin: var(--sp-2) 0; font-size: var(--step--1); }
  .ctx-file { display: flex; flex-wrap: wrap; gap: 0 var(--sp-3); align-items: baseline; }
  .ctx-link { font-weight: 600; }
  .ctx-desc, .ctx-cited { display: block; width: 100%; color: var(--ink-muted); font-size: 0.9em; }
  .ctx-cited { color: var(--ink-faint); }
  .ctx-md { font-family: var(--font-mono); white-space: nowrap; }
  .ctx-concept-name { flex: 1; }
  .ctx-concept-body { margin: var(--sp-1) 0 var(--sp-2) calc(1em + var(--sp-2)); color: var(--ink-muted); }
  @media (max-width: 640px) {
    .ctx-root > summary, .ctx-concept summary { flex-wrap: wrap; }
  }
</style>
