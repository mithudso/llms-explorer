          ],
          "also": [
            "https://www.mongodb.com/docs/atlas/data-federation/query/query-federated-database.md"
          ]
        },
        {
          "text": "Pagination with $skip over an unordered S3 query can skip different documents on repeated runs. (medium confidence) (verified as of 2026-10-14)",
          "source": "https://www.mongodb.com/docs/atlas/data-federation/query/query-federated-database.md",
          "note": null,
          "claimId": "clm:a5f4b3ab6e60d6d3c3a3496bcf3a47a508b87fc07bb79376c49e7836341b7fd8",
          "validationStatus": "SUPPORTED",
