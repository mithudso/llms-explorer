      ]
    },
    {
      "id": "clm:4d87fe43610a88b65ceef8ca595c535f7102bd73fd18215019ec39a7725c1cdf",
      "text": "Lee and colleagues specify that their study used RT-QuIC and referred to that method as SAA. (low confidence)",
      "source_url": "https://elifesciences.org/articles/92775",
      "also": [],
