    {
      "id": "clm:1252678bbd50035a5e495fd652e2ec04f9b417185d979c50800d848ee52d8691",
      "text": "SERVER-127943 reports that resuming an index build does not set BulkBuilderImpl::_hasMultiKeyMetadataKeys, so for a wildcard index the build may incorrectly try to insert a multikey metadata key twice. The ticket lists a fix in 9.0.0-rc0 and a backport request for v8.3, v8.0 and v7.0; it does not confirm the backports. Sources: https://jira.mongodb.org/browse/SERVER-127943",
      "source_url": "https://jira.mongodb.org/browse/SERVER-127943",
      "also": [],
      "validation_status": "REMEDIATED-PROJECTION",
      "origin_validation_status": "SUPPORTED",
