        "ev:b9208c2fb4a88ef03510a15c2dd7454b5b9406830741e8b5e7fa4f3e62b7e989",
        "ev:c11c83c47235dbf8cf62eafdfc62c91fb3707f45ae3e543abfce5f97f3b66586"
      ]
    },
    {
      "id": "clm:1be0624fb48e7b6e625b7beb5e54726cdfc22826f9a6fe84c7389bc560cd8911",
      "text": "Two recent systematic reviews of singing in Parkinson's disease word their conclusions differently: Irons and Sheffield (23 studies, 540 participants; last search 3 April 2025) rate the certainty of the one RCT-based favourable outcome as very low and state that, due to insufficient high-quality evidence, they are unable to determine the effects of singing interventions, whereas Trinchillo and colleagues (twenty-six studies, 1057 patients; considerable heterogeneity precluded meta-analysis) conclude that singing is a promising adjunct therapy. (high confidence) (verified as of 2026-11-27)",
      "source_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12645629/",
      "also": [
        "https://pmc.ncbi.nlm.nih.gov/articles/PMC13731696/"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:12763029df62e95c1274c0e1207b0406b7c9476c6de5cf93a8c2f8d6d17109ad",
        "ev:27ed4c46d033af28447410fb7768071d8beaedead2a15597c3cbcde5f7122a21",
        "ev:36bd0be6d700df88ef1387efa458cbded3cb2366a4f547c58d46283856cd9e30",
