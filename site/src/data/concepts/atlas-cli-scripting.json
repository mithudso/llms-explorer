    {
      "title": "How-to and procedures",
      "facts": [
        {
          "text": "Use --output json for the full JSON returned by the API, or JSONPath (json-path) and Go templates to select fields; customizing output makes it easier to automate processes based on Atlas CLI output. Sources: https://www.mongodb.com/docs/atlas/cli/current/custom-output-cli.md",
          "source": "https://www.mongodb.com/docs/atlas/cli/current/custom-output-cli.md",
          "note": null,
          "claimId": "clm:7d2c36dfa957c61edfd3fe7b190a239b1773a4b16c88d55b0f4d99d44c4fc4f9",
          "validationStatus": "REMEDIATED-PROJECTION",
