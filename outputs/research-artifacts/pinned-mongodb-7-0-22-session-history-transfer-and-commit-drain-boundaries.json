    {
      "id": "clm:2095b49e7e004af6faf2b45fff6667ecf2cddc82f2d31b2a422add968c4de9c7",
      "text": "For ordinary retryable-write history, a namespace mismatch ends traversal of that session chain, except for the incomplete-history marker. CRUD entries outside the chunk range are skipped. Previously migrated tagged no-ops are filtered using the original operation in their secondary object, while incomplete-history tagged no-ops pass through. A skipped operation also omits its associated image. (low confidence)",
      "source_url": "https://raw.githubusercontent.com/mongodb/mongo/dacdbc3df2fbe579b03336a2f01fc9aedf406a41/src/mongo/db/s/session_catalog_migration_source.cpp",
      "also": [
        "https://api.github.com/repos/mongodb/mongo/git/ref/tags/r7.0.22",
        "https://api.github.com/repos/mongodb/mongo/git/tags/ef98696d6009abf1b6f73a935c9f7bb3fa3ea4c4",
        "https://www.mongodb.com/docs/v7.0/release-notes/7.0/"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:2d62df7372468f1b631fdb01f33c9351187c0864805aaa9de2b9c3b99defd843",
