    {
      "title": "Single project",
      "facts": [
        {
          "text": "uv run and uv sync auto-create the .venv, auto-install the pinned",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/uv-python-toolchain/#single-project",
          "note": null
        },
        {
          "text": "Python if missing, auto-lock, and auto-sync before running - so the venv",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/uv-python-toolchain/#single-project",
          "note": null
        },
        {
          "text": "is an implementation detail you rarely activate manually. Key files:",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/uv-python-toolchain/#single-project",
          "note": null
        },
        {
          "text": "pyproject.toml - standard PEP 621 metadata + [tool.uv] config, [dependency-groups], [tool.uv.sources].",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/uv-python-toolchain/#single-project",
          "note": null
        },
        {
          "text": "uv.lock - the universal lockfile (commit to git; never hand-edit).",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/uv-python-toolchain/#single-project",
          "note": null
        },
        {
          "text": ".python-version - the pinned interpreter (written by uv python pin).",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/uv-python-toolchain/#single-project",
          "note": null
        },
        {
          "text": ".venv/ - the project virtualenv (gitignored).",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/uv-python-toolchain/#single-project",
          "note": null
        },
        {
          "text": "Dependency groups (PEP 735, the modern replacement for [project.optional-dependencies]",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/uv-python-toolchain/#single-project",
          "note": null
        },
        {
          "text": "\"extras\" used as dev deps): dev is the implicit default group. Control install",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/uv-python-toolchain/#single-project",
          "note": null
        },
        {
          "text": "scope on sync/run: --group <g>, --only-group <g>, --no-dev, --no-default-groups,",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/uv-python-toolchain/#single-project",
          "note": null
        },
        {
          "text": "--all-groups. Extras (consumer-facing optional features) are separate:",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/uv-python-toolchain/#single-project",
          "note": null
        },
        {
          "text": "--extra <e>, --all-extras.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/uv-python-toolchain/#single-project",
          "note": null
        },
        {
          "text": "Dependency sources - [tool.uv.sources] redirects a dependency away from PyPI:",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/uv-python-toolchain/#single-project",
          "note": null
        },
        {
          "text": "[tool.uv.sources] is non-standard metadata that uv strips when building a",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/uv-python-toolchain/#single-project",
          "note": null
        },
        {
          "text": "distribution - it affects your dev resolution, not what downstream consumers get.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/uv-python-toolchain/#single-project",
          "note": null
        }
      ]
