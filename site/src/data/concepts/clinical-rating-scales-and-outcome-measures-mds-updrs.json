    {
      "assertionId": "prose:122b1d88db7ae27d0fb9b8f0c5bb4090cff5011220bfae247783ecbf6c74ab9d",
      "statementSha256": "122b1d88db7ae27d0fb9b8f0c5bb4090cff5011220bfae247783ecbf6c74ab9d",
