{"id": "clm:2a8b4d6846ea4345313c9cf9ecb79b6717bb4c6ada0a9b68e00da24738f7cc1d", "type": "statement", "text": "For AWS, Azure and Google Cloud self-serve marketplace billing, subscribe in the cloud marketplace, complete its MongoDB account handoff, sign in to Atlas and explicitly link the intended Atlas organization. (medium confidence) (verified as of 2026-10-14)", "source_url": "https://www.mongodb.com/docs/atlas/billing/aws-self-serve-marketplace.md", "anchor": "", "page_class": "reference", "keywords": ["Linking Atlas orgs to marketplace billing accounts"], "code": null, "origin": "dr", "section": "facts", "relation": "about", "score": 1.0, "also": ["https://www.mongodb.com/docs/atlas/billing/azure-self-serve-marketplace.md", "https://www.mongodb.com/docs/atlas/billing/gcp-self-serve-marketplace.md"], "semantic_score": null, "pass": "keyword", "canonical_concept_id": "concept:b1b7637db58b4dc6c0fddc192499fe64be6a9b191476d3abf5c60774b74457d8", "validation_status": "SUPPORTED", "evidence_ids": ["ev:05ec0882123045d88da7c101b416240a17832b471c168a01e5783f8bc984f0af", "ev:e06a6962686ee36fa94bbcf10e0609a19a71b379fcbbd892906053530937ff0d", "ev:e1d993f411adc05ff9dbab885e8b595ebc64fd34eb1970598986b08e1f25abe3"]}
