          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-developer/#pool-monitoring-events",
          "note": null
        },
        {
          "text": "connectionPoolCreated / connectionPoolClosed",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-developer/#pool-monitoring-events",
