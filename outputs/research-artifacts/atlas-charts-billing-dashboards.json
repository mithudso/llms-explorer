      ]
    },
    {
      "id": "clm:fe9ce65edac671e7f418d6e29e87a8d23751842495c57758eef080bb20a4fbda",
      "text": "Release notes record a billing-ingestion payload-size fix in v1.45.0 and an older-invoice missing-line-items fix in v1.47.0. These are historical defects, not evidence that current dashboards still have those failures. (low confidence)",
      "source_url": "https://www.mongodb.com/docs/charts/release-notes.md",
      "also": [],
