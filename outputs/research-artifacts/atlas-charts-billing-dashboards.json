    },
    {
      "id": "clm:8ccac693cc4eada452d0a75f92db8b0d3fedbf221ba70c3f56f718b384d463e4",
      "text": "Tags support custom allocation charts and dashboard filters, including team and environment views; linked organizations can be filtered by organizationId. (medium confidence) (verified as of 2026-10-19)",
      "source_url": "https://www.mongodb.com/docs/charts/dashboards/manage-dashboards/billing-dashboards/",
      "also": [
