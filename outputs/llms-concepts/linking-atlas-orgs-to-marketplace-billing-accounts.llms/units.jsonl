{"id": "clm:d5389f67bee9a6e3849703ddf9016b4d82acd42d19b90a74ecea48dbd0088132", "type": "statement", "text": "The marketplace handoff actions differ: AWS uses Set Up Your Account, Azure uses Configure account now, and Google Cloud uses Register With MongoDB after selecting the billing account during purchase. (medium confidence) (verified as of 2026-10-14)", "source_url": "https://www.mongodb.com/docs/atlas/billing/aws-self-serve-marketplace.md", "anchor": "", "page_class": "reference", "keywords": ["Linking Atlas orgs to marketplace billing accounts"], "code": null, "origin": "dr", "section": "facts", "relation": "about", "score": 1.0, "also": ["https://www.mongodb.com/docs/atlas/billing/azure-self-serve-marketplace.md", "https://www.mongodb.com/docs/atlas/billing/gcp-self-serve-marketplace.md"], "semantic_score": null, "pass": "keyword", "canonical_concept_id": "concept:b1b7637db58b4dc6c0fddc192499fe64be6a9b191476d3abf5c60774b74457d8", "validation_status": "SUPPORTED", "evidence_ids": ["ev:60fa8c5844156a2904cbcb7643e1ce0fc0182d78b1c788736accf3192eda2f03", "ev:a3ccf472a4635d8cd1dbbd3f835bd15f0f79f3419829db332ac479348d55a907", "ev:ae9969801ca294fb5621de5e47e1fb97d97a96393533ff2ae1c179af57a5a0c5"]}
{"id": "clm:424770df3ae4710148f3926375d90f51df0eecc44e9999b5dd0b306309ec492d", "type": "statement", "text": "After organization selection, linking synchronizes asynchronously. The Atlas Payment Method field stays empty during synchronization and shows the provider-specific Marketplace Subscription value after success. (medium confidence) (verified as of 2026-10-14)", "source_url": "https://www.mongodb.com/docs/atlas/billing/aws-self-serve-marketplace.md", "anchor": "", "page_class": "reference", "keywords": ["Linking Atlas orgs to marketplace billing accounts"], "code": null, "origin": "dr", "section": "facts", "relation": "about", "score": 1.0, "also": ["https://www.mongodb.com/docs/atlas/billing/azure-self-serve-marketplace.md", "https://www.mongodb.com/docs/atlas/billing/gcp-self-serve-marketplace.md"], "semantic_score": null, "pass": "keyword", "canonical_concept_id": "concept:b1b7637db58b4dc6c0fddc192499fe64be6a9b191476d3abf5c60774b74457d8", "validation_status": "SUPPORTED", "evidence_ids": ["ev:2969dd97f7971a7cf703473ea6dbc7939c0e699dde6150213ce2f308a8d20d3b", "ev:cff87ddf10e66113bc915c708840054250a72973081f749dc7a123b659ca943a", "ev:df03a7744d3a97157512334b58a65e441b7798f59602630ccdaeb6c4bdc6530d"]}
