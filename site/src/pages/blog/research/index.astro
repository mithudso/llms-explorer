---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { articleDate, isPublishedArticle, isResearchArticle, newestFirst } from "../../../data/publication";

const title = "Research papers";
const description = "Implementation papers and empirical studies from the LLMSX blog, with methods, source evidence and limits.";
const papers = (await getCollection("blog"))
  .filter((entry) => isPublishedArticle(entry) && isResearchArticle(entry))
  .sort((a, b) => newestFirst(a, b) || a.data.title.localeCompare(b.data.title));
---
<Base title={title} description={description} route="/blog/research/" twin="/blog/research.md">
  <nav aria-label="Breadcrumb"><a href="/blog/">Blog</a> / Research papers</nav>
  <p class="lede">{description}</p>
  <nav class="blog-sections" aria-label="Blog sections">
    <a href="/blog/">All articles</a>
    <a href="/blog/research/" aria-current="page">Research papers</a>
    <a href="/research/">Find references by task</a>
  </nav>
  <p>Each paper states what was built or studied, what the evidence supports, and what remains uncertain. Editorial review improves the paper; it does not turn unverified source material into certified research.</p>
  {papers.length ? <ul class="card-grid">
    {papers.map((paper) => <li class="card">
      {articleDate(paper) && <time class="meta" datetime={articleDate(paper)}>{articleDate(paper)}</time>}
      <a class="card-title" href={`/blog/${paper.id}/`}>{paper.data.title}</a>
      <p>{paper.data.description}</p>
    </li>)}
  </ul> : <p>Reviewed papers will appear here as they are published.</p>}
  <section aria-labelledby="apply-research"><h2 id="apply-research">Put the research to work</h2>
    <p><a href="/research/">Find context by task</a> for source-linked reference files and related skills, or <a href="/tree/">browse the concept family tree</a>.</p>
  </section>
</Base>
<style>
  .blog-sections { display: flex; flex-wrap: wrap; gap: var(--sp-4); margin: var(--sp-4) 0 var(--sp-6); }
</style>
