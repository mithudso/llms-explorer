  "concept": "Salesforce Event Relay and external broker alternatives for case alerts",
  "slug": "salesforce-event-relay-and-external-broker-alternatives-for-case-alerts",
  "canonical_concept_id": "concept:27f29791e53af3db24d4d815e2067b70e5c30359da91792627a7ff5703e47d70",
