---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import CopyBlock from "../components/CopyBlock.astro";
import SkillDemo from "../components/SkillDemo.astro";
import { skillInstall } from "../data/skill-install";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { articleDate, isPublishedArticle, isResearchArticle } from "../data/publication";
export async function getStaticPaths() {
  const out = [];
  for (const c of ["reference", "examples", "blog", "skills"] as const) {
    for (const e of await getCollection(c)) {
      if (c === "blog" && !isPublishedArticle(e)) continue;
      out.push({ params: { slug: `${c}/${e.id}` }, props: { entry: e, collection: c } });
    }
  }
  return out;
}
const { entry, collection } = Astro.props;
const { Content } = await render(entry);

// Skill pages carry an install block and the full prompt. The installable
// copies live at <repo-root>/.claude/skills/<id>/SKILL.md — a container dir
// the explicit GitHub-directory install below selects, so the text shown is
// the selected source bundle. Some harnesses adapt frontmatter on install.
// Build runs from site/, hence the
// ../.claude/skills anchor; the second candidate covers a repo-root invocation.
let skillPrompt: string | null = null;
if (collection === "skills") {
  for (const base of ["../.claude/skills", ".claude/skills"]) {
    try {
      skillPrompt = readFileSync(resolve(process.cwd(), base, entry.id, "SKILL.md"), "utf8");
      break;
    } catch {
      skillPrompt = null;
    }
  }
}
const installCmd = skillInstall(entry.id);
const research = collection === "blog" && isResearchArticle(entry);
const publishedDate = collection === "blog" ? articleDate(entry) : "";
---
<Base title={entry.data.title} description={entry.data.description} route={`/${collection}/${entry.id}/`} noindex={entry.data.noindex} adEligible={collection !== "skills" && !entry.data.evidenceStatus}>
  {collection === "blog" && (
    <div class="article-context">
      <nav aria-label="Breadcrumb"><a href="/blog/">Blog</a>{research && <> / <a href="/blog/research/">Research papers</a></>}</nav>
      {publishedDate && <p>Published <time datetime={publishedDate}>{publishedDate}</time></p>}
      <p>Project article; see <a href="/editorial/">sources and editorial standards</a>.</p>
    </div>
  )}
  {entry.data.evidenceNote && (
    <aside class="evidence-notice" aria-label="Evidence status">
      <p><strong>{entry.data.evidenceStatus === "unverified" ? "Unverified evidence" : "Evidence note"}</strong></p>
      <p>{entry.data.evidenceNote}</p>
    </aside>
  )}
  <Content />
  {collection === "skills" && (
    <section class="skill-install">
      <h2 id="install">Install</h2>
      <p>
        Installable into any supported coding agent with the open
        <a href="https://github.com/vercel-labs/skills">skills CLI</a> — no signup, one command:
      </p>
      <CopyBlock text={installCmd} kind="install" label="Copy install command" item={entry.id} />
      <p>Compatibility: the skills CLI supports multiple coding agents. Requirements vary by skill; inspect the full prompt and its named tools first. An install command copies instructions; it does not install every integration the skill may use.</p>
      <p><a href="/workflows/maintain-agent-skills/">Try a small instruction review and before/after evaluation</a> · <a href="https://skills.sh/mithudso/llms-explorer">Browse the community directory listing</a></p>
      <p>
        Global and non-interactive: <code>{installCmd} -g -y</code>. Broader
        repository discovery: <code>npx skills add mithudso/llms-explorer --list</code>. The explicit directory above selects the version shown here.
      </p>
    </section>
  )}
  {collection === "skills" && skillPrompt && <SkillDemo id={entry.id} tags={entry.data.tags ?? []} prompt={skillPrompt} />}
  {collection === "skills" && skillPrompt && (
    <section class="skill-prompt">
      <h2 id="prompt">The prompt</h2>
      <p>
        The source <code>SKILL.md</code> from the exact install directory shown above.
        Some harnesses adapt metadata during installation. You can copy this source
        into your agent’s skills directory; inspect its supporting files and prerequisites too.
      </p>
      <details data-skill-prompt={entry.id}>
        <summary>Show SKILL.md ({Array.from(skillPrompt).length.toLocaleString()} chars)</summary>
        <CopyBlock text={skillPrompt} label="Copy full prompt" item={entry.id} />
      </details>
    </section>
  )}
</Base>

<style>
  .article-context { margin-bottom: var(--sp-5); color: var(--ink-muted); font-size: var(--step--1); }
  .article-context p { margin-bottom: var(--sp-2); }
  .evidence-notice { margin-bottom: var(--sp-6); padding: var(--sp-4) var(--sp-5); border: 1px solid var(--line-strong); border-left: 3px solid var(--accent); border-radius: var(--radius); background: var(--paper-raised); }
  .evidence-notice p { margin-bottom: var(--sp-2); }
  .evidence-notice p:last-child { margin-bottom: 0; }
</style>
