    {
      "title": "Problems, failure modes and limitations",
      "facts": [
        {
          "text": "Temporary-project deletion can fail with CANNOT_CLOSE_GROUP_ACTIVE_ATLAS_CLUSTERS while a cluster is still shutting down. The tutorial instructs waiting five minutes and retrying project deletion, then checking the project list. (low confidence)",
          "source": "https://www.mongodb.com/docs/atlas/cli/current/atlas-cli-temporary-cluster.md",
          "note": null,
          "claimId": "clm:5433479ab2fbebdff6a2ad551e67009ace85859f67a8160b1682fab18b8cecb4",
          "validationStatus": "SUPPORTED",
          "evidenceIds": [
