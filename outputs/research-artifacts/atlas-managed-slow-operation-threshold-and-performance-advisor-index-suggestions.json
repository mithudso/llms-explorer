        "ev:93ad44b25158b487fde32103c7daea92af18d98ef11e848bb294272b7e78b1c5"
      ]
    },
    {
      "id": "clm:d048d778be48d695f81e5d77606038703d3db3e4da222d5760002f1b3bbfa8b4",
      "text": "Performance Advisor suggests indexes from observed slow queries; suggestions reflect captured workload rather than every possible query. (medium confidence) (verified as of 2026-10-30)",
      "source_url": "https://www.mongodb.com/docs/atlas/performance-advisor.md",
      "also": [
        "https://oneuptime.com/blog/post/2026-03-31-mongodb-atlas-query-profiler-cloud/view",
