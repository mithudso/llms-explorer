    {
      "title": "Bayesian MMM",
      "facts": [
        {
          "text": "Treats all parameters (baseline, channel betas, adstock alpha, saturation shape)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/da-22-marketing-mix-modeling/#bayesian-mmm",
          "note": null
        },
        {
          "text": "as distributions. Advantages: encodes priors from domain knowledge / past lift",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/da-22-marketing-mix-modeling/#bayesian-mmm",
          "note": null
        },
        {
          "text": "tests, produces full posterior uncertainty (credible intervals on ROI), and",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/da-22-marketing-mix-modeling/#bayesian-mmm",
          "note": null
        },
        {
          "text": "supports hierarchical / geo-level pooling. Sampling via NUTS/HMC (PyMC,",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/da-22-marketing-mix-modeling/#bayesian-mmm",
          "note": null
        },
        {
          "text": "TensorFlow Probability). Frequentist MMM (ridge regression, e.g. Robyn) instead",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/da-22-marketing-mix-modeling/#bayesian-mmm",
          "note": null
        },
        {
          "text": "penalizes coefficients to handle multicollinearity among correlated channels.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/da-22-marketing-mix-modeling/#bayesian-mmm",
          "note": null
        }
      ]
