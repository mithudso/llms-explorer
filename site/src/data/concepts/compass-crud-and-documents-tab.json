          ]
        },
        {
          "text": "COMPASS-8337 reported that JSON replacement in Compass 1.44.4 silently converted integer-valued Double fields to Int32. The ticket records a fix in 1.46.7. (low confidence)",
          "source": "https://jira.mongodb.org/browse/COMPASS-8337",
