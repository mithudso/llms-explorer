{
  "name": "llms-explorer-site",
  "type": "module",
  "version": "0.0.15",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "../hub/.venv/bin/python tools/gen_downloads.py --package-only && ../hub/.venv/bin/python tools/gen_tree.py && ../hub/.venv/bin/python tools/gen_context.py && ../hub/.venv/bin/python tools/gen_concept_facts.py",
    "build": "astro build",
    "check": "astro check",
    "edge:dev": "npx --yes wrangler@4 pages dev dist",
    "e2e:passkey": "bash tests/e2e/passkey.sh",
    "postbuild": "../hub/.venv/bin/python tools/twins.py && ../hub/.venv/bin/python tools/build_llms.py && ../hub/.venv/bin/python tools/build_sitemap.py && ../hub/.venv/bin/python tools/prune_dist.py && ../hub/.venv/bin/python tools/check_publication.py",
    "generate": "../hub/.venv/bin/python tools/gen_reference.py && ../hub/.venv/bin/python tools/gen_tree.py && ../hub/.venv/bin/python tools/gen_context.py && ../hub/.venv/bin/python tools/gen_concept_facts.py",
    "research:sync": "../hub/.venv/bin/python ../scripts/research_site_sync.py --apply",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "astro": "^7.4.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "puppeteer-core": "25.14.0",
    "typescript": "^6.0.3"
  }
}
