        "https://developer.salesforce.com/docs/platform/api-rest/guide/resources-query.html",
        "https://developer.salesforce.com/docs/platform/api/guide/sforce-api-calls-getupdated-getupdatedresult.html",
        "https://developer.salesforce.com/docs/platform/change-data-capture/guide/cdc-replication-steps.html",
        "https://developer.salesforce.com/docs/platform/change-data-capture/guide/cdc-when-to-use.html",
        "https://developer.salesforce.com/docs/platform/pub-sub-api/guide/event-message-durability.html",
        "https://docs.confluent.io/cloud/current/connectors/cc-salesforce-source-cdc.html",
        "https://estuary.dev/blog/salesforce-change-data-capture/",
        "https://www.crmview.net/salesforce-integration-using-changed-data-capture-cdc/",
        "https://www.outofmemo.com/articles/salesforce-cdc-change-event-header-fields"
      ],
