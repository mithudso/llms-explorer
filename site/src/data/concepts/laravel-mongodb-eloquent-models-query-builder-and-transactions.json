            "ev:fd361afe0d26c13e3b59ed0906565f32b0458baaff9ff8a85f43d1c6013af164"
          ]
        },
        {
          "text": "Configure attribute conversions with `$casts`; the documented model example casts a BSON date field to Laravel `datetime`. Allow-list mass-assignable fields with `$fillable`, or exclude fields with `$guarded`. (low confidence)",
          "source": "https://www.mongodb.com/docs/drivers/php/laravel-mongodb/current/model-data/model-class.md",
          "note": null,
