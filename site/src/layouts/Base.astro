---
const { title, description, route, twin: twinProp } = Astro.props;
// Content pages carry a `.md` twin at the same route; the generated listing
// pages (home, section indexes) pass `twin={null}` because twins.py writes a
// twin only for `src/content/**`, and a link to a file that is not published
// is worse than no link.
const twin = twinProp === undefined ? route.replace(/\/$/, "") + ".md" : twinProp;
---
<html lang="en"><head>
  <meta charset="utf-8" /><title>{title}</title><meta name="description" content={description} />
  {twin && <link rel="alternate" type="text/markdown" href={twin} />}
  <link rel="describedby" href="/llms.txt" />
</head><body>
  <nav><a href="/">LLMS-Explorer</a> · <a href="/reference/">Reference</a> · <a href="/essays/">Essays</a> · <a href="/examples/">Examples</a> · <a href="/blog/">Blog</a> · <a href="/llms.txt">llms.txt</a>{twin && <> · <a href={twin}>.md</a></>}</nav>
  <main><h1>{title}</h1><slot /></main>
</body></html>
