  "narrative": [
    {
      "assertionId": "prose:20e86c5f5b69bcaabc9bbc98fef7fe754ab8fd0ed3ad7a8add59ae8eddd2166b",
      "statementSha256": "20e86c5f5b69bcaabc9bbc98fef7fe754ab8fd0ed3ad7a8add59ae8eddd2166b",
      "assertionKind": "summary",
