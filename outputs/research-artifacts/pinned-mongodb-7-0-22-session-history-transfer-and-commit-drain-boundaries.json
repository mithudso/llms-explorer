      "id": "clm:dac700f643f80f4038099f8ea9583bbddb05b3cf64bda401194cbf57ee898f91",
      "text": "The donor scans the session transaction table for parent-session records without a transaction UUID and committed internal sessions that contain a parent transaction number. It sorts session identifiers descending, skips histories whose parent transaction number is below the previously observed maximum for that parent, and creates history iterators only for non-null last-write times. The filter excludes aborted, prepared and in-progress retryable internal transactions, and all non-retryable internal sessions. (low confidence)",
      "source_url": "https://raw.githubusercontent.com/mongodb/mongo/dacdbc3df2fbe579b03336a2f01fc9aedf406a41/src/mongo/db/s/session_catalog_migration_source.cpp",
      "also": [
        "https://api.github.com/repos/mongodb/mongo/git/ref/tags/r7.0.22",
        "https://api.github.com/repos/mongodb/mongo/git/tags/ef98696d6009abf1b6f73a935c9f7bb3fa3ea4c4",
        "https://www.mongodb.com/docs/v7.0/release-notes/7.0/"
      ],
      "validation_status": "SUPPORTED",
