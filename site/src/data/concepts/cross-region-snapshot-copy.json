            "ev:a7cf9347332532c2d5f2ab89bcab31db6188a7fceb87db0fcfc98c82e72b884f"
          ],
          "remediation": {
            "schema": "claim-remediation-projection/v1",
            "record": "remediation.json",
            "requires_revalidation": true,
            "claim_text_sha256": "85b51ffcfbe4844c194c7451ce1b68dc62a94daf785459eeac09913fc0619701"
          }
        },
        {
          "text": "Atlas bills cross-region data transfer and additional backup-copy storage. MongoDB estimates that copying all backups to one additional region costs approximately twice the storage, with actual storage costs varying by region; selective copies and shorter copy retention can reduce unnecessary copy storage. (medium confidence) (verified as of 2026-10-20)",
          "source": "https://www.mongodb.com/docs/atlas/billing/cluster-configuration-costs/",
          "note": null,
          "claimId": "clm:7fafa549ce5f50bb939ba6b38030bb17162b6dec3c83724411bb2ecf8ea5c233",
          "validationStatus": "SUPPORTED",
