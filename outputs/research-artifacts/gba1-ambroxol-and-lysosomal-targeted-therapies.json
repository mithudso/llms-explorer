    {
      "assertionId": "prose:0eecb03b37193700405fe3ec34e87c46b887a3ca14628c6357e195225456fa70",
      "statementSha256": "0eecb03b37193700405fe3ec34e87c46b887a3ca14628c6357e195225456fa70",
      "assertionKind": "disagreement",
      "index": 1,
      "documentSlug": "gba1-ambroxol-and-lysosomal-targeted-therapies",
      "documentConcept": "GBA1, ambroxol and lysosomal-targeted therapies",
      "canonicalConceptId": "concept:cc458689f4ddeccea1e9f5808b6bc969df0e17b8ec99f4b3d68a7790cf194a8e",
      "text": "Mullin et al. cite reports that ambroxol increases GCase enzyme activity, yet measured a 19% decrease in CSF GCase activity alongside a 35% increase in CSF GCase protein levels.",
      "sources": [
        "https://pmc.ncbi.nlm.nih.gov/articles/PMC6990847/"
