      ]
    },
    {
      "id": "clm:4d3fa3e734764712404019a34522a8efe29a1ec8bf2933205f97d8e2f4c4b3c6",
      "text": "Meta-analyses differ on UPDRS motor scores and freezing of gait for music-based therapy and RAS in Parkinson's disease: one meta-analysis (K = 6 studies, total N = 168) found no significant effects for UPDRS-motor score or Freezing of Gait, whereas Ye and colleagues (18 studies) report significant pooled improvements in UPDRS-III and in the Freezing of Gait Questionnaire. (high confidence)",
      "source_url": "https://pubmed.ncbi.nlm.nih.gov/22166406/",
      "also": [
        "https://pmc.ncbi.nlm.nih.gov/articles/PMC9366143/"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:009be651e7da7f4d42887395cf16b3de345a7d04dd1c53cfbe70d0bcf18bd018",
        "ev:0d3d3bcd39de487f7654e146f7c89ac4e1a352c021eed39b58938f40e1e9d032",
        "ev:197222fd87bcdcc54a6556bcc46c509ed8272384ee91528fab395370323a0101",
