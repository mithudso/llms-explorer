    {
      "title": "Serverless History (Deprecated)",
      "facts": [
        {
          "text": "Serverless used RPU (Read Processing Unit) / WPU (Write Processing Unit) per-document billing. Caused runaway charges for unindexed queries. Cold starts after ~5 minutes idle (30-60 second reconnect delay). Replaced by Flex due to unpredictable billing, cold start latency, and feature gaps.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-flex-serverless/#serverless-history-deprecated",
          "note": null
        }
      ]
    },
    {
      "title": "Anti-Patterns",
      "facts": [
        {
          "text": "Flex for production with PrivateLink requirement: Must use M10+ for private endpoints",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-flex-serverless/#anti-patterns",
          "note": null
        },
        {
          "text": "Production Vector Search on Flex: Resource contention causes latency spikes",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-flex-serverless/#anti-patterns",
          "note": null
        },
        {
          "text": "Expecting PITR on Flex: Daily snapshots only",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-flex-serverless/#anti-patterns",
          "note": null
        },
        {
          "text": "Pinning MongoDB version on Flex: Flex auto-upgrades - use dedicated for version pinning",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-flex-serverless/#anti-patterns",
          "note": null
        },
        {
          "text": "Overbuilding M10 for dev/staging: Flex handles dev/staging at 1/7th the cost",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-flex-serverless/#anti-patterns",
          "note": null
        }
      ]
    },
    {
      "title": "Free Tier (M0) vs. Flex",
      "facts": [
        {
          "text": "M0 auto-pauses after 30 days idle (cold start on resume). Flex never pauses - more suitable for always-on dev/staging environments.",
