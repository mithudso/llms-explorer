    {
      "title": "7.1 Operational Transformation",
      "facts": [
        {
          "text": "Uses OT (not CRDT). Last-write-wins for scalars by server timestamp. List operations preserve intent of both writes where possible.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-device-sdk/#71-operational-transformation",
          "note": null,
          "level": 0
        },
        {
          "text": "Custom resolvers are not supported at field level. Influence conflict behavior via:",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-device-sdk/#71-operational-transformation",
          "note": null,
          "level": 0
        },
        {
          "text": "Asymmetric sync - no conflict possible (write-only)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-device-sdk/#71-operational-transformation",
          "note": null,
          "level": 1
        },
        {
          "text": "Embedded objects - parent subtree treated atomically",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-device-sdk/#71-operational-transformation",
          "note": null,
          "level": 1
        },
        {
          "text": "Server-side Atlas Triggers - reactive post-sync reconciliation",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-device-sdk/#71-operational-transformation",
          "note": null,
          "level": 1
        },
        {
          "text": "Schema design - append to lists rather than update indexes",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-device-sdk/#71-operational-transformation",
          "note": null,
          "level": 1
        }
      ]
    },
    {
      "title": "7.3 Conflict Design Patterns",
      "facts": [
        {
          "text": "Append to lists rather than update indexed positions",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-device-sdk/#73-conflict-design-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Use @MapTo (Java/legacy Kotlin) or @PersistedName (modern Kotlin SDK) for canonical Atlas field names",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-device-sdk/#73-conflict-design-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Prefer embedded objects for sub-documents (atomic parent update)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-device-sdk/#73-conflict-design-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "High-frequency telemetry → asymmetric sync (no conflict surface)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-device-sdk/#73-conflict-design-patterns",
          "note": null,
          "level": 0
        }
      ]
