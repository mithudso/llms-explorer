    {
      "title": "Stopping criteria",
      "facts": [
        {
          "text": "Stop when: (1) new sources repeat known information, (2) every sub-question has 2–3+ independent sources, (3) contradictions are identified even if unresolved, (4) the next search is unlikely to change conclusions.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/deep-research-methods/#stopping-criteria",
          "note": null
        }
      ]
    },
    {
