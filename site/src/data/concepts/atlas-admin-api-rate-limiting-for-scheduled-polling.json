  "facets": [
    {
      "title": "Structure and components",
      "facts": [
        {
          "text": "Schedule periodic polling with a stable per-worker offset to spread synchronized cron bursts, and cap retries at one layer; Amazon documents both practices from operational experience. (low confidence)",
          "source": "https://aws.amazon.com/builders-library/timeouts-retries-and-backoff-with-jitter/",
          "note": null,
