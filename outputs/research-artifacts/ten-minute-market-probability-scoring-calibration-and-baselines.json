    },
    {
      "id": "clm:64492d22c871ae93d5a3ca4e9d17e710af0fb4cd587a9cf87673c7966072e0fd",
      "text": "Binary log loss is the negative log likelihood of the observed label under the predicted probability. (low confidence)",
      "source_url": "https://scikit-learn.org/stable/modules/model_evaluation.html",
      "also": [],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
