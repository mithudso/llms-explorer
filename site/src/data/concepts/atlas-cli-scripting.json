          }
        },
        {
          "text": "The official Atlas CLI GitHub Action README states that it defaults to the latest CLI, accepts a version input, officially supports only the latest version, and supports only Linux runners. (low confidence) (verified as of 2026-10-23)",
          "source": "https://github.com/mongodb/atlas-github-action",
          "note": null,
          "claimId": "clm:f27daba1c189353358be58acb4eca22cd4fa550f6befb5255734ace4e46dcc54",
          "validationStatus": "SUPPORTED",
