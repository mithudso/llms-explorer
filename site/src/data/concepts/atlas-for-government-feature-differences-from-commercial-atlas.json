          ]
        },
        {
          "text": "AtlasGov does not support driver-native Search index management commands; its Search guide specifies the Atlas Administration API or Atlas CLI for managing Search indexes. (low confidence) (verified as of 2026-11-06)",
          "source": "https://www.mongodb.com/docs/atlas/government/atlas-search.md",
          "note": null,
          "claimId": "clm:e1fe29d947f0070bc22a04496aeb04f3dfaf25403d405351c625716bfbce0d5f",
