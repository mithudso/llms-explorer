    {
      "id": "clm:21ca326f4892437797d757d3a5cd3c88be35c5b5d3389a0d59b6b582bc11438c",
      "text": "The recipient migrated-entry counter measures processed incoming records, including records that may be skipped before local logging. Its header explicitly says that processed entries need not equal committed entries. The older-transaction fixture asserts a processed-entry count even though the newer local history is retained. This counter must not be treated as a count of committed transferred records. (high confidence)",
      "source_url": "https://raw.githubusercontent.com/mongodb/mongo/dacdbc3df2fbe579b03336a2f01fc9aedf406a41/src/mongo/db/s/session_catalog_migration_destination.cpp",
