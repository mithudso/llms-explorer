---
import Base from "../../layouts/Base.astro";
import TreeBrowser from "../../components/TreeBrowser.astro";
import SearchBox from "../../components/SearchBox.astro";
import { tree } from "../../data/tree";
import { context } from "../../data/context";
import type { ConceptPack } from "../../data/types";

const has3d = Object.keys(import.meta.glob("./3d.astro")).length > 0;
const nodes = tree.nodes;
// Match public routes to their actual content, including when generated tree
// metadata's hasPack flag is stale. This is an availability check, not a review.
const packs = import.meta.glob<{ default: ConceptPack }>("../../data/concepts/*.json", { eager: true });
const referenceSlugs = new Set(Object.entries(packs)
  .filter(([, { default: pack }]) => pack.summary?.trim() &&
    pack.facets?.some((facet) => facet.facts?.some((fact) =>
      fact.text?.trim() && fact.source?.trim())))
  .map(([path]) => (path.split("/").pop() ?? "").replace(/\.json$/, ""))
  .filter((slug) => Boolean(nodes[slug])));

const esc = (s: unknown) =>
  String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

// Facts and facet counts per researched concept, from the same context.json
// the /context/ page lists, so the number a branch shows inline is the number
// the facts file actually holds.
const counts = new Map<string, { facts: number; facets: number; download: string }>();
for (const root of context.roots)
  for (const c of root.concepts) counts.set(c.slug, { facts: c.facts, facets: c.facets, download: c.download });

// One `seen` set for the whole walk, exactly as the hub-manager Concepts tab
// does it: a concept named under two parents is drawn once, and a name cycle
// cannot make the recursion run forever.
//
// Every node is a <details>: clicking a name expands its children in place
// and opens the concept in the facts panel beside the tree (TreeBrowser.astro
// fetches the same /downloads/concepts/<slug>.md the facts.md link serves).
// The inline body stays one line, so the tree reads as a tree.
//
// The count beside a name is what the reader will find on opening it: the
// children drawn directly under it here, and every concept drawn anywhere
// below it. A child already drawn under another parent is not drawn twice,
// so it is not counted twice either.
const seen = new Set<string>();
const fmt = (n: number) => n.toLocaleString("en-US");
function branch(slug: string): { html: string; total: number } {
  const node = nodes[slug];
  if (!node || seen.has(slug)) return { html: "", total: 0 };
  seen.add(slug);
  let direct = 0;
  let total = 0;
  let frontierKids = 0;
  const kids = node.children
    .map((c) => {
      if (c.state === "frontier") {
        direct += 1;
        total += 1;
        frontierKids += 1;
        return `<li class="frontier" data-slug="${esc(c.slug)}" data-concept="${esc(c.concept)}">` +
          `<span title="frontier: named as a child but not yet researched">${esc(c.concept)} <em>(frontier)</em></span></li>`;
      }
      const sub = branch(c.slug);
      if (sub.html) {
        direct += 1;
        total += 1 + sub.total;
      }
      return sub.html;
    })
    .join("");
  const n = counts.get(slug);
  const hasReference = referenceSlugs.has(slug);
  const meta = [
    hasReference && n ? `${n.facts} facts in ${n.facets} facet${n.facets === 1 ? "" : "s"}` : "",
    hasReference ? "published reference" : node.state === "domain" ? "topic group" : "topic entry",
    frontierKids ? `${frontierKids} frontier` : "",
  ].filter(Boolean).join(" · ");
  const body =
    `<div class="node-body">` +
    `<p class="node-meta">${esc(meta)}` +
    ` · <a href="/tree/${esc(node.slug)}/" class="node-open">${hasReference ? "read reference" : "browse topic"}</a>` +
    (hasReference && n ? ` · <a href="${esc(n.download)}" class="node-open" download>facts.md</a>` : "") +
    `</p></div>`;
  const countText = !direct ? "" : total > direct
    ? `${fmt(direct)} children · ${fmt(total)} total`
    : `${fmt(direct)} ${direct === 1 ? "child" : "children"}`;
  const label = `<span class="node-name">${esc(node.concept)}</span>` +
    (hasReference ? ` <span class="haspack" title="facts file available">●</span>` : "") +
    (countText ? ` <span class="node-count" title="${esc(`${direct} drawn directly under this concept, ${total} concepts anywhere below it`)}">${countText}</span>` : "");
  // gen_concept_facts.py writes one facts file per pack, so every published
  // reference has one even before context.json lists it.
  const facts = hasReference ? ` data-facts="${esc(n?.download ?? `/downloads/concepts/${slug}.md`)}"` : "";
  return {
    html: `<li data-slug="${esc(slug)}" data-concept="${esc(node.concept)}"${facts}>` +
      `<details><summary>${label}</summary>${body}${kids ? `<ul>${kids}</ul>` : ""}</details></li>`,
    total,
  };
}

const list = `<ul id="tree-list">${tree.roots.map((s) => branch(s).html).join("")}</ul>`;
// `</script>` cannot appear inside a <script> element, whatever the type — and a
// concept name is text a person or a research run wrote, not a constant. Same
// escape as Tree3D.astro and DirectoryTable.astro.
const payload = JSON.stringify(tree).replace(/</g, "\\u003c");
// Nodes no root reaches would otherwise render nowhere at all — invisible
// rather than absent, which is the one thing a map may not be.
const unreachable = Object.keys(nodes).filter((s) => !seen.has(s)).sort();

// The facts panel's "Research this concept" button calls the API. Same origin
// rule as AccountNav.astro, so the default host stays in agreement with it.
const api = String(import.meta.env.PUBLIC_API_URL || "https://api.llms-explorer.com").replace(/\/+$/, "");

const title = "Concepts";
const description = `${referenceSlugs.size} published reference${referenceSlugs.size === 1 ? "" : "s"} in a map of ${Object.keys(nodes).length} topics under ${tree.roots.length} roots — generated ${tree.generated}.`;
---
<Base title={title} description={description} route="/tree/">
  <p class="lede">Browse published references and the topic map that connects them.</p>
  <p class="tab-note">
    <strong>Concepts</strong> is for browsing: click any name to open its children in place and
    show its facts file in the panel beside the tree. A <span class="haspack">●</span> marks a
    concept with a facts file. The grey count is what opening it reveals: the children drawn
    directly under it, then every concept below it. Topic groups without facts still open to
    show their branches.
    <a href="/context/">Context files</a> is the other tab: the same concept research as a shelf of facts files
    to load, sized in tokens.
  </p>
  <p>
    A <strong>frontier</strong> name has no topic node of its own. The map derives these names
    from unresolved <code>childConcepts</code> and unchecked entries in the snapshotted
    research queue. Frontier names indicate work to investigate, not published references.
    <a href="/reference/concept-tree/">How to read this</a>.
  </p>
  <p class="proof">
    {referenceSlugs.size} published {referenceSlugs.size === 1 ? "reference" : "references"} · {Object.keys(nodes).length - referenceSlugs.size} topic entries
    · {tree.frontier.length} frontier names · {tree.roots.length} roots · snapshot {tree.generated}
    {has3d && <> · <a href="/tree/3d/">3D view</a></>}
  </p>

  <SearchBox />

  <script type="application/json" id="tree-data" set:html={payload} />
  <TreeBrowser />
  <div class="tree-layout">
    <div class="tree-col"><Fragment set:html={list} /></div>
    <aside id="facts-panel" class="facts-panel" aria-live="polite" data-api={api}>
      <p class="facts-empty">Click a concept to read its facts here.</p>
    </aside>
  </div>

  {unreachable.length > 0 && (
    <>
      <h2>Not reachable from any root</h2>
      <ul>
        {unreachable.map((s) => (
          <li><a href={`/tree/${s}/`}>{nodes[s]?.concept ?? s}</a></li>
        ))}
      </ul>
    </>
  )}
</Base>
