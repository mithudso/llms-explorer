      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:4db4373dd9e9be59fa7cade05484d7c824223b0d5caa586e52bdd890bca51396",
        "ev:8452a1b506fce9667fd1906977dd4ec5eca14a80da46ba07d2e08ad75e30ac1b"
      ],
      "temporal": {
        "applicability_version": "1292483d33fe97513c41e0e67020e4438deb3f69"
      }
    },
    {
      "id": "clm:af9d1d3f47f0f7d62f65c52a1bd494eb38ccd4087708e3378b9bf243668cb6f8",
      "text": "A newer request for the same stage aborts its predecessor before awaiting its own inputs. The mocked older-request fixture resolves the older pipeline after creating the newer request and asserts an AbortError for the older request, fulfillment for the newer request, one aggregate call, and a remembered pipeline equal to the newer pipeline. (high confidence)",
      "source_url": "https://raw.githubusercontent.com/mongodb-js/compass/1292483d33fe97513c41e0e67020e4438deb3f69/packages/compass-aggregations/src/modules/pipeline-builder/pipeline-preview-manager.ts",
      "also": [
