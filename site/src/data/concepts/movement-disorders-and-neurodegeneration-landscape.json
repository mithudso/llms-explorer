    {
      "title": "Comparisons and alternatives",
      "facts": [
        {
          "text": "Beach and Adler report that autopsy-validated studies found misdiagnosis common in early clinically diagnosed Parkinson’s disease compared with patients followed for years. (low confidence)",
          "source": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6544441/",
