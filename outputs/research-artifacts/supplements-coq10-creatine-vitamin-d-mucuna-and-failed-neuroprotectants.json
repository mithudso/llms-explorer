        "ev:e76629e7a05f56866093ef95b5a5295dbffb54eb7f4452ed10db04e913cee04e"
      ]
    },
    {
      "id": "clm:67814ffc3449e861519f201738d321dae364b016fd399d42262277410d6a451d",
      "text": "Reports on vitamin D supplementation and motor outcomes in Parkinson disease are mixed: a double-blind placebo-controlled trial (114 patients; vitamin D3 1200 IU/d for 12 months; Am J Clin Nutr 2013) reported that vitamin D3 significantly prevented deterioration of the Hoehn and Yahr stage (P = 0.005), a 2025 meta-analysis of 8 randomized trials (646 cases) found no reduction in UPDRS part III but a benefit on 6-Minute walking test distance, and a 2026 randomized trial (2000 IU/d for 12 weeks) reported no significant improvement in motor function; a 2026 review judged that firm conclusions on the disease-modifying potential of vitamin D cannot yet be drawn. (high confidence) (verified as of 2026-11-27)",
      "source_url": "https://pubmed.ncbi.nlm.nih.gov/23485413/",
      "also": [
        "https://pmc.ncbi.nlm.nih.gov/articles/PMC12183021/",
        "https://pmc.ncbi.nlm.nih.gov/articles/PMC13406316/",
        "https://pmc.ncbi.nlm.nih.gov/articles/PMC13442935/"
