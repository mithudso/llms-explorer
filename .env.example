# ==============================================================================
# LLMS-Explorer Environment Variables Example
# Copy to environment or export before running services.
# ==============================================================================

# --- Database & Storage -------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/explorer_dev
STORES_ROOT=~/.llms-explorer/stores

# --- Auth & Sessions ---------------------------------------------------------
# Must be at least 32 characters long
SESSION_SECRET=change-this-to-a-very-long-random-secret-key-at-least-32-chars
ENVIRONMENT=dev

# --- Allowed Origins & Hosts -------------------------------------------------
SITE_ORIGINS=https://llms-explorer.com,https://www.llms-explorer.com,http://localhost:4321
ALLOWED_HOSTS=api.llms-explorer.com,llms-explorer.com,localhost,127.0.0.1,testserver,test,*.test

# --- OAuth (Optional in dev, required for provider logins) -------------------
OAUTH_GITHUB_ID=
OAUTH_GITHUB_SECRET=
OAUTH_GOOGLE_ID=
OAUTH_GOOGLE_SECRET=

# --- WebAuthn / Passkeys ------------------------------------------------------
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=

# --- Stripe Billing -----------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# --- Global AI Hub & Ollama ---------------------------------------------------
HUB_MCP_URL=http://127.0.0.1:8787
HUB_OLLAMA_URLS=http://127.0.0.1:11434
HUB_EMBED_MODEL=mxbai-embed-large
HUB_REFINE_LLM_MODEL=qwen3.5:35b
