  "slug": "mongodb-compliance-and-regulatory",
  "concept": "MongoDB Compliance and Regulatory",
  "generated": "2026-09-08",
  "summary": "| Framework | Status | Notes |",
  "facets": [
    {
      "title": "Shared Responsibility Model",
      "facts": [
        {
          "text": "MongoDB manages: physical security, host OS patching, database process, network isolation, encryption at rest (default), TLS in transit, automated backups, availability zones.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#shared-responsibility-model",
          "note": null,
          "level": 0
        },
        {
          "text": "Customer manages: database users and access control, application-layer authorization, network access lists, audit log configuration, data classification, application-level encryption (CSFLE/QE).",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#shared-responsibility-model",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "BAA (Business Associate Agreement)",
      "facts": [
        {
          "text": "A BAA is required for any covered entity or business associate storing PHI in Atlas. MongoDB offers a BAA for Atlas. The BAA covers Atlas-managed clusters only.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#baa-business-associate-agreement",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "PHI Protection Patterns",
      "facts": [
        {
          "text": "Encryption at rest: Default AES-256 (MongoDB-managed) or BYOK (AWS/Azure/GCP KMS) for additional control",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#phi-protection-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Encryption in transit: TLS 1.2+ required; TLS 1.3 supported",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#phi-protection-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Field-level encryption: Use Client-Side Field Level Encryption (CSFLE) or Queryable Encryption (QE) for PHI fields that need column-level protection",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#phi-protection-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Access control: Dedicated database users per application component; minimal roles (principle of least privilege)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#phi-protection-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Audit logging: Enable Atlas database auditing - log all authenticate, authCheck, createCollection, dropDatabase events",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#phi-protection-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Backup compliance: Enable Backup Compliance Policy (BCP) to prevent backup deletion",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#phi-protection-patterns",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "HIPAA-Required Cluster Features",
      "facts": [
        {
          "text": "M10+ dedicated cluster (required for HIPAA)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#hipaa-required-cluster-features",
          "note": null,
          "level": 0
        },
        {
          "text": "Encryption at rest enabled (default or BYOK)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#hipaa-required-cluster-features",
          "note": null,
          "level": 0
        },
        {
          "text": "Database auditing enabled",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#hipaa-required-cluster-features",
          "note": null,
          "level": 0
        },
        {
          "text": "IP allowlist or private endpoints (no 0.0.0.0/0)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#hipaa-required-cluster-features",
          "note": null,
          "level": 0
        },
        {
          "text": "MFA on Atlas user accounts (all project members)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#hipaa-required-cluster-features",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "Applicable Atlas Requirements",
      "facts": [
        {
          "text": "Requirement 2 (Secure Configuration): Use private endpoints or VPC peering; no default/test database users; rename admin user.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#applicable-atlas-requirements",
          "note": null,
          "level": 0
        },
        {
          "text": "Requirement 3 (Cardholder Data Protection):",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#applicable-atlas-requirements",
          "note": null,
          "level": 0
        },
        {
          "text": "Never store full PAN in plaintext - use Queryable Encryption or CSFLE with AES-256 for PAN fields",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#applicable-atlas-requirements",
          "note": null,
          "level": 1
        },
        {
          "text": "Use $regex on QE fields to verify card data format without decrypting",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#applicable-atlas-requirements",
          "note": null,
          "level": 1
        },
        {
          "text": "Purge SAD (Sensitive Authentication Data) after authorization - TTL index on SAD fields",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#applicable-atlas-requirements",
          "note": null,
          "level": 1
        },
        {
          "text": "Requirement 4 (Encryption in Transit): TLS 1.2+ for all client connections. Atlas enforces TLS by default.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#applicable-atlas-requirements",
          "note": null,
          "level": 0
        },
        {
          "text": "Requirement 7 (Restrict Access): Principle of least privilege for database users. Custom roles scoped to specific databases and collections.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#applicable-atlas-requirements",
          "note": null,
          "level": 0
        },
        {
          "text": "Requirement 8 (Authentication): MFA on Atlas UI and API; SCRAM-SHA-256 or X.509 for database access; no shared credentials.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#applicable-atlas-requirements",
          "note": null,
          "level": 0
        },
        {
          "text": "Requirement 10 (Audit Logging): Atlas database auditing must be enabled. Audit: authenticate, authCheck, createUser, dropUser, createCollection, dropCollection, createIndex.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#applicable-atlas-requirements",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "FedRAMP High (AtlasGov)",
      "facts": [
        {
          "text": "AtlasGov is a separate deployment of MongoDB Atlas on Azure Government regions designed to meet FedRAMP High, DoD IL2/IL4/IL5 requirements.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#fedramp-high-atlasgov",
          "note": null,
          "level": 0
        },
        {
          "text": "Control plane: cloud.mongodbgov.com (separate from cloud.mongodb.com)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#fedramp-high-atlasgov",
          "note": null,
          "level": 1
        },
        {
          "text": "Supported regions: AZURE_US_GOV_VIRGINIA, AZURE_US_GOV_ARIZONA",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#fedramp-high-atlasgov",
          "note": null,
          "level": 1
        },
        {
          "text": "Terraform: Set MONGODB_ATLAS_GOV_BASE_URL=https://cloud.mongodbgov.com/ or use mongodbatlas_cluster with government_region_name",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#fedramp-high-atlasgov",
          "note": null,
          "level": 1
        },
        {
          "text": "AtlasGov is not accessible from standard Atlas accounts - requires a separate Atlas for Government account.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#fedramp-high-atlasgov",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "Key Obligations",
      "facts": [
        {
          "text": "Data Residency: Data must stay in the EU jurisdiction. Options:",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#key-obligations",
          "note": null,
          "level": 0
        },
        {
          "text": "Single-region Atlas cluster in EU: Simplest; all data in EU regions (e.g., EU_WEST_1, EU_CENTRAL_1)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#key-obligations",
          "note": null,
          "level": 1
        },
        {
          "text": "Atlas Global Clusters with EU zone: Data with EU location prefix physically stored in EU regions only; cross-zone scatter-gather queries blocked at app layer",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#key-obligations",
          "note": null,
          "level": 1
        },
        {
          "text": "Right to Erasure (Right to be Forgotten):",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#key-obligations",
          "note": null,
          "level": 0
        },
        {
          "text": "Data Processing Agreement (DPA): MongoDB offers a DPA for Atlas. Required for EU data controllers.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#key-obligations",
          "note": null,
          "level": 0
        },
        {
          "text": "Data Portability: Use mongoexport or Atlas Data Federation $out to S3 to generate user data exports.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#key-obligations",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "Backup Compliance Policy (BCP)",
      "facts": [
        {
          "text": "BCP locks backup settings across all clusters in a project - prevents backup deletion and modification without multi-party authorization. Recommended for HIPAA, PCI DSS, and SOC 2.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#backup-compliance-policy-bcp",
          "note": null,
          "level": 0
        },
        {
          "text": "Once enabled, BCP cannot be disabled without contacting MongoDB Support and verifying the authorized contact.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#backup-compliance-policy-bcp",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "Database Auditing for Compliance",
      "facts": [
        {
          "text": "Enable Atlas database auditing (M10+) to capture:",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#database-auditing-for-compliance",
          "note": null,
          "level": 0
        },
        {
          "text": "SIEM Integration:",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#database-auditing-for-compliance",
          "note": null,
          "level": 0
        },
        {
          "text": "Atlas → S3 → AWS Security Hub / Splunk / Sumo Logic",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#database-auditing-for-compliance",
          "note": null,
          "level": 1
        },
        {
          "text": "Atlas audit log export via Admin API (hourly pull)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#database-auditing-for-compliance",
          "note": null,
          "level": 1
        },
        {
          "text": "Atlas Sentinel integration (see mongodb-atlas-azure)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#database-auditing-for-compliance",
          "note": null,
          "level": 1
        },
        {
          "text": "MongoDB Atlas Datadog integration → Datadog SIEM",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#database-auditing-for-compliance",
          "note": null,
          "level": 1
        }
      ]
    },
    {
      "title": "Queryable Encryption for Compliance-Sensitive Fields",
      "facts": [
        {
          "text": "For HIPAA, PCI, or GDPR-sensitive fields that must be queryable but not visible to DBA:",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#queryable-encryption-for-compliance-sensitive-fields",
          "note": null,
          "level": 0
        },
        {
          "text": "Queryable Encryption protects data from: database administrator access, cloud provider access (keys in customer KMS), memory sniffing (keys are in the client).",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#queryable-encryption-for-compliance-sensitive-fields",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "Compliance-Specific Feature Gating",
      "facts": [
        {
          "text": "Key implication: Any regulated workload (HIPAA, PCI, FedRAMP, SOC 2 with database scope) requires M10+ dedicated clusters.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#compliance-specific-feature-gating",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "Anti-Patterns",
      "facts": [
        {
          "text": "Storing PHI or PAN on M0/Flex: Non-compliant; shared infrastructure; no auditing or BYOK",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#anti-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Not enabling database auditing: Cannot demonstrate access controls to auditors without audit logs",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#anti-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Miscounting GDPR backup scope: Atlas backups retain deleted data for the configured retention period; DPA must account for this",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#anti-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Using 0.0.0.0/0 access list in production for any regulated workload: PCI Req 1, HIPAA, FedRAMP all require network restriction",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#anti-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Not setting up Backup Compliance Policy before going live: Once live data exists, BCP requires additional authorization steps; set it up pre-launch",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-compliance/#anti-patterns",
          "note": null,
          "level": 0
        }
      ]
    },
