        },
        {
          "text": "Define a MongoDB Eloquent model by extending `MongoDB\\Laravel\\Eloquent\\Model`. The default collection name is the snake case plural of the model class name; override `$table` to choose another collection. (low confidence)",
          "source": "https://www.mongodb.com/docs/drivers/php/laravel-mongodb/current/model-data/model-class.md",
          "note": null,
          "claimId": "clm:68122a52c1cc8110c6d00639cf5aa8fbed3913b57da466e30590c9db63e18b8f",
