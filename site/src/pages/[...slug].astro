---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
export async function getStaticPaths() {
  const out = [];
  for (const c of ["reference", "essays", "examples", "blog", "skills"]) {
    for (const e of await getCollection(c)) out.push({ params: { slug: `${c}/${e.slug}` }, props: { entry: e, collection: c } });
  }
  return out;
}
const { entry, collection } = Astro.props;
const { Content } = await entry.render();
---
<Base title={entry.data.title} description={entry.data.description} route={`/${collection}/${entry.slug}/`}>
  <Content />
</Base>
