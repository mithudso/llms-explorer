{
  "typeCheckingMode": "standard",
  "pythonVersion": "3.13",
  "include": ["api", "hub", "llmsx", "scripts"],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.venv",
    "**/build",
    "**/dist",
    "**/*.egg-info"
  ],
  "executionEnvironments": [
    {
      "root": "api",
      "extraPaths": ["api", "api/.venv/lib/python3.13/site-packages"]
    },
    {
      "root": "hub",
      "extraPaths": ["hub/scripts", "hub/.venv/lib/python3.13/site-packages"]
    },
    {
      "root": "llmsx",
      "extraPaths": ["llmsx", "llmsx/.venv/lib/python3.13/site-packages"]
    },
    {
      "root": "."
    }
  ]
}
