      "title": "Five categories of doc decay",
      "facts": [
        {
          "text": "Stale Facts - claims about state-of-the-world that have changed",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/doc-archaeology/#five-categories-of-doc-decay",
          "note": null
        },
        {
          "text": "Dead Links - URLs that 404, redirect to unrelated destinations",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/doc-archaeology/#five-categories-of-doc-decay",
          "note": null
        },
        {
          "text": "Drift from Current Process - procedures that no longer reflect actual practice",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/doc-archaeology/#five-categories-of-doc-decay",
          "note": null
        },
        {
          "text": "Phantom Dependencies - scripts, files, tools, people that no longer exist",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/doc-archaeology/#five-categories-of-doc-decay",
          "note": null
        },
        {
          "text": "Obsolete Examples - code snippets reflecting prior API or UI",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/doc-archaeology/#five-categories-of-doc-decay",
          "note": null
        }
      ]
    },
    {
      "title": "Five-pass workflow",
      "facts": [
        {
          "text": "Last-Updated Lens - estimate age, catalog time-sensitive claims, set decay risk (low/medium/high)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/doc-archaeology/#five-pass-workflow",
          "note": null
        },
        {
          "text": "Fact-Check Pass - verify each claim against current state",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/doc-archaeology/#five-pass-workflow",
          "note": null
        },
        {
          "text": "Link-Check Pass - verify every URL; flag auth-gated as \"unverified\"",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/doc-archaeology/#five-pass-workflow",
          "note": null
        },
        {
          "text": "Process-Check Pass - verify procedures against current practice at step level",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/doc-archaeology/#five-pass-workflow",
          "note": null
        },
        {
          "text": "Dependency-Check Pass - check scripts, files, tools, channels, people",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/doc-archaeology/#five-pass-workflow",
          "note": null
        }
      ]
    },
    {
      "title": "Findings table",
      "facts": [
        {
          "text": "Severity: Critical/Misleading → High/Outdated → Medium/Cosmetic → Low/Historical",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/doc-archaeology/#findings-table",
          "note": null
