      "title": "Workload Identity (Passwordless Atlas API Access)",
      "facts": [
        {
          "text": "Instead of storing Atlas API key credentials in a Kubernetes Secret, use Workload Identity to have the AKO pod authenticate using a cloud-provider IAM identity:",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-kubernetes-operator/#workload-identity-passwordless-atlas-api-access",
          "note": null
        }
      ]
