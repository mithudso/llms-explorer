{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strategy-shape matrix v1",
  "type": "object",
  "required": [
    "schema_version",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "shape_id",
          "abstraction_level",
          "effective_strategies",
          "ineffective_strategies",
          "candidate_strategies",
          "in_boundary_edge_metrics",
          "out_of_boundary_decay",
          "efficacy_status",
          "claim_ids",
          "causal_detector",
          "failure_trigger"
        ],
        "properties": {
          "shape_id": {
            "type": "string"
          },
          "abstraction_level": {
            "enum": [
              "microstructure",
              "meso",
              "macro"
            ]
          },
          "effective_strategies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ineffective_strategies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "candidate_strategies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "in_boundary_edge_metrics": {
            "type": "object",
            "required": [
              "sharpe_delta",
              "win_rate",
              "confidence_interval"
            ],
            "properties": {
              "sharpe_delta": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "win_rate": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "confidence_interval": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          },
          "out_of_boundary_decay": {
            "type": [
              "string",
              "null"
            ]
          },
          "efficacy_status": {
            "enum": [
              "verified",
              "unverifiable",
              "contradicted"
            ]
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "causal_detector": {
            "type": "string"
          },
          "failure_trigger": {
            "type": "string"
          }
        }
      }
    }
  }
}
