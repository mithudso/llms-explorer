      ]
    },
    {
      "id": "clm:84e7dd59b7943582af40f9e1e3e7c62a11ee1f46dc396309102b7a069f640aae",
      "text": "Performance Advisor suggests indexes for slow queries and includes sample queries grouped by query shape. (medium confidence) (verified as of 2026-10-14)",
      "source_url": "https://www.mongodb.com/docs/atlas/performance-advisor.md",
      "also": [
        "https://www.manning.com/preview/mongodb-in-action-third-edition/chapter-21"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:7c5a78d34328bc0ca5a484dbe445bc6affd46ce394f3203f571d6b28137080b5"
      ]
    },
    {
      "id": "clm:cb0c53d6a255189bb67235ec3a90c9887359894305b4287ad4d3b780feed37e3",
      "text": "Atlas does not support the managed slow-operation threshold on clusters with MongoDB Search enabled, and Free clusters cannot enable it. (low confidence) (verified as of 2026-10-14)",
      "source_url": "https://www.mongodb.com/docs/atlas/performance-advisor.md",
      "also": [],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:e8764f3e7945698789d317c7571bd5d0ee8133be4b58bf232e2cf699b36800a2"
      ]
    },
    {
      "id": "clm:eacb18e89b9a8b5a4cdd70350c7a83136f70d64bf7dca152e28eb0f237bb44f5",
      "text": "Inference: absence of an index suggestion cannot establish workload-wide safety for an index change, because recommendations depend on observed slow operations and log coverage. (medium confidence) (verified as of 2026-10-14)",
      "source_url": "https://www.mongodb.com/docs/atlas/performance-advisor.md",
      "also": [
        "https://www.manning.com/preview/mongodb-in-action-third-edition/chapter-21"
