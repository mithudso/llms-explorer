---
import Base from "../layouts/Base.astro";
import AccountNav from "../components/AccountNav.astro";

const title = "My proposals";
const description = "View the contributions you've submitted to the LLMS-Explorer directory — their status, lint findings, and moderation decisions.";
---
<Base title={title} description={description} route="/proposals/">
  <AccountNav route="/proposals/" />
  <p>
    Here are the subjects you've contributed to the directory. Each shows its
    current status, any lint findings from the research pass, and when a
    moderator decision was made.
  </p>

  <div class="island" id="proposals-list" data-island="proposals" hidden></div>

  <div data-signed-out id="proposals-signed-out">
    <p>
      Your proposals are tied to your account. <a href="/login/">Sign in</a> to
      see the subjects you've submitted and their status.
    </p>
  </div>

  <noscript>
    <p>Proposals are fetched from the API in the browser and need JavaScript.</p>
  </noscript>

  <script>
    const nav = document.querySelector(".account-nav");
    const api = nav ? nav.getAttribute("data-api") : "";
    const panel = document.getElementById("proposals-list");
    const out = document.getElementById("proposals-signed-out");

    const call = (path, init) =>
      fetch(api + path, { credentials: "include", headers: { accept: "application/json" }, ...init });

    function buildTable(proposals) {
      const table = document.createElement("table");
      const head = document.createElement("tr");
      for (const label of ["Subject", "Status", "Lint verdict", "Decided"]) {
        const th = document.createElement("th");
        th.textContent = label;
        head.appendChild(th);
      }
      table.appendChild(head);

      for (const proposal of proposals) {
        const tr = document.createElement("tr");
        const cells = [
          proposal.concept || "—",
          proposal.status || "—",
          proposal.lint_verdict_summary || "—",
          (proposal.decided_at || "").slice(0, 10) || "—",
        ];
        for (const value of cells) {
          const td = document.createElement("td");
          td.textContent = String(value);
          tr.appendChild(td);
        }
        table.appendChild(tr);
      }

      return table;
    }

    async function load() {
      try {
        const r = await call("/api/proposals?scope=mine");
        if (!r.ok) {
          if (r.status === 401) {
            // Not signed in
            return;
          }
          throw new Error(`HTTP ${r.status}`);
        }

        const proposals = await r.json();
        if (!Array.isArray(proposals) || proposals.length === 0) {
          const empty = document.createElement("p");
          empty.textContent = "You haven't submitted any proposals yet.";
          panel.replaceChildren(empty);
        } else {
          const table = buildTable(proposals);
          panel.replaceChildren(table);
        }
        panel.hidden = false;
        out.hidden = true;
      } catch (err) {
        const error = document.createElement("p");
        error.className = "error";
        error.textContent = `Error loading proposals: ${err}`;
        panel.replaceChildren(error);
        panel.hidden = false;
        out.hidden = true;
      }
    }

    load();
  </script>
</Base>

<style>
  .island table {
    border-collapse: collapse;
    width: 100%;
    max-width: 100%;
  }
  .island th,
  .island td {
    text-align: left;
    padding: 0.5rem 0.8rem;
    border-bottom: 1px solid #ccc;
  }
  .island th {
    font-weight: 600;
    background: #f5f5f5;
  }
  .island tr:last-child td {
    border-bottom: none;
  }
  .error {
    color: #d32f2f;
    padding: 1rem;
    background: #ffebee;
    border-radius: 4px;
  }
</style>
