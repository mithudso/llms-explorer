        "ev:c4aec18d1957b122acece00cac3f9053b9ffbc88356e9394d96a549f44f786b4"
      ]
    },
    {
      "id": "clm:94d28c69692729fd059c6f26595a1f4a5d6697884f5e49288bb4e223eb8ce3dc",
      "text": "Trinchillo and colleagues' review states that Butala and colleagues found significant improvements in motor functions after 24 weeks in a randomized crossover trial of weekly group singing, whereas Butala and colleagues' own Parkinsonics trial report states a significant overall-cohort MDS-UPDRS Part III improvement at 24 weeks (\u0394 = 5.9 points) that became nonsignificant when the baseline was adjusted in mixed linear model analyses, and that they cannot conclusively attribute motor improvements to the singing intervention. (medium confidence)",
      "source_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC13731696/",
      "also": [
        "https://pmc.ncbi.nlm.nih.gov/articles/PMC9553721/"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:27ed4c46d033af28447410fb7768071d8beaedead2a15597c3cbcde5f7122a21",
        "ev:3be40ddd409534d29a2b929f3120742738eb2ea992782fed95323d0e4f879514",
        "ev:5d64c3183b49fda5c31f34853882976729e4a816dbfd49ad66e36f9d5ebdbca5",
