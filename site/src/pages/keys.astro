---
import Base from "../layouts/Base.astro";
import AccountNav from "../components/AccountNav.astro";

// The plaintext key exists for exactly one response. The API stores an Argon2id
// hash and a non-secret lookup prefix, so a key can be listed and revoked
// forever but never shown twice — which is why the created key is painted by the
// island straight from the POST response and never re-fetched.
const title = "API keys";
const description = "Create, list and revoke the scoped keys that authenticate the hosted MCP endpoint; the plaintext is shown once, at creation, and stored only as a hash.";
---
<Base title={title} description={description} route="/keys/">
  <AccountNav route="/keys/" />
  <p>
    A key authenticates the hosted MCP endpoint and the run and publish routes.
    It carries scopes — <code>read</code> for the hub's read tools,
    <code>run</code> for jobs that spend credits, <code>publish</code> for your
    own artifacts — and a key with only the scopes it needs is the difference
    between a leaked token that reads and one that spends.
  </p>

  <p id="keys-status" class="keys-status" role="status"></p>
  <p id="fresh-key" class="fresh-key" hidden></p>
  <div class="island" id="keys-table" data-island="keys" hidden></div>

  <div data-signed-out id="keys-signed-out">
    <p>
      Keys belong to an account. <a href="/login/">Sign in</a> to list the ones
      you have, create another, or revoke one.
    </p>
  </div>

  <h2>Shown once</h2>
  <p>
    The response to a creation request is the only time the full key is
    readable: what is kept is the prefix, which identifies it in this list, and
    an Argon2id hash of the rest. Lose it and the fix is a new key and a
    revocation, not a recovery. Revocation takes effect on the next call.
  </p>

  <noscript>
    <p>Key management is an authenticated API call from the browser, so it needs
    JavaScript.</p>
  </noscript>

  <script>
    const nav = document.querySelector(".account-nav");
    const api = nav ? nav.getAttribute("data-api") : "";
    const panel = document.getElementById("keys-table") as HTMLElement;
    const out = document.getElementById("keys-signed-out") as HTMLElement;
    const status = document.getElementById("keys-status") as HTMLElement;
    const fresh = document.getElementById("fresh-key") as HTMLElement;
    let pending = false;

    interface ApiKey {
      id: string;
      prefix: string;
      scopes?: string[];
      created_at?: string;
    }

    const call = (path: string, init?: RequestInit) =>
      fetch(api + path, { credentials: "include", headers: { accept: "application/json" }, ...init });

    async function withKeyAction(action: () => Promise<void>) {
      if (pending) return;
      pending = true;
      const buttons = Array.from(panel.querySelectorAll("button"));
      buttons.forEach(button => { button.disabled = true; });
      try {
        await action();
      } finally {
        pending = false;
        buttons.forEach(button => { button.disabled = false; });
      }
    }

    function row(key: ApiKey, onRevoke: (id: string) => void) {
      const tr = document.createElement("tr");
      for (const value of [key.prefix, (key.scopes || []).join(" "), (key.created_at || "").slice(0, 10)]) {
        const td = document.createElement("td");
        td.textContent = String(value);
        tr.appendChild(td);
      }
      const cell = document.createElement("td");
      const button = document.createElement("button");
      button.type = "button";
      button.textContent = "Revoke";
      button.setAttribute("aria-label", `Revoke key ${key.prefix}`);
      button.addEventListener("click", () => onRevoke(key.id));
      cell.appendChild(button);
      tr.appendChild(cell);
      return tr;
    }

    async function revoke(id: string) {
      if (!window.confirm("Revoke this key? It will stop working immediately.")) return;
      status.textContent = "Revoking key…";
      try {
        const response = await call(`/api/keys/${encodeURIComponent(id)}`, { method: "DELETE" });
        if (!response.ok) {
          status.textContent = "The service could not revoke this key.";
          return;
        }
        await load("Key revoked.");
      } catch {
        status.textContent = "Could not confirm revocation. Refresh the list to check the key.";
      }
    }

    async function create() {
      status.textContent = "Creating read key…";
      try {
        const response = await call("/api/keys", {
          method: "POST",
          headers: { accept: "application/json", "content-type": "application/json" },
          body: JSON.stringify({ scopes: ["read"] }),
        });
        if (!response.ok) throw new Error("Key creation request failed");
        const made = await response.json();
        if (typeof made.key !== "string" || !made.key) throw new Error("Missing created key");
        fresh.textContent = `Copy this now — it is not shown again: ${made.key}`;
        fresh.hidden = false;
        await load("Read key created.");
      } catch {
        status.textContent = "Could not confirm key creation. Refresh the list before trying again.";
      }
    }

    async function load(success = "") {
      status.textContent = success || "Loading API keys…";
      let keys: ApiKey[];
      try {
        const response = await call("/api/keys");
        if (response.status === 401) {
          panel.hidden = true;
          out.hidden = false;
          status.textContent = success;
          return;
        }
        if (!response.ok) throw new Error("Key list request failed");
        const payload = await response.json();
        if (!Array.isArray(payload)) throw new Error("Invalid key list");
        keys = payload;
      } catch {
        out.hidden = true;
        const failure = "Could not load the key list. Refresh the page to try again.";
        status.textContent = success ? `${success} ${failure}` : failure;
        return;
      }
      const table = document.createElement("table");
      const head = document.createElement("tr");
      for (const label of ["Prefix", "Scopes", "Created", "Actions"]) {
        const th = document.createElement("th");
        th.textContent = label;
        head.appendChild(th);
      }
      table.appendChild(head);
      for (const key of keys) table.appendChild(row(key, id => withKeyAction(() => revoke(id))));
      const button = document.createElement("button");
      button.type = "button";
      button.textContent = "Create a read key";
      button.addEventListener("click", () => withKeyAction(create));
      panel.replaceChildren(table, button);
      panel.hidden = false;
      out.hidden = true;
      status.textContent = success;
    }

    load();
  </script>
</Base>

<style>
  .keys-status:empty { margin: 0; }
  .island table { border-collapse: collapse; }
  .island th, .island td { text-align: left; padding: .2rem .8rem .2rem 0; }
  .fresh-key { font-family: monospace; word-break: break-all; }
</style>
