        },
        {
          "text": "Assign application database users only the required database or collection privileges. Atlan documents creating a separate crawler database user and choosing built-in read access or a custom role limited to selected resources. (high confidence) Sources: https://docs.atlan.com/apps/connectors/database/mongodb/how-tos/set-up-mongodb.md ; https://www.mongodb.com/docs/atlas/security-add-mongodb-users.md",
          "source": "https://docs.atlan.com/apps/connectors/database/mongodb/how-tos/set-up-mongodb.md",
          "note": null,
          "claimId": "clm:bc2d89559dbd59191c3a0c8d8c68f4f07a172728139b7adbf793096920046990",
          "validationStatus": "REMEDIATED-PROJECTION",
          "evidenceIds": [],
