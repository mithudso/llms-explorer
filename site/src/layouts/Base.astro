---
import "../styles/global.css";
import "../styles/lx-polish.css";
const { title, heading = title, description, route, twin: twinProp, noindex = false, adEligible = false } = Astro.props;
// `noindex` excludes incomplete references and unverified evidence from search.
// Content pages carry a `.md` twin at the same route; the generated listing
// pages (home, section indexes) pass `twin={null}` because twins.py writes a
// twin only for `src/content/**`, and a link to a file that is not published
// is worse than no link.
const twin = twinProp === undefined ? route.replace(/\/$/, "") + ".md" : twinProp;
// Routes that hold a secret (session islands, the one-time key, API-key
// inputs) get no third-party script. Mirrors STRICT_ROUTES in tools/twins.py,
// which gives these routes the CSP that would block the tags anyway.
const STRICT_ROUTES = ["/login/", "/account/", "/keys/", "/usage/", "/contribute/",
                       "/donate/", "/moderate/", "/proposals/", "/playground/"];
const strict = STRICT_ROUTES.some((r) => route.startsWith(r));
// Account, form and live-status pages hold no reading content of their own:
// keep them out of search so the index is the site's writing and curated
// references (AdSense judged the site "low value" on 2026-11-07; KNOW-558).
const UTILITY_ROUTES = ["/queue/"];
const hidden = noindex || strict || UTILITY_ROUTES.some((r) => route.startsWith(r));
// AdSense runs only on pages a reader comes to read (articles and curated
// concept packs pass `adEligible`), never on account routes or pages kept out
// of search. Google requires a certified consent message for EEA/UK/CH
// visitors; it is configured in the AdSense account (Privacy & messaging),
// and adsbygoogle.js loads it, so no consent code lives here.
const ads = adEligible && !strict && !hidden;
// Reader journeys lead. The resource catalogue remains in the More menu.
const NAV = [
  ["/skills/", "Agent skills", "Bounded review-and-fix instructions"],
  ["/apps/", "Workbenches", "Local terminal tools: llmsx, skillsx and ghx"],
  ["/context/", "Context libraries", "Download source-linked Markdown and .llms packs"],
  ["/workflows/", "Guides & experiments", "Worked tasks and the evidence behind them"],
];
const RESOURCES = [
  ["/queue/", "Research queue", "What is being researched now, and what is waiting"],
  ["/toolkit/", "The full toolkit", "Offerings, commands and requirements"],
  ["/research/", "Find context by task", "Reference files, guides and skills for an AI task"],
  ["/blog/", "Article archive", "All guides, experiments and case studies"],
  ["/start-here/", "Start here", "Try a short handoff without installing anything"],
  ["/downloads/", "Installation reference", "All setup instructions and download options"],
  ["/reference/", "Technical reference", "Formats, lint rules and publishing conventions"],
  ["/examples/", "Code examples", "Copyable recipes with stated assumptions"],
  ["/demo/", "Retrieval demo", "Recorded keyword, vector and hybrid results"],
  ["/explorer/", "LLMSX Explorer", "Research workbench features and shortcuts"],
  ["/family/", "For agents: llms.txt", "The machine-readable site index"],
  ["/contribute/", "Contribute", "Suggest additions to the research library"],
  ["/donate/", "Support the project", "Help fund the work"],
  ["/login/", "Sign in", "Account, API keys and hosted tools"],
  ["/account/", "Account", "Your signed-in profile and settings"],
  ["/keys/", "API keys", "Manage access to hosted tools"],
  ["/usage/", "Usage", "Inspect your account usage"],
  ["/proposals/", "Your proposals", "Track submitted contributions"],
];
// App Review opens the Net-DNS-Monitor Support and Privacy pages. Guideline
// 3.1.1 treats a link that solicits funding as a payment path outside In-App
// Purchase, so those pages show no donate link. Every other page keeps it.
const menuResources = route.startsWith("/net-dns-monitor/")
  ? RESOURCES.filter(([href]) => href !== "/donate/")
  : RESOURCES;
---
<html lang="en"><head>
  <meta charset="utf-8" />
  {!strict && (<>
  <!-- Google tag (gtag.js) -->
  <script is:inline>
    if (navigator.doNotTrack !== "1" && !navigator.globalPrivacyControl && !window["ga-disable-G-0E31PW5CE9"]) {
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    window.gtag = gtag;
    gtag('config', 'G-0E31PW5CE9', {
      page_location: location.origin + location.pathname,
      page_referrer: document.referrer ? new URL(document.referrer).origin : "",
      allow_google_signals: false
    });
    var tag = document.createElement("script");
    tag.async = true;
    tag.src = "https://www.googletagmanager.com/gtag/js?id=G-0E31PW5CE9";
    tag.crossOrigin = "anonymous";
    document.head.append(tag);
    }
  </script>
  </>)}
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {/* Ownership verification is separate from page-level ad eligibility. */}
  <meta name="google-adsense-account" content="ca-pub-1706083044457708" />
  {ads && (<>
  {/* A browser that sends Global Privacy Control or Do Not Track gets
      non-personalized ads (Google's documented NPA flag, set before the tag
      loads); analytics skip such browsers entirely. */}
  <script is:inline>
    (window.adsbygoogle = window.adsbygoogle || []).requestNonPersonalizedAds =
      (navigator.globalPrivacyControl || navigator.doNotTrack === "1") ? 1 : 0;
  </script>
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1706083044457708" crossorigin="anonymous"></script>
  </>)}
  <title>{title} · LLMSX</title>
  <meta name="llmsx-release" content="three-pillars-2026-11-07" />
  <meta name="description" content={description} />
  {hidden && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={new URL(route, Astro.site).href} />
  {twin && <link rel="alternate" type="text/markdown" href={twin} />}
  <link rel="describedby" href="/llms.txt" />
  {/* llmsx logo set: docs/design-system/llmsx/project/assets/Logos. The .ico
      covers browsers and crawlers that ask for /favicon.ico directly. */}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#f5f6f8" />
  <meta property="og:site_name" content="LLMSX" />
  <meta property="og:title" content={`${title} · LLMSX`} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={new URL(route, Astro.site).href} />
  <meta property="og:image" content={new URL("/og-image.png", Astro.site).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="The llmsx logo: a tree mark and the llmsx wordmark" />
  <meta name="twitter:card" content="summary_large_image" />
  <script src="../scripts/lx-polish.js"></script>
</head><body data-analytics-enabled={strict ? "false" : "true"}>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <nav class="site-nav" aria-label="Primary">
      <a class="brand" href="/" aria-label="LLMSX home"><svg class="brand-logo" viewBox="0 0 296 64" aria-hidden="true" focusable="false"><rect class="brand-mark" width="64" height="64" rx="12"/><g class="brand-glyph" transform="translate(32 32) scale(1.15) translate(-29.5 -32.1)"><circle cx="19" cy="17" r="5.5"/><path d="M19 22 V40 Q19 47 26 47 H33 M19 32 H33" fill="none" stroke-width="4.5"/><circle cx="40" cy="32" r="5.5"/><circle cx="40" cy="47" r="4.25" fill="none" stroke-width="3"/></g><g class="brand-word" fill="none" stroke-width="7"><path transform="translate(88 2)" d="M8 2 H16 V48 Q16 58 28 58"/><path transform="translate(128 2)" d="M8 2 H16 V48 Q16 58 28 58"/><path transform="translate(168 2)" d="M4 22 V58 M4 32 Q4 22 12 22 Q20 22 20 32 V58 M20 32 Q20 22 28 22 Q36 22 36 32 V58"/><path transform="translate(208 2)" d="M31 28 Q27 22 19 22 Q8 22 8 31 Q8 38 19 40 Q31 42 31 50 Q31 58 19 58 Q9 58 6 52"/><path transform="translate(248 2)" d="M7 22 L32 58 M32 22 L7 58"/></g></svg><span class="brand-note">  / toolkit for coding agents</span></a>
      <span class="links">
        {NAV.map(([href, label, note]) => (
          <a href={href} title={note} aria-current={(route.startsWith(href) || (href === "/workflows/" && (route.startsWith("/blog/") || route === "/start-here/")) || (href === "/context/" && (route.startsWith("/tree/") || route === "/research/"))) ? "page" : null} data-track="nav_click" data-label={label} data-destination={href}>{label}</a>
        ))}
        <a class="tree-shortcut" href="/tree/" data-track="nav_click" data-label="concept-tree">Concept tree</a>
        <details class="menu"><summary data-track="resources_menu_open">Resources & account</summary>
          <div class="menu-items">
            {menuResources.map(([href, name, note]) => (
              <a href={href}>{name}<span class="menu-note">{note}</span></a>
            ))}
          </div>
        </details>
      </span>
    </nav>
  </header>
  <div class:list={["reading-layout", { "reading-layout--ads": ads }]}>
    <main id="main-content" tabindex="-1"><h1>{heading}</h1><slot />
      {ads && <aside class="horizontal-ad" aria-label="Advertisement"><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-1706083044457708" data-ad-slot="8482527534" data-ad-format="auto" data-full-width-responsive="true"></ins></aside>}
      {ads && <aside class="matched-ad" aria-label="Advertisement"><ins class="adsbygoogle" style="display:block" data-ad-format="autorelaxed" data-ad-client="ca-pub-1706083044457708" data-ad-slot="8630701349"></ins></aside>}
    </main>
    {ads && <aside class="vertical-ad" aria-label="Advertisement"><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-1706083044457708" data-ad-slot="5433692360" data-ad-format="auto" data-full-width-responsive="true"></ins></aside>}
    {ads && <aside class="square-ad" aria-label="Advertisement"><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-1706083044457708" data-ad-slot="5347876541" data-ad-format="auto" data-full-width-responsive="true"></ins></aside>}
  </div>
  {ads && <script is:inline>
    const paragraphs = Array.from(document.querySelectorAll("#main-content > p"))
      .filter((paragraph) => paragraph.textContent.trim().length >= 80);
    if (paragraphs.length >= 4) {
      const articleAd = document.createElement("aside");
      articleAd.className = "in-article-ad";
      articleAd.setAttribute("aria-label", "Advertisement");
      const unit = document.createElement("ins");
      unit.className = "adsbygoogle";
      unit.style.cssText = "display:block;text-align:center";
      unit.dataset.adLayout = "in-article";
      unit.dataset.adFormat = "fluid";
      unit.dataset.adClient = "ca-pub-1706083044457708";
      unit.dataset.adSlot = "9911993425";
      articleAd.append(unit);
      paragraphs[1].after(articleAd);
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    }
    const horizontal = document.querySelector(".horizontal-ad");
    if (paragraphs.length >= 6) {
      paragraphs[3].after(horizontal);
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    } else {
      horizontal.remove();
    }
    (window.adsbygoogle = window.adsbygoogle || []).push({});
    if (window.matchMedia("(min-width: 80rem)").matches) window.adsbygoogle.push({});
    if (window.matchMedia("(min-width: 90rem)").matches) window.adsbygoogle.push({});
  </script>}
  <footer class="site-footer">
    <p>LLMSX — tools, skills and context for AI coding agents.</p>
    <nav aria-label="Footer">
      <a href="/about/">About & contact</a>
      <a href="/editorial/">Sources & editorial standards</a>
      <a href="/privacy/">Privacy</a>
      <a href="https://github.com/mithudso/llms-explorer">Source code</a>
      <a href="/family/">For agents: llms.txt</a>
      {twin && <a href={twin}>This page as Markdown</a>}
    </nav>
  </footer>
  <script>
    import { installEngagement } from "../scripts/engagement";
    installEngagement();
  </script>
</body></html>
