---
import Base from "../../layouts/Base.astro";
// One source of truth: llmsx/llmsx/USER_GUIDE.md, the guide the package ships
// (`llmsx explorer --guide` prints it, `g` opens it in the app). The prebuild
// (tools/gen_downloads.py) copies it here; a test pins the copy byte for byte.
import { Content } from "../../data/explorer-guide.md";

const title = "LLMSX Explorer User Guide";
const description =
  "The complete guide to llmsx explorer: navigation, facts, the llms colour scheme, the scratchpad, marks, research jobs and every key.";
---
<Base title={title} description={description} route="/explorer/guide/">
  <p class="guide-context">
    This guide ships inside the <code>llmsx</code> package. In the app press <kbd>g</kbd>; in a
    terminal run <code>llmsx explorer --guide</code>. Back to the <a href="/explorer/">explorer
    overview</a> or <a href="/downloads/#llmsx">install llmsx</a>.
  </p>
  <article class="guide">
    <Content />
  </article>
</Base>

<style>
  .guide-context { color: var(--muted, #888); font-size: 0.95rem; }
  .guide :global(table) { border-collapse: collapse; margin: 1rem 0; display: block; overflow-x: auto; }
  .guide :global(th), .guide :global(td) { border: 1px solid var(--border, #444); padding: 0.3rem 0.6rem; vertical-align: top; }
  .guide :global(pre) { overflow-x: auto; }
  /* the page already carries the title; the guide's own H1 is for the terminal */
  .guide > :global(h1:first-child) { display: none; }
</style>
