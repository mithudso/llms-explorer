    },
    {
      "id": "clm:c718ca699c7dca501f0fe3f1501ec9951a31d0f8fd3b2330674edd553eafbdb9",
      "text": "limit exceeding numCandidates, or unsupported filter operators, produces PlanExecutor errors for every document at runtime. (low confidence) (verified as of 2026-10-27)",
      "source_url": "https://www.mongodb.com/docs/atlas/atlas-stream-processing/sp-agg-vectorsearch/",
      "also": [],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:100beda35424e00af4976eeb122954898925daaa352f4b7e57bf7ca7b63ccecc"
