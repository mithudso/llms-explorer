        "ev:93ad44b25158b487fde32103c7daea92af18d98ef11e848bb294272b7e78b1c5"
      ]
    },
    {
      "id": "clm:63a4c5981fcbd64e3446a210525208148f53acf0be5d27d89e860d8b58cd8a7c",
      "text": "The project-level Managed Slow Operations toggle and the CLI commands atlas performanceAdvisor slowOperationThreshold disable and enable control automatic threshold management. (medium confidence) (verified as of 2026-10-14)",
      "source_url": "https://www.mongodb.com/docs/atlas/performance-advisor.md",
      "also": [
        "https://www.manning.com/preview/mongodb-in-action-third-edition/chapter-21",
