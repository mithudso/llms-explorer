      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:7c5a78d34328bc0ca5a484dbe445bc6affd46ce394f3203f571d6b28137080b5"
      ]
    },
    {
      "id": "clm:3e69239c5cf49418a139511b4080430d42123049b645973af40931e241c7098b",
      "text": "Review write costs before adding suggested indexes; maintaining more indexes can reduce write performance. (medium confidence)",
      "source_url": "https://www.mongodb.com/docs/atlas/performance-advisor.md",
      "also": [
        "https://www.urhoba.net/en/post/managing-mongodb-in-the-cloud-with-atlas",
        "https://www.mongodb.com/community/forums/t/alert-all-the-time-query-targeting-scanned-objects-returned-has-gone-above-1000/168277"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:19c82037d86c76a73b50a500e42ae406e77a7313841d23d5c87188e7fe6f6e03"
      ]
    },
    {
      "id": "clm:eea4e7705368e04a662b906ec1e1467c02ccd7a1b8d0d71ba794666901218c23",
      "text": "Suggestions include sample query shapes and impact ranking based on wasted bytes read. (medium confidence) (verified as of 2026-10-30)",
      "source_url": "https://www.mongodb.com/docs/atlas/performance-advisor.md",
      "also": [
        "https://github.com/influxdata/influxdb/issues/27657"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:dcf8204e4b45f886ee64f1a4a9c8aadf6cc42ad76425962f1f49eb6b3c188f60"
      ]
    },
    {
      "id": "clm:b83424b6a12c05639232ef7150ca7c49af4093cc25dcd0ff07899eda8a27593f",
      "text": "Extreme log volume can interrupt Advisor log collection; downloadable logs remain complete. (low confidence) (verified as of 2026-10-30)",
      "source_url": "https://www.mongodb.com/docs/atlas/performance-advisor.md",
      "also": [],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:93ad44b25158b487fde32103c7daea92af18d98ef11e848bb294272b7e78b1c5"
      ]
    },
    {
      "id": "clm:99dc25eb7529fc377980a1d5463e0e7a7187d01300da37d46e80147cc27394ef",
      "text": "Managed thresholds are unsupported with MongoDB Search enabled; Performance Advisor requires M10+. (low confidence) (verified as of 2026-10-30)",
      "source_url": "https://www.mongodb.com/docs/atlas/performance-advisor.md",
      "also": [],
      "validation_status": "SUPPORTED",
