---
import Base from "../layouts/Base.astro";
const title = "LLMS-Explorer";
const description = "The concept tree is the map; llms files are the territory; the site keeps the two in agreement.";
const SECTIONS = [
  ["/tree/", "Tree", "Every researched concept, with a 3D map of the same graph."],
  ["/directory/", "Directory", "Mirrored llms-full.txt files, scored and graded A–F by llms_lint."],
  ["/demo/", "Demo", "Keyword, vector and hybrid retrieval over one docset, recorded."],
  ["/reference/", "Reference", "The /ldo rubric: attributes, passes, and spokes."],
  ["/essays/", "Essays", "CLLMS vs. proprietary, V2 vs. V1, the vocabulary."],
  ["/examples/", "Examples", "The decision table and copy-only recipes."],
  ["/blog/", "Blog", "Launch posts, each one carrying a figure measured from the corpus."],
  ["/llms.txt", "llms.txt", "This site's own llms family — the index a crawler or agent starts from."],
];
---
<Base title={title} description={description} route="/" twin={null}>
  <p class="eyebrow">The llms.txt standard, worked</p>
  <p class="lede">The concept tree is the map; llms files are the territory; this site keeps the two in agreement.</p>
  <ul class="card-grid">
    {SECTIONS.map(([href, label, blurb]) => (
      <li class="card">
        <a class="card-title" href={href}>{label}</a>
        <p>{blurb}</p>
      </li>
    ))}
  </ul>
  <p>
    <a href="/login/">Sign in</a> for <a href="/account/">an account</a>, its <a href="/keys/">API keys</a> and its <a href="/usage/">usage</a> — everything above stays readable and unmetered without one.
  </p>
</Base>
