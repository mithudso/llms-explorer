        "ev:ae8806ed6c1f5bd4d5dc66460329bfb1e03ff63a3385d22a85a8399ea49ad30a"
      ]
    },
    {
      "id": "clm:5e13b8e150252ac670ea48b3b4cf3b3365103f6b2e67a31224fd2b4573e92d1f",
      "text": "Authors of RAS and music-based meta-analyses in Parkinson's disease state evidence-quality limits themselves: Ye and colleagues note that only two included studies had more than 100 subjects and thirteen had fewer than 50; Wang and colleagues report that lack of blinding of participants and trainers was the most common risk of bias, with twelve studies at high risk for this reason, and that the largest included study had 90 participants; Lee and Ko state that allocation concealment and blinding were not possible in most trials because of the nature of the music-related activities; and Li and colleagues rated the overall methodological quality of the included RCTs as moderate. (high confidence)",
      "source_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC9366143/",
      "also": [
        "https://pmc.ncbi.nlm.nih.gov/articles/PMC9053573/",
        "https://pmc.ncbi.nlm.nih.gov/articles/PMC9859027/",
        "https://pmc.ncbi.nlm.nih.gov/articles/PMC12580135/"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:15c8caeb38d0a0bc0676b40e6545901496298a1ff74f03781dff5134b030e02a",
