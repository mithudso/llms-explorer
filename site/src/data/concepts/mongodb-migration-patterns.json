      "title": "Process",
      "facts": [
        {
          "text": "Pre-migration check: Atlas validates source cluster compatibility",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-migration-patterns/#process",
          "note": null
        },
        {
          "text": "Initial sync: Atlas pulls all documents from source",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-migration-patterns/#process",
          "note": null
        },
        {
          "text": "Oplog tailing: Atlas continuously applies changes from source oplog during sync",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-migration-patterns/#process",
          "note": null
        },
        {
          "text": "Cutover: When lag < 30 seconds, initiate cutover - stop writes, confirm lag = 0, switch connection strings",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-migration-patterns/#process",
          "note": null
        }
      ]
    },
    {
      "title": "Requirements",
      "facts": [
        {
          "text": "Source MongoDB: 4.4–8.0; must be a replica set (not standalone)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-migration-patterns/#requirements",
          "note": null
        },
        {
          "text": "Atlas cluster must be M10+ in same major version or one version ahead",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-migration-patterns/#requirements",
          "note": null
        },
        {
          "text": "Source must be accessible from Atlas servers",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-migration-patterns/#requirements",
          "note": null
        }
      ]
    },
    {
      "title": "mongosync — Cluster-to-Cluster Sync",
      "facts": [
        {
          "text": "mongosync is MongoDB's cluster-to-cluster synchronization tool.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-migration-patterns/#mongosync-cluster-to-cluster-sync",
          "note": null
        }
      ]
    },
    {
      "title": "mongosync Limitations",
      "facts": [
        {
          "text": "Source and destination must be compatible versions",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-migration-patterns/#mongosync-limitations",
          "note": null
        },
        {
          "text": "Destination must be empty at start",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-migration-patterns/#mongosync-limitations",
          "note": null
        },
        {
          "text": "No filtering (syncs all databases except admin, local, config)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-migration-patterns/#mongosync-limitations",
          "note": null
        },
        {
          "text": "No support for standalone source (must be replica set)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-migration-patterns/#mongosync-limitations",
          "note": null
        }
      ]
    },
    {
      "title": "Cutover Procedure",
      "facts": [
        {
          "text": "Monitor lagTimeSeconds until < 10 seconds",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-migration-patterns/#cutover-procedure",
          "note": null
        },
        {
          "text": "Stop writes to source cluster",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-migration-patterns/#cutover-procedure",
          "note": null
        },
        {
          "text": "Wait until lagTimeSeconds: 0 and state: COMMITTED",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-migration-patterns/#cutover-procedure",
          "note": null
        },
        {
          "text": "Update application connection strings to destination",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-migration-patterns/#cutover-procedure",
          "note": null
        }
      ]
    },
