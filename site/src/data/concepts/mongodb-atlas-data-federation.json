          ]
        },
        {
          "text": "A federated instance can use object storage from one cloud provider and one account within that provider. (medium confidence) (verified as of 2026-10-14)",
          "source": "https://www.mongodb.com/docs/atlas/data-federation/supported-unsupported/limitations.md",
          "note": null,
          "claimId": "clm:207ef2a67ba0d2c5189545f14ee1dbac20add018030a7a032e159072375df7f9",
          "validationStatus": "SUPPORTED",
