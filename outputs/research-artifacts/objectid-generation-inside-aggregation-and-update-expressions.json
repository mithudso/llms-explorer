        "ev:d5b6a8d2501ee1ba9d41f05beb8a01ccb8de50ce725c1168a2bdfd0f46899973"
      ]
    },
    {
      "id": "clm:6308ab1af3e4bfeae937659810a9ae6e73c1d6c8f9fa479d4fc939ef82f27d5b",
      "text": "The operator\u2019s implementation ticket lists fix version 8.3.0-rc0 and separately links an SBE-support task. The separate task establishes an implementation question; it does not by itself establish current performance or execution-engine behavior. (medium confidence)",
