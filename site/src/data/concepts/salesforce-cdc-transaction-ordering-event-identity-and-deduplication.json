          ],
          "also": [
            "https://resources.docs.salesforce.com/latest/latest/en-us/sfdc/pdf/salesforce_change_data_capture.pdf",
            "https://jsbclabs.com/blog/change-data-capture-is-not-a-business-event-contract"
          ]
        }
      ]
