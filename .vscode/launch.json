{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: Uvicorn Dev",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": ["explorer_api.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/api",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Hub: MCP Server",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/hub/mcp-server/hub_mcp_server.py",
      "cwd": "${workspaceFolder}/hub"
    }
  ]
}
