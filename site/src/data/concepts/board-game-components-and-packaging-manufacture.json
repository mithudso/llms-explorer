            "ev:561a0600d802035e8ad647cc31ebcb7e7d3dcf8841976cea23456dd09f0f287c"
          ],
          "also": [
            "https://www.longpackgames.com/components/"
          ]
        },
        {
          "text": "Panda describes cardboard trays as internal organizers and protection during shipping, and vacuum-formed plastic trays as organizers for play and storage. (low confidence)",
          "source": "https://pandagm.com/components/",
          "note": null,
          "claimId": "clm:70422423c59aec3a4ad440602334f578696821cb811edc66bbc9769b43c70908",
          "validationStatus": "SUPPORTED",
          "evidenceIds": [
            "ev:06093bc1043b360ad2a9187d27c55558651b69d3cac6a636fd2817e841008e11",
            "ev:d1ce3204fe98e1e2afebf6f74a292f33c30497e76be54426479c387415a3d371"
          ]
        },
        {
          "text": "Panda offers printed, folded paper sheets for rules and player aids; it describes saddle-stitched rulebooks with page counts in groups of four and recommends other bindings for longer books. (low confidence)",
          "source": "https://pandagm.com/components/",
          "note": null,
          "claimId": "clm:6b106416d52f31976a004babe99ec6eed32e9d4d97e4f993a62465bc085d48ca",
          "validationStatus": "SUPPORTED",
