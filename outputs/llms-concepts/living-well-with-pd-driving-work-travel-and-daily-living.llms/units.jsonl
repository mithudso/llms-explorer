{"id": "clm:5e47b7f4611ae1e9d5aa02eb2d12e866c92e370a856c37708664801ee9575021", "type": "statement", "text": "The Parkinson’s Foundation advises avoiding driving when fatigued, when medication is wearing off, or when starting a new medicine. (low confidence)", "source_url": "https://www.parkinson.org/living-with-parkinsons/management/activities-daily-living/driving", "anchor": "", "page_class": "reference", "keywords": ["Living well with PD: driving, work, travel and daily living"], "code": null, "origin": "dr", "section": "mechanism", "relation": "about", "score": 1.0, "also": [], "semantic_score": null, "pass": "keyword", "canonical_concept_id": "concept:d6b5a9991c7a266016e1f2251838e5010f4435161056c6cb06f5a7f7233d76fb", "validation_status": "SUPPORTED", "evidence_ids": ["ev:24aa504ec13638ff854a51d3a0e95b124dfcff069bf1cb75c2df5f3c9aec4983"]}
