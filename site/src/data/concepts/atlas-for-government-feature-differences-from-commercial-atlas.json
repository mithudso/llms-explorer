            "ev:ba398805172c968c55c75c15f958a6c8808848502b2a1e9b8844fcb85fb73183"
          ],
          "also": [
            "https://www.mongodb.com/docs/atlas/government/overview/atlasgov-considerations.md"
          ]
        },
        {
          "text": "AtlasGov requires cluster tier `M20` or higher and excludes Free, Flex, and `M10` clusters. (medium confidence) (verified as of 2026-11-06)",
          "source": "https://www.mongodb.com/docs/atlas/government/api.md",
          "note": null,
          "claimId": "clm:d77ee5a0e60052bec9c2ee5bab553dd8197d428e7c1639b92d92ee1d84b5f932",
          "validationStatus": "SUPPORTED",
          "evidenceIds": [
