          ]
        },
        {
          "text": "The downstream-systems workflow exports Atlas collection data to object storage with $out, supports scheduled exports, and offers Parquet, CSV, BSON, and MongoDB Extended JSON formats. (medium confidence) (verified as of 2026-10-30)",
          "source": "https://www.mongodb.com/docs/atlas/data-federation/",
          "note": null,
          "claimId": "clm:945dda73940954d691ae4b31b428a38228679bfdd7f5efb80921885caedc58fa",
