---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { tree } from "../data/tree";
import { directory } from "../data/directory";
import { context } from "../data/context";
import demo from "../data/demo.json";

// The 2026-09-25 refocus (docs/superpowers/specs/2026-09-25-agent-research-hub-design.md):
// the page leads with the three things an agent comes here for — skills to
// install, context files to load, facts to look up — and keeps the grading and
// retrieval surfaces as the proof that the files are what they claim. Every
// figure is live from the build-time data; nothing is typed in by hand.
const title = "LLMS-Explorer";
const description = "Skills to install, context files to load, and source-anchored facts on every researched concept — each one a single fetch from this site's llms.txt.";

const esc = (s: unknown) =>
  String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

// ---- Skills card --------------------------------------------------------
// The skills collection in its authored order; the card shows the first few
// with an alias where one exists, and the install line for the first.
const skills = (await getCollection("skills")).sort((a, b) =>
  (a.data.order ?? 1e9) - (b.data.order ?? 1e9) || a.data.title.localeCompare(b.data.title));
const skillPicks = skills.slice(0, 5);
const installCmd = (id: string) => `npx skills add mithudso/llms-explorer --skill ${id}`;

// ---- Context card -------------------------------------------------------
const ctx = context.totals;
const ctxMb = (ctx.bytes / 1_048_576).toFixed(1);
const ctxRoots = [...context.roots]
  .filter((r) => r.slug !== "unfiled")
  .sort((a, b) => b.files.length - a.files.length || a.concept.localeCompare(b.concept))
  .slice(0, 5);

// ---- Tree card ----------------------------------------------------------
// One root, drawn as a mindmap: the llms.txt branch by preference, because a
// card on this site should open on this site's own subject. The other roots and
// every child below this depth are one click away at /tree/.
//
// Preferred slug, not required slug: tree.json is a regenerated snapshot
// (tools/gen_tree.py) and the test suite builds this page against fixture trees
// that carry neither this root nor any other. A home page that throws when a
// concept is renamed would take the whole build down with it, so the card falls
// back to the first root it does find, and omits the mindmap if there are none.
const MINDMAP_ROOT = "llms-txt-and-llm-readable-documentation";
const mindRoot = tree.nodes[MINDMAP_ROOT] ??
  tree.roots.map((s) => tree.nodes[s]).find(Boolean) ??
  Object.values(tree.nodes)[0];
const mindKids = (mindRoot?.children ?? []).slice(0, 5);

/** Break a label into at most `max` lines of ~`width` characters, on word
    boundaries — SVG has no text wrapping, so the wrap happens here or the
    longest concept name runs off the side of the card. */
function wrap(text: unknown, width: number, max: number): string[] {
  const lines: string[] = [];
  let line = "";
  for (const word of String(text).split(/\s+/)) {
    if (!line) line = word;
    else if ((line + " " + word).length <= width) line += " " + word;
    else { lines.push(line); line = word; }
    if (lines.length === max) break;
  }
  if (line && lines.length < max) lines.push(line);
  return lines;
}

const KID_Y = [24, 60, 96, 132, 168];
const rootLines = wrap(mindRoot?.concept ?? "", 20, 3);
const mindmap = !mindRoot ? "" : [
  `<svg class="mindmap" viewBox="0 0 360 192" role="img" aria-label="Mindmap of ${esc(mindRoot.concept)} and its five researched children">`,
  ...mindKids.map((_, i) =>
    `<path d="M132 96 C 152 96, 152 ${KID_Y[i]}, 168 ${KID_Y[i]}" />`),
  ...rootLines.map((line, i) =>
    `<text class="root" x="4" y="${96 - (rootLines.length - 1) * 7 + i * 14}">${esc(line)}</text>`),
  ...mindKids.flatMap((kid, i) => {
    const lines = wrap(kid.concept, 26, 2);
    return lines.map((line, j) =>
      `<text x="172" y="${KID_Y[i] - (lines.length - 1) * 6 + j * 12}">${esc(line)}</text>`);
  }),
  "</svg>",
].join("");

// The same graph as mermaid source, so a reader can paste it into any mermaid
// renderer. The SVG above is drawn here rather than by mermaid.js because that
// library is larger than this whole site and would need a CSP exception to run.
const mermaid = !mindRoot ? "" : [
  "mindmap",
  `  root((${mindRoot.concept}))`,
  ...mindKids.map((k) => `    ${k.concept}`),
].join("\n");

// ---- Directory card -----------------------------------------------------
// "Done well" = the top grade the rubric awards, and the biggest of those, so
// the card names sites a reader is likely to recognise rather than the highest
// score in a tie of ninety-one.
const showcase = directory.sites
  .filter((s) => s.grade === "A")
  .sort((a, b) => b.pages - a.pages)
  .slice(0, 5);
const gradeA = directory.sites.filter((s) => s.grade === "A").length;

// ---- Demo card ----------------------------------------------------------
// A paraphrase question, not an exact-token one: the exact tokens are the case
// keyword search already wins, and the recorded run exists to show the case it
// does not.
const demoQ = demo.questions.find((q) => q.kind === "paraphrase") ?? demo.questions[0];
const demoHit = demoQ.hybrid[0];

// ---- Collection cards ---------------------------------------------------
// One real entry per collection, chosen the way the section index orders them,
// so the card quotes a page that exists rather than describing the section.
const pick = <T extends { data: { order?: number; title: string } }>(entries: T[]): T =>
  [...entries].sort((a, b) =>
    (a.data.order ?? 999) - (b.data.order ?? 999) ||
    String(a.data.title).localeCompare(String(b.data.title)))[0];
const newest = <T extends { data: { date?: string } }>(entries: T[]): T =>
  [...entries].sort((a, b) => String(b.data.date ?? "").localeCompare(String(a.data.date ?? "")))[0];

const reference = await getCollection("reference");
const examples = await getCollection("examples");
const blog = await getCollection("blog");
const refPick = pick(reference);
const examplePick = pick(examples);
const blogPick = newest(blog);
const conceptCount = Object.keys(tree.nodes).length;
---
<Base title={title} description={description} route="/" twin={null}>
  <p class="eyebrow">A research hub for agents</p>
  <p class="lede">{description}</p>
  <p class="hero-support">Files are promises: every fact names its source, every index is generated from the same tree, and nothing here needs an account to read.</p>

  <p class="hero-actions">
    <a class="btn" href="/skills/" data-track="home_cta_click" data-cta-id="install-skill" data-destination="/skills/">Install a skill</a>
    <a class="btn secondary" href="/context/" data-track="home_cta_click" data-cta-id="browse-context" data-destination="/context/">Browse the context files</a>
  </p>

  <p class="proof">
    {skills.length} skills installable
    · {ctx.files} context files, {ctxMb} MB
    · {ctx.facts.toLocaleString()} facts on {ctx.concepts} concepts in a tree of {conceptCount}, mapped {tree.generated}
    · {gradeA} of {directory.count} scored llms files earn an A
  </p>

  <ul class="personas">
    <li>
      <a href="/skills/" data-track="home_cta_click" data-cta-id="persona-skill" data-destination="/skills/">
        <strong>Give your agent a skill</strong>
        <span class="p-outcome">One <code>npx</code> line; the whole prompt is on the page.</span>
      </a>
    </li>
    <li>
      <a href="/context/" data-track="home_cta_click" data-cta-id="persona-context" data-destination="/context/">
        <strong>Load a context file</strong>
        <span class="p-outcome">Research reports, filed by root, sized in tokens, served as markdown.</span>
      </a>
    </li>
    <li>
      <a href="/tree/" data-track="home_cta_click" data-cta-id="persona-facts" data-destination="/tree/">
        <strong>Look up one concept's facts</strong>
        <span class="p-outcome">Facets of source-anchored facts, as a page and as a <code>.md</code>.</span>
      </a>
    </li>
  </ul>

  <pre class="hop"><code><b>1.</b> fetch /llms.txt          → the index: every section, every page
<b>2.</b> fetch /context.md       → every context file and facts file, by root
<b>3.</b> fetch one of them       → done. Two hops from the index, never more.</code></pre>

  <section class="zone">
    <h2>Share and load</h2>
    <ul class="card-grid tier-1">
      <li class="card">
        <h2><a href="/skills/" data-track="card_click" data-card="skills" data-destination="/skills/">Skills</a></h2>
        <p>Prompts an agent loads as-is — no runtime, no account — grouped by what they are for.</p>
        <figure class="example">
          <figcaption>Opens with</figcaption>
          <ul>
            {skillPicks.map((s) => (
              <li class="skill-row">
                <a href={`/skills/${s.id}/`}>{s.data.title}</a>
                {s.data.aliasCommand && <code>{s.data.aliasCommand}</code>}
              </li>
            ))}
          </ul>
          {skillPicks[0] && <p class="install-line">{installCmd(skillPicks[0].id)}</p>}
        </figure>
        <footer>{skills.length} skills · each page carries its full <code>SKILL.md</code></footer>
      </li>

      <li class="card">
        <h2><a href="/context/" data-track="card_click" data-card="context" data-destination="/context/">Context files</a></h2>
        <p>The hub's research reports and every concept's facts file, filed under the tree's roots.</p>
        <figure class="example">
          <figcaption>Largest roots</figcaption>
          <ul>
            {ctxRoots.map((r) => (
              <li>
                <a href={`/tree/${r.slug}/`}>{r.concept}</a>
                <span class="root-count"> {r.files.length} files · {r.concepts.length} concepts</span>
              </li>
            ))}
          </ul>
        </figure>
        <footer>{ctx.files} files, {ctxMb} MB · {ctx.concepts} facts files · <a href="/context.md">/context.md</a> lists them all</footer>
      </li>

      <li class="card">
        <h2><a href="/tree/" data-track="card_click" data-card="tree" data-destination="/tree/">Concepts</a></h2>
        <p>Every researched concept, its facets of facts, and a <a href="/tree/3d/">3D map</a> of the same graph.</p>
        {mindRoot && (
          <figure class="example">
            <figcaption>{mindRoot.concept} — {mindKids.length} of {mindRoot.children.length} children</figcaption>
            <Fragment set:html={mindmap} />
          </figure>
        )}
        {mindRoot && (
          <details class="source"><summary>the same branch as mermaid</summary><pre><code>{mermaid}</code></pre></details>
        )}
        <footer>{conceptCount} concepts · {tree.roots.length} roots · {ctx.facts.toLocaleString()} facts</footer>
      </li>
    </ul>
  </section>

  <section class="zone">
    <h2>Verify the territory</h2>
    <ul class="card-grid tier-2">
      <li class="card">
        <h2><a href="/directory/" data-track="card_click" data-card="directory" data-destination="/directory/">Directory</a></h2>
        <p>The mirrored <code>llms-full.txt</code> files we can score, graded by <code>llms_lint</code>.</p>
        <figure class="example">
          <figcaption>Grade A, largest first — sites doing it well</figcaption>
          <ul>
            {showcase.map((s) => (
              <li>
                <a href={`/directory/${s.key}/`}>{s.name || s.key}</a>
                <span class="grade"> {s.grade}</span> · {s.pages.toLocaleString()} pages
              </li>
            ))}
          </ul>
        </figure>
        <footer>{gradeA} of {directory.count} scored files earn an A · linted {directory.generated}</footer>
      </li>

      <li class="card">
        <h2><a href="/demo/" data-track="card_click" data-card="demo" data-destination="/demo/">Demo</a></h2>
        <p>Keyword, vector and hybrid retrieval over one docset, recorded.</p>
        <figure class="example">
          <figcaption>Hybrid, top hit</figcaption>
          <p class="q">“{demoQ.q}”</p>
          <p>{demoHit.text}</p>
        </figure>
        <footer>{demo.questions.length} questions · {Math.round(demoQ.ms.hybrid)} ms · recorded {demo.generated}</footer>
      </li>

      <li class="card">
        <h2><a href="/reference/" data-track="card_click" data-card="reference" data-destination="/reference/">Reference</a></h2>
        <p>The <code>/ldo</code> rubric: attributes, passes, and spokes.</p>
        <figure class="example">
          <figcaption>Opens with</figcaption>
          <p><a href={`/reference/${refPick.id}/`}>{refPick.data.title}</a> — {refPick.data.description}</p>
        </figure>
        <footer>{reference.length} reference pages</footer>
      </li>

      <li class="card">
        <h2><a href="/examples/" data-track="card_click" data-card="examples" data-destination="/examples/">Examples</a></h2>
        <p>The decision table and copy-only recipes.</p>
        <figure class="example">
          <figcaption>Opens with</figcaption>
          <p><a href={`/examples/${examplePick.id}/`}>{examplePick.data.title}</a> — {examplePick.data.description}</p>
        </figure>
        <footer>{examples.length} pages, {examples.filter((e) => e.id.startsWith("recipe-")).length} of them recipes</footer>
      </li>

      <li class="card">
        <h2><a href="/blog/" data-track="card_click" data-card="blog" data-destination="/blog/">Blog</a></h2>
        <p>Launch posts with figures from the corpus.</p>
        <figure class="example">
          <figcaption>Most recent</figcaption>
          <p><a href={`/blog/${blogPick.id}/`}>{blogPick.data.title}</a> — {blogPick.data.description}</p>
        </figure>
        <footer>{blog.length} posts</footer>
      </li>

      <li class="card">
        <h2><a href="/family/" data-track="card_click" data-card="llms-txt" data-destination="/family/">llms.txt</a></h2>
        <p>This site's own llms family — the index an agent reads, rendered for a person.</p>
        <figure class="example">
          <figcaption>Five files, one family</figcaption>
          <ul>
            <li><a href="/llms.txt">llms.txt</a> — the index</li>
            <li><a href="/llms-full.txt">llms-full.txt</a> — every page, in order</li>
            <li><a href="/llms-small.txt">llms-small.txt</a> — the reference layers, budgeted</li>
            <li><a href="/llms-facts.txt">llms-facts.txt</a> — one claim per line</li>
            <li><a href="/llms-vocabulary.txt">llms-vocabulary.txt</a> — the terms</li>
          </ul>
        </figure>
        <footer><a href="/family/">Read it as a page</a> — the raw files are <code>text/markdown</code>, which a browser shows as unclickable text.</footer>
      </li>
    </ul>
  </section>

  <section class="zone">
    <h2>Apply it</h2>
    <ul class="apply-list">
      <li><a href="/downloads/" data-track="home_cta_click" data-cta-id="downloads" data-destination="/downloads/">Downloads</a> — the skills via <code>npx</code>, the <code>llmsx</code> library and CLI, the npm package, and the terminal browser.</li>

      <li>Playground — three skills you can run in the browser: <a href="/playground/notes-to-llms/" data-track="home_cta_click" data-cta-id="playground-notes" data-destination="/playground/notes-to-llms/">notes → llms.txt</a>, <a href="/playground/library/" data-track="home_cta_click" data-cta-id="playground-library" data-destination="/playground/library/">the concept library</a>, and <a href="/playground/optimizer/" data-track="home_cta_click" data-cta-id="playground-optimizer" data-destination="/playground/optimizer/">the llms.txt optimizer</a> (needs an API key with <code>run</code> scope).</li>

      <li><a href="/contribute/" data-track="home_cta_click" data-cta-id="contribute" data-destination="/contribute/">Contribute</a> — add a subject to the tree. Sign in to submit, view <a href="/proposals/">your proposals</a>, and track their moderation status.</li>

      <li><a href="/login/" data-track="home_cta_click" data-cta-id="sign-in" data-destination="/login/">Sign in</a> — <a href="/account/">your account</a>, its <a href="/keys/">API keys</a> and its <a href="/usage/">usage</a>; everything above is readable without one.</li>
    </ul>
  </section>
</Base>
