---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import SubscribeForm from "../../components/SubscribeForm.astro";

// The four section landing pages the nav (and the prose) link to. Generated
// listing pages: no `.md` twin, hence `twin={null}`. `SECTIONS` lives inside
// getStaticPaths because Astro hoists that function out of component scope.
export async function getStaticPaths() {
  const SECTIONS = {
    reference: { title: "Reference", description: "The /ldo rubric: the attributes a file is judged on, the passes that raise them, and the spokes that serve them." },
    examples: { title: "Examples", description: "The decision table and the copy-only recipes: which file to reach for, and the exact commands that produce it." },
    blog: { title: "Blog", description: "Practical guides, measured experiments and architecture notes on research, agent skills and useful LLM context." },
    skills: { title: "Skills", description: "Every agent skill this site ships, grouped by what it is for — one page each, one install command each, and the full SKILL.md on every page." },
  };
  const out = [];
  for (const collection of Object.keys(SECTIONS) as (keyof typeof SECTIONS)[]) {
    const meta = SECTIONS[collection];
    const entries = await getCollection(collection);
    entries.sort((a, b) =>
      collection === "blog"
        ? String(b.data.date ?? "").localeCompare(String(a.data.date ?? "")) ||
          a.data.title.localeCompare(b.data.title)
        : (a.data.order ?? 1e9) - (b.data.order ?? 1e9) ||
          a.data.title.localeCompare(b.data.title));
    out.push({ params: { collection }, props: { collection, meta, entries } });
  }
  return out;
}

const { collection, meta, entries } = Astro.props;

// Skills are grouped by family, derived from the `tags` each page already
// carries rather than a new frontmatter field: a skill's tags say what it is
// for, and a second declaration of the same thing would drift. First matching
// group wins, in this order, so an optimizer that also touches llms files files
// under the llms family (that is what it optimizes).
const GROUPS: [string, string, (tags: string[]) => boolean][] = [
  ["Capture and to-do", "Get what is in your head into files an agent can load: a braindump parsed into categorised llms files, and a to-do list that collects what every session left open.",
    (t) => t.includes("capture")],
  ["llms-txt families", "Turn a repo, a site, notes, memory or a customer folder into an llms.txt family an agent can load.",
    (t) => t.includes("llms") || t.includes("llms-txt")],
  ["Research and mapping", "Research one subject, map the family around it, or rebalance the tree those families hang from.",
    (t) => ["research", "concept-mapping", "concept-depth", "taxonomy", "orchestration", "gap-analysis"].some((x) => t.includes(x))],
  ["Deep optimizers", "Multi-pass audit-and-fix loops that end with a fixed artifact — code, SQL, prompts, designs, strategies, skills — not a findings list.",
    (t) => t.includes("optimization") || t.includes("convergence-loop")],
  ["Domain skills", "Subject-matter skills built from a researched concept family.",
    () => true],
];
type Entry = (typeof entries)[number];
const grouped: { name: string; note: string; items: Entry[] }[] = [];
if (collection === "skills") {
  for (const [name, note] of GROUPS) grouped.push({ name, note, items: [] });
  for (const e of entries) {
    const tags = (e.data as { tags?: string[] }).tags ?? [];
    const i = GROUPS.findIndex(([, , match]) => match(tags));
    grouped[i === -1 ? grouped.length - 1 : i].items.push(e);
  }
}
const install = (id: string) => `npx skills add mithudso/llms-explorer --skill ${id}`;
// These labels describe the evidence in each article, not the whole archive.
const FEATURED_POSTS = [
  {
    id: "what-docs-llms-files-and-indexes-actually-save",
    kind: "Controlled experiment",
    outcome: "Decide what to put in an agent's context before investing in indexes. Compare cost, correctness and asset use across 256 runs on two small repositories with one model.",
  },
  {
    id: "state-that-survives-the-session",
    kind: "Architecture whitepaper",
    outcome: "Design a short session handoff and a separate store for durable recall. This implementation account explains the file roles and states which benefits still need measurement.",
  },
  {
    id: "semantic-indexing",
    kind: "Recorded retrieval walkthrough",
    outcome: "See where keyword search, embeddings and rank fusion succeed or fail on eleven questions. Follow the retained hits and timings from one docset and one recorded run.",
  },
  {
    id: "markdown-as-the-llm-output-gateway",
    kind: "Technical analysis",
    outcome: "Choose where Markdown fits in an LLM interface. Walk through parsing, streaming, safe rendering and the limits that call for a structured data format.",
  },
];
const featured = collection === "blog" ? FEATURED_POSTS.flatMap((feature) => {
  const entry = entries.find((e: Entry) => e.id === feature.id);
  return entry ? [{ ...feature, entry }] : [];
}) : [];

---
<Base title={meta.title} description={meta.description} route={`/${collection}/`} twin={null}>
  <p class="lede">{meta.description}</p>
  {collection === "skills" ? (
    <>
      <p>
        Each skill is one <code>SKILL.md</code> an agent loads as a prompt — no runtime, no
        account. Install any of them with the open <a href="https://github.com/vercel-labs/skills">skills CLI</a>,
        or copy the prompt straight off its page. See everything on offer with
        <code>npx skills add mithudso/llms-explorer --list</code>; the
        <a href="/downloads/">downloads page</a> covers the library and CLI that go with them.
      </p>
      {grouped.filter((g) => g.items.length > 0).map((g) => (
        <section class="skill-group">
          <h2>{g.name} <span class="skill-group-count">{g.items.length}</span></h2>
          <p class="skill-group-note">{g.note}</p>
          <ul class="card-grid">
            {g.items.map((e) => {
              const d = e.data as { title: string; description: string; aliasCommand?: string; liveDemo?: string };
              return (
                <li class="card">
                  <a class="card-title" href={`/skills/${e.id}/`}>{d.title}</a>
                  <p>{d.description}</p>
                  <p class="skill-meta">
                    {d.aliasCommand && <><code>{d.aliasCommand}</code> · </>}
                    {d.liveDemo && <><a href={d.liveDemo}>try it live</a> · </>}
                    <a href={`/skills/${e.id}/#prompt`}>read the prompt</a>
                  </p>
                  <pre class="skill-install-line"><code>{install(e.id)}</code></pre>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </>
  ) : collection === "blog" ? (
    <>
      <section class="featured-articles" aria-labelledby="featured-articles-heading">
        <h2 id="featured-articles-heading">Start with a useful question</h2>
        <p>These articles explain a decision you can apply, show their supporting work, and state the limits of their evidence.</p>
        <ul class="featured-list">
          {featured.map(({ entry, kind, outcome }) => (
            <li>
              <p class="article-kind">{kind}</p>
              <h3><a href={`/blog/${entry.id}/`}>{entry.data.title}</a></h3>
              <p>{outcome}</p>
              {entry.data.date && <time datetime={entry.data.date}>{entry.data.date}</time>}
              <a class="article-action" href={`/blog/${entry.id}/`}>Read the article →</a>
            </li>
          ))}
        </ul>
      </section>
      <section class="article-archive" aria-labelledby="article-archive-heading">
        <h2 id="article-archive-heading">All articles</h2>
        <p>Newest first. The archive includes experiments, implementation notes, technical reviews and announcements.</p>
        <ul class="card-grid">
          {entries.map((e: Entry) => (
            <li class="card">
              {e.data.date && <time class="meta" datetime={e.data.date}>{e.data.date}</time>}
              <a class="card-title" href={`/blog/${e.id}/`}>{e.data.title}</a>
              <p>{e.data.description}</p>
            </li>
          ))}
        </ul>
      </section>
      <SubscribeForm />
    </>
  ) : (
    <ul class="card-grid">
      {entries.map((e) => (
        <li class="card">
          <a class="card-title" href={`/${collection}/${e.id}/`}>{e.data.title}</a>
          <p>{e.data.description}</p>
        </li>
      ))}
    </ul>
  )}
</Base>

<style>
  .featured-articles { margin: var(--sp-6) 0 var(--sp-7); }
  .featured-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-5); list-style: none; padding: 0; margin-top: var(--sp-5); }
  .featured-list > li { display: flex; flex-direction: column; gap: var(--sp-3); min-width: 0; margin: 0; padding: var(--sp-5); background: var(--paper-raised); border: 1px solid var(--line); border-radius: var(--radius); }
  .featured-list h3 { margin: 0; font-size: var(--step-1); line-height: 1.3; }
  .featured-list h3 a { color: var(--ink); text-decoration: none; }
  .featured-list h3 a:hover { color: var(--accent); text-decoration: underline; }
  .featured-list p { margin: 0; }
  .article-kind { color: var(--accent); font-size: var(--step--1); font-weight: 600; }
  .featured-list time { color: var(--ink-muted); font-size: var(--step--1); }
  .article-action { display: inline-flex; align-items: center; min-height: 44px; margin-top: auto; font-weight: 600; }
  .article-archive { padding-top: var(--sp-5); border-top: 1px solid var(--line); }
  @media (max-width: 680px) { .featured-list { grid-template-columns: 1fr; } }
</style>
