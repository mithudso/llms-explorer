            "ev:5a569af313506c900524084ccce62b410cd075c443973a98663081091668cddf"
          ]
        },
        {
          "text": "The r8.3.0 implementation formats double and decimal inputs with explicit base through signed long long; integral values outside that range cause ConversionFailure. Hexadecimal output uses uppercase letters without a prefix. (low confidence)",
          "source": "https://raw.githubusercontent.com/mongodb/mongo/r8.3.0/src/mongo/db/exec/expression/evaluate_math.cpp",
          "note": null,
