---
import WORKFLOWS from "../data/workflows.json";
---
<ul class="journey-grid">
  {WORKFLOWS.map((workflow, i) => <li>
    <p class="content-kind">Workflow {i + 1} · {workflow.time}</p>
    <h3><a href={`/workflows/${workflow.slug}/`} data-track="workflow_open" data-label={workflow.slug}>{workflow.title}</a></h3>
    <p>{workflow.problem}</p><p>{workflow.summary}</p>
  </li>)}
</ul>

