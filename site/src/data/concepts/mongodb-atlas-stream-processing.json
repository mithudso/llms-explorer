    {
      "title": "Anti-Patterns",
      "facts": [
        {
          "text": "Single SPI for all processing: Separate high-priority from low-priority processors across different SPIs",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-stream-processing/#anti-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Windowed aggregation without watermarks: Late events cause incorrect window results",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-stream-processing/#anti-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "No DLQ configured: Failed events are silently dropped without $validate + allowedLateness",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-stream-processing/#anti-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Growing consumer lag left unchecked: Indicates SPI undersized for throughput; upgrade tier",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-stream-processing/#anti-patterns",
          "note": null,
          "level": 0
        },
        {
          "text": "Using ASP for batch re-processing: ASP is for continuous streams - use Data Federation for historical batch",
