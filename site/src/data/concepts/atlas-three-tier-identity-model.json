    {
      "title": "Facts and statements",
      "facts": [
        {
          "text": "Atlas users authenticate to the management application; database users authenticate clients to MongoDB databases. An Atlas console login is not a database connection credential. (high confidence)",
          "source": "https://www.mongodb.com/docs/atlas/organizations-projects.md",
          "note": null,
          "claimId": "clm:5e4c64ef82553435b8461ce0ca91c56eb95f48103051855d42382f282c7b3d19",
          "validationStatus": "SUPPORTED",
          "evidenceIds": [
            "ev:814549a28d6007f62d1fbd69060bcaad847ed965adedf8e469335ec8e2a824b4"
          ],
          "also": [
            "https://www.mongodb.com/docs/atlas/security-add-mongodb-users.md",
            "https://docs.atlan.com/apps/connectors/database/mongodb/how-tos/set-up-mongodb"
          ]
        },
        {
          "text": "Database-user roles determine database privileges. Built-in-role users initially cover all clusters in their Atlas project; resource restrictions can narrow access to selected clusters. (high confidence)",
          "source": "https://www.mongodb.com/docs/atlas/security-add-mongodb-users.md",
          "note": null,
          "claimId": "clm:fc758c9e5cf6da24f15e8f5df4557cb6696cd078f32aa34b15cacc225622194c",
          "validationStatus": "SUPPORTED",
          "evidenceIds": [
            "ev:893df4b4b9e8c50dcbfa0faf68b575d12af8bc877417bbde30109b44e6e5c7f1"
          ],
          "also": [
            "https://docs.atlan.com/apps/connectors/database/mongodb/how-tos/set-up-mongodb"
          ]
        },
        {
          "text": "Manage Atlas database users through the Atlas UI, Atlas CLI, Atlas Administration API, or a supported integration. Otherwise, Atlas rolls back any user modifications. Sources: https://www.mongodb.com/docs/atlas/security-add-mongodb-users.md",
          "source": "https://www.mongodb.com/docs/atlas/security-add-mongodb-users.md",
          "note": null,
          "claimId": "clm:62e25557c78cd5dcb9494eb4a6f5f912b579d228dcee9eb6b3a09c31b28e019c",
          "validationStatus": "REMEDIATED-PROJECTION",
          "evidenceIds": [],
          "also": [
            "https://dvla.github.io/posts/2025-05-29-checking-for-atlas-users-before-creating/",
            "https://docs.atlan.com/apps/connectors/database/mongodb/how-tos/set-up-mongodb"
          ],
          "originValidationStatus": "SUPPORTED",
