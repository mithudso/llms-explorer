          ]
        },
        {
          "text": "BsonProperty customizes the BSON field name, BsonId selects the identifier property, and BsonIgnore controls whether a property is serialized or deserialized. (medium confidence)",
          "source": "https://www.mongodb.com/docs/drivers/java/sync/current/data-formats/pojo-customization.md",
          "note": null,
          "claimId": "clm:eab252ebc6443b3b18ee3478ff47f292d9459e1be0fdcf0bdeff6217d3aad673",
