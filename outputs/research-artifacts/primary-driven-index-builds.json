    {
      "id": "clm:158ffa6a1843df7a3753cfc6380b4cd55caf6b152cb198bceb69783a8f9f3103",
      "text": "If a primary-driven index build cannot be resumed, the server logs a failure and aborts it instead, so resumability does not guarantee every interrupted build completes. Sources: https://raw.githubusercontent.com/mongodb/mongo/master/src/mongo/db/index_builds/index_builds_coordinator.cpp",
      "source_url": "https://raw.githubusercontent.com/mongodb/mongo/master/src/mongo/db/index_builds/index_builds_coordinator.cpp",
      "also": [],
      "validation_status": "REMEDIATED-PROJECTION",
      "origin_validation_status": "SUPPORTED",
      "evidence_ids": [],
