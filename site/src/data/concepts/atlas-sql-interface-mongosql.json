    {
      "title": "Anti-Patterns",
      "facts": [
        {
          "text": "Using BI Connector for new deployments (post-2024): EOL is September 2026; invest in Atlas SQL Interface",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-bi-connector/#anti-patterns",
          "note": null
        },
        {
          "text": "DirectQuery without optimizing MongoDB indexes: Every Power BI interaction queries Atlas live; unindexed queries = slow dashboards",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-bi-connector/#anti-patterns",
          "note": null
        },
        {
          "text": "Schema auto-infer on heterogeneous collections: Auto-infer samples 1,000 documents and may miss fields in outliers; validate schema explicitly for production",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-bi-connector/#anti-patterns",
          "note": null
        },
        {
          "text": "Not setting a Data Federation query byte limit: Runaway DirectQuery workloads can drive significant $5/TB costs",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-bi-connector/#anti-patterns",
          "note": null
        }
      ]
