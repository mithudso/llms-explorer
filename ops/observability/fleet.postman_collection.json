{
  "info": {
    "name": "Fleet operations acceptance",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "collector",
      "value": "http://127.0.0.1:9321"
    },
    {
      "key": "grafana",
      "value": "http://127.0.0.1:3031"
    },
    {
      "key": "prometheus",
      "value": "http://127.0.0.1:9091"
    }
  ],
  "item": [
    {
      "name": "Collector liveness",
      "request": {
        "method": "GET",
        "url": "{{collector}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "pm.test(\"Expected behavior\", () => { pm.expect(pm.response.json().status).to.eql(\"ok\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Collector readiness",
      "request": {
        "method": "GET",
        "url": "{{collector}}/ready"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "pm.test(\"Expected behavior\", () => { pm.expect(pm.response.json().status).to.eql(\"ok\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Collector metrics",
      "request": {
        "method": "GET",
        "url": "{{collector}}/metrics"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "pm.test(\"Expected behavior\", () => { pm.expect(pm.response.text()).to.include(\"fleet_check_expected\"); pm.expect(pm.response.text()).to.include(\"fleet_collector_cycle_timestamp_seconds\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Grafana backend health",
      "request": {
        "method": "GET",
        "url": "{{grafana}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "pm.test(\"Expected behavior\", () => { pm.expect(pm.response.json().database).to.eql(\"ok\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Anonymous dashboard access refused",
      "request": {
        "method": "GET",
        "url": "{{grafana}}/api/dashboards/uid/llmsx-fleet"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(401));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Prometheus readiness",
      "request": {
        "method": "GET",
        "url": "{{prometheus}}/-/ready"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
