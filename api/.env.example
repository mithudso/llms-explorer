# explorer-api environment. Copy to api/.env for local work, then load it into
# the SHELL environment before starting the app:
#
#     set -a && . ./.env && set +a
#     ../hub/.venv/bin/python -m uvicorn explorer_api.main:app --port 8790
#
# The app never reads this file itself — secrets come from the environment only,
# and api/.env is gitignored. Every value below is a placeholder, not a secret.

# --- required: the app refuses to start without these ------------------------
DATABASE_URL=postgresql+asyncpg://explorer:explorer@127.0.0.1:5432/explorer
SESSION_SECRET=replace-with-32-or-more-random-characters
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- required outside dev: passkeys will not start without these -------------
# These describe the SITE that runs the ceremony, never this API. A credential is
# scoped to the origin of the page that created it, and WEBAUTHN_RP_ID must be a
# registrable-domain suffix of that origin — so `api.llms-explorer.com` is wrong
# for a page served from `llms-explorer.com`, and the browser refuses with a
# SecurityError before any request is sent. With ENVIRONMENT=prod and RP_ID
# unset, every passkey start answers 500.
#
# The apex covers the apex, `www` and `api` alike. Treat the value as permanent:
# existing passkeys are scoped to whatever shipped, so changing it invalidates
# all of them.
WEBAUTHN_RP_ID=llms-explorer.com
WEBAUTHN_ORIGINS=https://llms-explorer.com,https://www.llms-explorer.com
# Unset in dev, the relying party falls back to the first SITE_ORIGINS entry.

# --- required: CORS and host allow-listing -----------------------------------
# The site is a different origin from this API and every account island fetches
# with `credentials: "include"`, so the origin list must be explicit. Include the
# Astro dev server or local sign-in fails preflight with no
# access-control-allow-origin header.
SITE_ORIGINS=https://llms-explorer.com,https://www.llms-explorer.com,http://localhost:4321
ALLOWED_HOSTS=api.llms-explorer.com,llms-explorer.com,localhost,127.0.0.1,testserver,test,*.test

# Where this API is reachable; the OAuth callback URLs are built from it.
API_PUBLIC_URL=http://127.0.0.1:8790

# --- optional: required only once that provider's sign-in is used (Task 3) ---
# Register the callback in each provider console as
#   ${API_PUBLIC_URL}/api/auth/oauth/{github,google}/callback
# A provider stays 404 "unknown provider" until BOTH its id and secret are set.
OAUTH_GITHUB_ID=
OAUTH_GITHUB_SECRET=
OAUTH_GOOGLE_ID=
OAUTH_GOOGLE_SECRET=

# --- optional: email confirmation ---------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@llms-explorer.com

# --- optional: agent-backed endpoints ----------------------------------------
ANTHROPIC_API_KEY=

# --- defaulted ---------------------------------------------------------------
# The hub MCP server is unauthenticated and must never face the tunnel, so this
# is validated to stay on loopback.
HUB_MCP_URL=http://127.0.0.1:8787
# Per-user docset stores: stores/<user_id>/docsets.db, outside .chroma-docsets/
# and outside the hub tree, so replicate_docsets.py never pushes them.
STORES_ROOT=~/.llms-explorer/stores
ENVIRONMENT=dev

# --- tests only --------------------------------------------------------------
# The api/tests suite needs a real PostgreSQL (its schema tests assert
# Postgres-specific guarantees: numeric(12,6) money, an append-only trigger,
# jsonb, array scopes). Leave this unset and the suite boots a throwaway cluster
# from the initdb/pg_ctl on PATH and tears it down again. Set it to a
# *maintenance* database ("…/postgres") to point the suite at a server you
# already run; the fixtures create and drop their own databases beside it.
# EXPLORER_TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/postgres
