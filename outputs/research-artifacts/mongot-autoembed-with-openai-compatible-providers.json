    },
    {
      "id": "clm:b358fcabdd4e3bd4d0a7b94c38b21bc663a46418ce843f48484acb1eaef54a4d",
      "text": "Percona distinguishes index sizing from dimension forwarding. For autoEmbed, numDimensions is optional, must match the returned vectors, and supports 1\u20138192; if omitted, mongot uses the model\u2019s outputDimensions. outputDimensions sizes the index. forwardDimensions defaults to false; enabling it sends the resolved dimension as dimensions. Percona restricts forwarding to models that support configurable dimensions. (high confidence) (verified as of 2026-10-29)",
      "source_url": "https://raw.githubusercontent.com/percona/percona-search-for-mongodb-docs/main/docs/automatic-embedding-configuration-reference.md",
      "also": [
        "https://raw.githubusercontent.com/percona/percona-search-for-mongodb-docs/main/docs/configure-automatic-embedding.md",
        "https://docs.percona.com/percona-search-for-mongodb/automatic-embedding-configuration-reference.html",
        "https://docs.percona.com/percona-search-for-mongodb/configure-automatic-embedding.html",
        "https://docs.percona.com/percona-search-for-mongodb/automatic-embedding-with-OpenAI-providers.html"
      ],
      "validation_status": "SUPPORTED",
