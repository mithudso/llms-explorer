        "https://www.mongodb.com/docs/v7.0/release-notes/7.0/"
      ],
      "validation_status": "SUPPORTED",
      "evidence_ids": [
        "ev:268d39c57c043d744a51ae76ce136b39a2d1c0e35ac183284dbfa6ccce5e866e",
