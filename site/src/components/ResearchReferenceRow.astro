---
// One reference file on /research/: its concept page, size and family, a
// button that copies a prompt reference, and the facts file itself. The page
// also renders this row once with no reference, inside a <template>, and its
// script clones that row for each search result, so a curated row and a search
// result share one markup. The copy button stays hidden until the script runs:
// without JavaScript it would do nothing, and the download still works. The
// row's styles live in the page's global style block, which reaches both.
import type { ResearchReference } from "../data/research";

interface Props {
  /** null renders the empty row the search script fills in. */
  reference: ResearchReference | null;
  site: string;
}
const { reference: ref, site } = Astro.props;
const label = (action: string) => (ref ? `${action} for ${ref.concept}` : undefined);
---
<li class="rs-ref">
  <div class="rs-ref-text">
    <a class="rs-ref-name" href={ref?.page ?? undefined} data-field="name">{ref?.concept}</a>
    <span class="rs-ref-meta">
      <span data-field="facts">{ref && `${ref.facts.toLocaleString("en-US")} facts`}</span>
      {(!ref || (ref.family && ref.familySlug)) && (
        <span data-field="family-wrap"> · in <a href={ref ? `/tree/${ref.familySlug}/` : undefined} data-field="family">{ref?.family}</a></span>
      )}
    </span>
  </div>
  <div class="rs-ref-actions">
    <button type="button" class="rs-copy" hidden
      data-concept={ref?.concept} data-url={ref ? `${site}${ref.download}` : undefined}
      aria-label={label("Copy reference")} data-track="research_copy" data-label={ref?.slug}>Copy reference</button>
    <a class="rs-md" href={ref?.download} download data-field="download"
      aria-label={label("Download facts.md")} data-track="research_download">facts.md</a>
  </div>
</li>
