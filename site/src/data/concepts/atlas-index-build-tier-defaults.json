    {
      "title": "Comparisons and alternatives",
      "facts": [
        {
          "text": "The generic 200 MB memory and three-concurrent-build defaults describe self-managed deployments; Atlas uses tier-specific values. Memory exhaustion during sorting can spill to temporary files rather than immediately aborting the build. (medium confidence) (verified as of 2026-10-19)",
          "source": "https://www.mongodb.com/docs/manual/reference/parameters.md",
          "note": null,
          "claimId": "clm:ca10a48db4c34bc60f16d005d23ebfe23578ab04bd718a3808b2329bb712fdad",
