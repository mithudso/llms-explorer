{"id": "clm:783314052904cb4a6d3c6512ee2b527ba550fca595d87a22eb83540aca9d1325", "type": "statement", "text": "A zero usage count alone does not justify removal: recent restarts and infrequent critical queries can make a needed index appear unused. Observe a representative application cycle. (high confidence)", "source_url": "https://oneuptime.com/blog/post/2026-03-31-mongodb-how-to-manage-indexes-with-mongodb-compass/view", "anchor": "", "page_class": "reference", "keywords": ["Compass Index Management"], "code": null, "origin": "dr", "section": "mechanism", "relation": "about", "score": 1.0, "also": ["https://www.percona.com/blog/identifying-unused-indexes-in-mongodb/", "https://www.mongodb.com/docs/compass/indexes.md", "https://www.mydbops.com/blog/mongodb-index-usage-analysis"], "semantic_score": null, "pass": "keyword", "canonical_concept_id": "concept:dc28efbb5d9f5d80e90213a1a5faac1665ecca9938e59cbd7d19cfafa8964a37", "validation_status": "SUPPORTED", "evidence_ids": ["ev:50eb42a49a17df9540b7f2f8da5751a7e4aa9ef242a11c82add0af60ada4163b", "ev:79df336fb84dcb5593fc7288d2eae208e4062dcf52122d56a88b2de162c9e198"]}
{"id": "clm:3b04006109a52036e6e653c6de9bc86b1f279d622f9019ff6e3be7e9878d76b2", "type": "statement", "text": "COMPASS-7823 reports that Compass 1.42.3 on macOS 14.2.1 removed JSON-key quotes when formatting partialFilterExpression, then rejected its own output. This is historical version-specific evidence, not proof that current versions remain affected. (low confidence)", "source_url": "https://jira.mongodb.org/browse/COMPASS-7823", "anchor": "", "page_class": "reference", "keywords": ["Compass Index Management"], "code": null, "origin": "dr", "section": "mechanism", "relation": "about", "score": 1.0, "also": [], "semantic_score": null, "pass": "keyword", "canonical_concept_id": "concept:dc28efbb5d9f5d80e90213a1a5faac1665ecca9938e59cbd7d19cfafa8964a37", "validation_status": "SUPPORTED", "evidence_ids": ["ev:a34e1e81df490d75eceb4dcf8ed20086b59071f69376d6eaec65203b2190ef24"]}
{"id": "clm:d42394b25f528008366cc21db1e003b3345dfa9ff453ad8402d03176f8d9bf3c", "type": "statement", "text": "The default _id index cannot be dropped independently of its collection. (high confidence)", "source_url": "https://www.mongodb.com/docs/manual/core/indexes/drop-index.md", "anchor": "", "page_class": "reference", "keywords": ["Compass Index Management"], "code": null, "origin": "dr", "section": "problems", "relation": "about", "score": 1.0, "also": ["https://oneuptime.com/blog/post/2026-03-31-mongodb-how-to-manage-indexes-with-mongodb-compass/view"], "semantic_score": null, "pass": "keyword", "canonical_concept_id": "concept:dc28efbb5d9f5d80e90213a1a5faac1665ecca9938e59cbd7d19cfafa8964a37", "validation_status": "SUPPORTED", "evidence_ids": ["ev:92ad42dbe9d4773515844d5011452140a34e96c61f2f96255c975b7fc08f99eb"]}
{"id": "clm:03943686496f5d93b0a294d2df08274a16547a82b4cb50c0e96ff4fd358a5446", "type": "statement", "text": "The Compass 1.51.0 release notes list shell-syntax index creation under COMPASS-9352; older screenshots and form instructions may differ from that interface. (low confidence) (verified as of 2026-09-25)", "source_url": "https://github.com/mongodb-js/compass/releases", "anchor": "", "page_class": "reference", "keywords": ["Compass Index Management"], "code": null, "origin": "dr", "section": "comparisons", "relation": "about", "score": 1.0, "also": [], "semantic_score": null, "pass": "keyword", "canonical_concept_id": "concept:dc28efbb5d9f5d80e90213a1a5faac1665ecca9938e59cbd7d19cfafa8964a37", "validation_status": "SUPPORTED", "evidence_ids": ["ev:1724d649629c96ebd1b0a10192c3269470639f71bc4a73e0394182323cbbf3c4"]}
