---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
export async function getStaticPaths() {
  const out = [];
  for (const c of ["reference", "essays", "examples", "blog", "skills"]) {
    for (const e of await getCollection(c)) out.push({ params: { slug: `${c}/${e.id}` }, props: { entry: e, collection: c } });
  }
  return out;
}
const { entry, collection } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description} route={`/${collection}/${entry.id}/`}>
  <Content />
</Base>
