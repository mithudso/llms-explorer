---
const { title, description, route } = Astro.props;
const twin = route.replace(/\/$/, "") + ".md";
---
<html lang="en"><head>
  <meta charset="utf-8" /><title>{title}</title><meta name="description" content={description} />
  <link rel="alternate" type="text/markdown" href={twin} />
  <link rel="describedby" href="/llms.txt" />
</head><body>
  <nav><a href="/">LLMS-Explorer</a> · <a href="/reference/">Reference</a> · <a href="/essays/">Essays</a> · <a href="/examples/">Examples</a> · <a href="/blog/">Blog</a> · <a href="/llms.txt">llms.txt</a> · <a href={twin}>.md</a></nav>
  <main><h1>{title}</h1><slot /></main>
</body></html>
