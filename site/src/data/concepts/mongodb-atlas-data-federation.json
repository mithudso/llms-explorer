          ]
        }
      ]
    },
    {
      "title": "Measurements and reference values",
      "facts": [
        {
          "text": "The billing page lists processing at $5 per TB, rounds processed bytes up to the nearest megabyte, and applies a 10 MB processed-data minimum per query; transfer charges are additional. (medium confidence) (verified as of 2026-10-30)",
          "source": "https://www.mongodb.com/docs/atlas/billing/data-federation/",
          "note": null,
          "claimId": "clm:7be5908d9d7b41211c2b7eaa8c64e8ff2c76be82d461feeaf78ce8d93d8630b4",
          "validationStatus": "SUPPORTED",
          "evidenceIds": [
