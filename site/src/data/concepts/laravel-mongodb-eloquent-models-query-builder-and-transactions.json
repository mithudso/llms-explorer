            "ev:c5adfb1281e530140eaa0336c4550addb4ca01101f80b9c7246587e8e3ca0062"
          ]
        },
        {
          "text": "MongoDB stores the primary key in `_id`; the Laravel integration exposes it as `$id` on a model and translates query-builder `id` references to `_id`. The model can customize the identifier type with `$keyType`. (low confidence)",
          "source": "https://www.mongodb.com/docs/drivers/php/laravel-mongodb/current/model-data/model-class.md",
          "note": null,
          "claimId": "clm:45118b1e5cc78cad5d2a9096fd45768660468d338df9f5e97ed0cd4cbcf1be39",
