# ==============================================================================
# LLMS-Explorer Environment Variables Example
# Copy to environment or export before running services.
# ==============================================================================

# --- Database & Storage -------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/explorer_dev
STORES_ROOT=~/.llms-explorer/stores

# --- Auth & Sessions ---------------------------------------------------------
# Must be at least 32 characters long
SESSION_SECRET=change-this-to-a-very-long-random-secret-key-at-least-32-chars
ENVIRONMENT=dev

# --- Allowed Origins & Hosts -------------------------------------------------
SITE_ORIGINS=https://llms-explorer.com,https://www.llms-explorer.com,https://llmsx.org,http://localhost:4321
ALLOWED_HOSTS=api.llms-explorer.com,llms-explorer.com,localhost,127.0.0.1,testserver,test,*.test

# --- OAuth (Optional in dev, required for provider logins) -------------------
OAUTH_GITHUB_ID=
OAUTH_GITHUB_SECRET=
OAUTH_GOOGLE_ID=
OAUTH_GOOGLE_SECRET=

# --- WebAuthn / Passkeys ------------------------------------------------------
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=

# --- Stripe Billing -----------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# --- Global AI Hub & Ollama ---------------------------------------------------
HUB_MCP_URL=http://127.0.0.1:8787
HUB_OLLAMA_URLS=http://127.0.0.1:11434
HUB_EMBED_MODEL=mxbai-embed-large
HUB_REFINE_LLM_MODEL=qwen3.5:35b

# --- LLM Provider -------------------------------------------------------------
# Only `/api/skills/{skill}/run` (the showcase playground) calls a model
# provider. Leave this unset and that one surface refuses with "not configured";
# every other surface works without it.
#
# Before the surface can bill a run it also needs a price in force for the model
# in the `prices` table: `ledger.DEFAULT_PRICES` deliberately omits the Claude
# rows because the list price is not this repo's to own, and a run that cannot
# be billed is refused rather than run.
ANTHROPIC_API_KEY=

# --- Hosted private skill releases and candidate broker -----------------------
# Per-account immutable release count and stored archive bytes.
SKILL_RELEASE_LIMIT=500
SKILL_STORAGE_LIMIT_BYTES=104857600
# Maximum streamed JSON body for the private release adapter (bytes).
SKILL_REGISTRY_REQUEST_BYTES=8650752
# Maximum streamed JSON body for candidate-job submissions (bytes).
OPTIMIZER_JOB_REQUEST_BYTES=1048576
# Maximum UTF-8 input text accepted by the hosted candidate broker (bytes).
OPTIMIZER_MAX_TEXT_BYTES=262144
# Per-account queued/running/held jobs counted for candidate admission.
OPTIMIZER_MAX_ACTIVE_JOBS=5
# Per-account jobs created in the rolling 24 hours before candidate admission.
OPTIMIZER_MAX_JOBS_PER_DAY=25

# --- Subscriber email (disabled until SMTP_HOST is configured) -----------------
# Bound SMTP connection and socket operations; must be positive seconds.
SMTP_TIMEOUT_SECONDS=15
