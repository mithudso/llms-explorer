            "ev:3810566b963d1502c89148a1bfa6685c37941fc9347db10774487c8f7af32332"
          ],
          "also": [
            "https://www.mongodb.com/docs/atlas/government/overview/atlasgov-considerations.md"
          ]
        },
        {
          "text": "AtlasGov supports MongoDB Search, but does not support dedicated Search Nodes: mongot runs alongside MongoDB processes on the same nodes. (low confidence) (verified as of 2026-10-14)",
          "source": "https://www.mongodb.com/docs/atlas/government/atlas-search.md",
          "note": null,
          "claimId": "clm:ded36d7efb9276e6763deccc0f829b3ee33ffc56a78ebc9a7b2e0f10e8d49b8f",
