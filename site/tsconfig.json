{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  // `public/` holds served assets, not source. Astro's base preset sets
  // `allowJs`, so without this line `astro check` type-infers the 1.6 MB
  // minified public/vendor/concept-tree-3d.bundle.js and runs out of heap.
  "exclude": ["dist", "public"]
}
