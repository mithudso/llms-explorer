    {
      "title": "Facts and statements",
      "facts": [
        {
          "text": "MongoDB introduced $createObjectId in 8.3 to generate new random ObjectId values within aggregation pipelines and expression-based updates. (medium confidence)",
          "source": "https://www.mongodb.com/docs/manual/reference/operator/aggregation/createObjectId/",
          "note": null,
          "claimId": "clm:8f7f3aadb9b6d44988a3b80ae3424e436161cbd183de4a9ff6da5b23b66e9bb7",
          "validationStatus": "SUPPORTED",
          "evidenceIds": [
            "ev:689114b05e114a2a58a96326de916bdcf6af4f1dda710ca0fe62a649027993be"
          ],
          "also": [
            "https://www.mongodb.com/docs/v8.3/release-notes/8.3/",
            "https://jira.mongodb.org/browse/SERVER-106452"
          ]
        },
        {
          "text": "$createObjectId generates a value without a source-value input; $toObjectId converts an existing value. NoSQLBooster documents this distinction alongside its $.createObjectId() helper. (medium confidence) Sources: https://nosqlbooster.com/blog/announcing-nosqlbooster-11-1/ ; https://www.mongodb.com/docs/manual/reference/operator/aggregation/createObjectId/",
          "source": "https://nosqlbooster.com/blog/announcing-nosqlbooster-11-1/",
          "note": null,
          "claimId": "clm:92694a7a3fca7f6d2b56b2b15fc59559976e632b52980d35d6c22bc613e52665",
