            "https://www.mongodb.com/docs/atlas/backup/cloud-backup/snapshot-distribution/",
            "https://raw.githubusercontent.com/mongodb/terraform-provider-mongodbatlas/master/docs/resources/cloud_backup_schedule.md"
          ],
