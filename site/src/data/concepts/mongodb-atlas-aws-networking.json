    {
      "title": "Common Troubleshooting",
      "facts": [
        {
          "text": "Connection timeout after PrivateLink setup:",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-aws-networking/#common-troubleshooting",
          "note": null
        },
        {
          "text": "Verify using the PrivateLink connection string (not standard)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-aws-networking/#common-troubleshooting",
          "note": null
        },
        {
          "text": "Check security group allows outbound TCP 27017 (or 1024-65535 for SRV)",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-aws-networking/#common-troubleshooting",
          "note": null
        },
        {
          "text": "Verify private_dns_enabled = false on the AWS endpoint",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-aws-networking/#common-troubleshooting",
          "note": null
        },
        {
          "text": "Confirm Atlas private endpoint status = AVAILABLE",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-aws-networking/#common-troubleshooting",
          "note": null
        },
        {
          "text": "DNS resolving to public IP:",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-aws-networking/#common-troubleshooting",
          "note": null
        },
        {
          "text": "Route53 private hosted zone may be interfering",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-aws-networking/#common-troubleshooting",
          "note": null
        },
        {
          "text": "Verify no conflicting private hosted zone for mongodb.net",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-aws-networking/#common-troubleshooting",
          "note": null
        },
        {
          "text": "From EC2 in VPC: nslookup <private-endpoint-hostname> should return private IP",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-aws-networking/#common-troubleshooting",
          "note": null
        },
        {
          "text": "VPC Peering connection not routing:",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-aws-networking/#common-troubleshooting",
          "note": null
        },
        {
          "text": "Route table in application VPC must include route to Atlas VPC CIDR",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-aws-networking/#common-troubleshooting",
          "note": null
        },
        {
          "text": "Route table in Atlas VPC (managed by MongoDB) is auto-updated",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-aws-networking/#common-troubleshooting",
          "note": null
        },
        {
          "text": "CIDR overlap check: Atlas VPC uses 192.168.x.x - ensure no overlap with your VPC",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-aws-networking/#common-troubleshooting",
          "note": null
