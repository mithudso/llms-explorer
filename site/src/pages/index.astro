---
import Base from "../layouts/Base.astro";
const title = "LLMS-Explorer";
const description = "The concept tree is the map; llms files are the territory; the site keeps the two in agreement.";
---
<Base title={title} description={description} route="/" twin={null}>
  <p><em>The concept tree is the map; llms files are the territory; the site keeps the two in agreement.</em></p>
  <ul>
    <li><a href="/tree/">Tree</a> — every researched concept, with a <a href="/tree/3d/">3D map</a> of the same graph.</li>
    <li><a href="/directory/">Directory</a> — the mirrored <code>llms-full.txt</code> files we can score, graded by <code>llms_lint</code>.</li>
    <li><a href="/demo/">Demo</a> — keyword, vector and hybrid retrieval over one docset, recorded.</li>
    <li><a href="/reference/">Reference</a> — the <code>/ldo</code> rubric: attributes, passes, and spokes.</li>
    <li><a href="/essays/">Essays</a> — CLLMS vs proprietary, V2 vs V1, the vocabulary.</li>
    <li><a href="/examples/">Examples</a> — the decision table and copy-only recipes.</li>
    <li><a href="/blog/">Blog</a> — launch posts with figures from the corpus.</li>
    <li><a href="/login/">Sign in</a> — <a href="/account/">your account</a>, its <a href="/keys/">API keys</a> and its <a href="/usage/">usage</a>; everything above is readable without one.</li>
    <li><a href="/llms.txt">llms.txt</a> — this site's own llms family.</li>
  </ul>
</Base>
