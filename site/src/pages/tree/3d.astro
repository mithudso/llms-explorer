---
import Base from "../../layouts/Base.astro";
import Tree3D from "../../components/Tree3D.astro";
import tree from "../../data/tree.json";

const nodeCount = Object.keys(tree.nodes).length;
const description = `The whole concept tree as a 3D force-directed map: ${nodeCount} researched nodes, ${tree.frontier.length} frontier concepts, rendered in the browser from one inlined JSON file.`;
---

<Base title="The concept tree in 3D" description={description} route="/tree/3d/" twin={null}>
  <p>
    The same tree as <a href="/tree/">the browser</a>, drawn as a force-directed
    graph: {nodeCount} researched nodes and {tree.frontier.length} frontier
    concepts, coloured by the root domain each one hangs from. Drag to rotate,
    scroll to zoom, click a node to isolate it with its neighbours and read what
    the tree knows about it; click empty space to come back to the whole map.
  </p>
  <p>
    Nothing here is fetched at view time. The graph is inlined in this page and
    the renderer is a bundle served from this origin, so the view works offline
    and makes no third-party request. Frontier concepts — names some node claims
    as a sub-concept but which have no node of their own — are drawn grey and
    small; they are derived from the tree at build time, never stored as a
    status. Generated {tree.generated}.
  </p>

  <Tree3D />

  <p>
    <a href="/tree/">← the tree browser</a> ·
    <a href="/reference/">how the tree is built</a>
  </p>
</Base>
