    {
      "title": "8.1 Memory: Lazy Loading",
      "facts": [
        {
          "text": "Realm objects are live, memory-mapped - zero-copy pointer arithmetic. Property access reads only accessed pages. Keep results as Results<T> / RealmResults<T> for UI binding; avoid materializing to Array/List unless serializing.",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-device-sdk/#81-memory-lazy-loading",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "8.2 Transactions",
      "facts": [
        {
          "text": "One realm.write {} = one ACID commit. Batch all related writes in a single transaction:",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-device-sdk/#82-transactions",
          "note": null,
          "level": 0
        }
      ]
    },
    {
      "title": "8.3 Thread Model",
      "facts": [
        {
          "text": "Realm instances are per-thread. Cross-thread options:",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-device-sdk/#83-thread-model",
          "note": null,
          "level": 0
        },
        {
          "text": "Frozen objects - .freeze() returns immutable snapshot; safe to pass across threads; no auto-update",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-device-sdk/#83-thread-model",
          "note": null,
          "level": 1
        },
        {
          "text": "ThreadSafeReference - pass reference, resolve on target thread's Realm instance",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-device-sdk/#83-thread-model",
          "note": null,
          "level": 1
        },
        {
          "text": "Config - always thread-safe; open new Realm from config on each background thread",
          "source": "https://llms-explorer.com/sources/mdb-context-hub/mongodb-atlas-device-sdk/#83-thread-model",
          "note": null,
          "level": 1
        }
