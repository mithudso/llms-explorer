  "facets": [
    {
      "title": "Definitions",
      "facts": [
        {
          "text": "Atlas snapshot distribution is an opt-in Cloud Backup policy that copies selected cluster snapshots from the primary region to additional regions within the same cloud provider. Policy items set a destination region, snapshot frequency or a number of recent snapshots, and copy retention. (high confidence) (verified as of 2026-10-23)",
          "source": "https://www.mongodb.com/docs/atlas/backup/cloud-backup/snapshot-distribution/",
          "note": null,
          "claimId": "clm:8138960186eb95769a5989c468c501b4b29918b28cd42ad02299addfb48c40e3",
          "validationStatus": "SUPPORTED",
          "evidenceIds": [
            "ev:1bd0d0cdba021e287f0a7f74468ef5898f6cd127ebc8564cdf964d0765d9a4e9",
            "ev:8eb1a409a820cd1722ac12334b9c0456b333c2c527a7b78520055985adec1d4d",
            "ev:f57d46845581198c555f7e3d422dfab128e9779f6a66d3675e2508cda84831dd"
          ],
          "also": [
            "https://github.com/mongodb/terraform-provider-mongodbatlas/blob/master/docs/resources/cloud_backup_schedule.md",
            "https://oneuptime.com/blog/post/2026-03-31-mongodb-set-up-cross-region-backup-atlas/view"
          ]
        }
      ]
