    {
      "id": "clm:682bc308e9e39af01fd86db5719b01152052da20eaf16cd97eb6e0d46c14cecc",
      "text": "The recipient checks out the session, begins or continues its transaction and checks the first statement id. Already executed statements and incomplete local history return the prior result without patching history. An incomplete-history sentinel is also skipped if the guarded operation throws. TransactionTooOld is caught by the outer loop and skipped, preserving newer transaction history. (high confidence)",
      "source_url": "https://raw.githubusercontent.com/mongodb/mongo/dacdbc3df2fbe579b03336a2f01fc9aedf406a41/src/mongo/db/s/session_catalog_migration_destination.cpp",
      "also": [
        "https://raw.githubusercontent.com/mongodb/mongo/dacdbc3df2fbe579b03336a2f01fc9aedf406a41/src/mongo/db/s/session_catalog_migration_destination_test.cpp",
