          ]
        },
        {
          "text": "The r10.5.0 helper wraps I/O failures in ConfigException. Its existing-file branch has no fallback that replaces unreadable JSON with the configured starting offset. (low confidence)",
          "source": "https://raw.githubusercontent.com/mongodb/mongo-spark/r10.5.0/src/main/java/com/mongodb/spark/sql/connector/read/MongoOffsetStore.java",
          "note": null,
