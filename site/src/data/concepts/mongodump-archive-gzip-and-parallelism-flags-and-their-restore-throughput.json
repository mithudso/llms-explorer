    {
      "title": "Facts and statements",
      "facts": [
        {
          "text": "mongodump --gzip compresses individual files in directory mode and compresses the archive or stream in archive mode. Directory output uses .gz suffixes; --archive and --gzip can be combined. (medium confidence)",
          "source": "https://www.mongodb.com/docs/database-tools/mongodump.md",
          "note": null,
          "claimId": "clm:90ea00e238e46879857ed0ee556240ff98181c4d8bfca65fb9e0d4a9c42c525b",
          "validationStatus": "SUPPORTED",
          "evidenceIds": [
