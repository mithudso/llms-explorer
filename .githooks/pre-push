#!/usr/bin/env python3
"""pre-push: refuse to upload content purged from this public repository's history.

On 2026-10-18 and again on 2026-11-07 the owner rewrote history to drop blog
posts and drafts about customer engagements and employer case work. The first
purge was undone the next day: a branch built on the old history was pushed and
merged (PR #198, Stele KNOW-1224). A push uploads every commit the remote lacks,
so pushing any branch based on the pre-rewrite history republishes the purged
files even if CI later refuses to merge it.

This hook lists the objects a push would send and fails if any path is a purged
one. Names are matched by truncated SHA-256 of the file stem, so this file does
not republish the titles. If it fires, rebase your work onto the rewritten
origin branch (or cherry-pick your own commits onto it) instead of pushing.

Install once per clone (all worktrees share it): git config core.hooksPath .githooks
"""
import hashlib
import os
import subprocess
import sys
import unicodedata

PURGED_STEMS = {
    "0687999b5c9d67a3", "19d51ffa1dd77564", "25a5de045223b72e", "2b72b9d3bbaba602",
    "3e0ebd7f60095c66", "5029276e675dbabc", "50b3746e9e8536a0", "512bd54672a25fcd",
    "51c5ce07225a6fd3", "5bbb2d3b5708e989", "6d03142d2b13d7c7", "6e7a49de1613010f",
    "705ff0dd48e94da4", "72a4be28b6776817", "773431be74e715a5", "799cf23b91ea4f9d",
    "7b4e41624a957dca", "7cd8fa7068e6cea6", "7f6992f6ff7dccba", "83ff15de7a83c09b",
    "875435fb48b7e6a0", "8f2a5b628a020d0d", "9219678635a4802b", "94dfdec91cd191ef",
    "9f25b73b16ee8713", "a24f9063ef85af3a", "a3db2ac8b3cfe154", "b5b9c119207e862d",
    "ce7bc5c31065b92b", "cf6490abe3cea67b", "d3c36d604634f510", "dc06e134b50968d8",
    "dc7dd2dc30660815", "eca0f975f436059b",
}
PURGED_DIRS = ("docs/verification/blog-ddo-2026-09-30/",)
ZERO = "0" * 40


def _digest(path: str) -> str:
    stem = unicodedata.normalize("NFC", os.path.splitext(os.path.basename(path))[0])
    return hashlib.sha256(stem.encode("utf-8")).hexdigest()[:16]


def purged(path: str) -> bool:
    return path.startswith(PURGED_DIRS) or (path.endswith(".md") and _digest(path) in PURGED_STEMS)


def main() -> int:
    found = set()
    for line in sys.stdin:
        parts = line.split()
        if len(parts) != 4 or parts[1] == ZERO:   # malformed, or a branch deletion
            continue
        listing = subprocess.run(["git", "rev-list", "--objects", parts[1], "--not", "--remotes"],
                                 capture_output=True, text=True, check=True).stdout
        for row in listing.splitlines():
            _, _, path = row.partition(" ")
            if path and purged(path):
                found.add((parts[2], path))
    if not found:
        return 0
    print("pre-push: refused. This push would re-upload content purged from public history:", file=sys.stderr)
    for ref, path in sorted(found)[:20]:
        print(f"  {ref}: {path}", file=sys.stderr)
    print("Rebase or cherry-pick your own commits onto the rewritten origin branch, then push.",
          file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
