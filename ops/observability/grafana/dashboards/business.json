                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unknown"
                },
                "1": {
                  "text": "Requires review",
                  "color": "orange"
                },
                "2": {
                  "text": "Getting ready",
                  "color": "blue"
                },
                "3": {
                  "text": "Ready",
                  "color": "green"
                },
                "4": {
                  "text": "Needs attention",
                  "color": "red"
                },
                "5": {
                  "text": "Absent from configured account"
                }
              }
            }
          ]
