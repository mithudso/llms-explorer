          ]
        },
        {
          "text": "queryKnobs updates merge individual knobs; omitted knobs remain unchanged, an empty document does nothing, and null removes one override. (medium confidence) (verified as of 2026-10-14)",
          "source": "https://www.mongodb.com/docs/manual/reference/command/setQuerySettings.md",
          "note": null,
          "claimId": "clm:6faec6fff6413723872f8017a5caae1f3babecff4e2ffd639ab659e326a292e1",
