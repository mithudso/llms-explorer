      "title": "Facts and statements",
      "facts": [
        {
          "text": "AtlasGov supports a subset of commercial Atlas features and some unique features; commercial Atlas documentation alone does not establish AtlasGov feature availability. (medium confidence) (verified as of 2026-11-06)",
          "source": "https://www.mongodb.com/docs/atlas/government/overview/supported-features.md",
          "note": null,
          "claimId": "clm:5f92be14877d49235322f773e489e9ca988c310822e32ccedac2e7b68bc75174",
          "validationStatus": "SUPPORTED",
          "evidenceIds": [
