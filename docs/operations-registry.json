{
  "version": "1.0.0",
  "operations": [
    {
      "id": "op_stripe_sync",
      "kind": "sync",
      "component": "api",
      "target": "api.stripe.com",
      "transport": "https",
      "retry_policy": "exponential_backoff"
    },
    {
      "id": "op_oauth_github",
      "kind": "auth",
      "component": "api",
      "target": "api.github.com",
      "transport": "https",
      "retry_policy": "none"
    },
    {
      "id": "op_oauth_google",
      "kind": "auth",
      "component": "api",
      "target": "oauth2.googleapis.com",
      "transport": "https",
      "retry_policy": "none"
    },
    {
      "id": "op_ollama_embed",
      "kind": "embedding",
      "component": "hub",
      "target": "ollama_cluster",
      "transport": "http",
      "retry_policy": "pool_failover"
    },
    {
      "id": "op_llms_catalog_fetch",
      "kind": "download",
      "component": "hub",
      "target": "external_documentation_sites",
      "transport": "https",
      "retry_policy": "single_retry_on_5xx"
    }
  ]
}
