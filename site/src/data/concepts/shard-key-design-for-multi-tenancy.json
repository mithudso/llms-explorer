            "https://intl.cloud.tencent.com/pt/document/product/240/80980",
            "https://oneuptime.com/blog/post/2026-03-31-mongodb-hot-shard-problems/view",
            "https://learn.microsoft.com/en-ca/azure/architecture/patterns/sharding",
            "https://github.com/yorkie-team/yorkie/blob/main/docs/design/mongodb-sharding.md"
          ],
          "originValidationStatus": "SUPPORTED",
