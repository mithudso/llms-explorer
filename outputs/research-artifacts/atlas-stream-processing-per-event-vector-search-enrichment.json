    {
      "id": "clm:e4e238a1d6868248ff30c56e64c2c2d1a6c1621a7ee3a4e995ab4d38df528d24",
      "text": "queryVector and query.text are mutually exclusive; field expressions enable event-specific vectors or automatically embedded text. (low confidence) (verified as of 2026-10-27)",
      "source_url": "https://www.mongodb.com/docs/atlas/atlas-stream-processing/sp-agg-vectorsearch/",
