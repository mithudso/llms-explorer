  "facets": [
    {
      "title": "Definitions",
      "facts": [
        {
          "text": "mongoimport accepts JSON, CSV, and TSV input; JSON is the default. mongoexport exposes JSON and CSV output formats; its documented --type choices do not include TSV. (high confidence)",
          "source": "https://www.mongodb.com/docs/database-tools/mongoimport.md",
          "note": null,
          "claimId": "clm:94fc95f3ad651578c994118e2f66fc0e669c1d40986fc338cfe790e542109677",
          "validationStatus": "SUPPORTED",
          "evidenceIds": [
